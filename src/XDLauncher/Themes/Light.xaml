<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F6F8FA" />
    <SolidColorBrush x:Key="TitleBarBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceStrongBrush" Color="#F3F4F6" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#EAEEF2" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D0D7DE" />
    <SolidColorBrush x:Key="BorderSoftBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F2328" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#4B5563" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#6B7280" />
    <SolidColorBrush x:Key="ChipBrush" Color="#F3F4F6" />
    <SolidColorBrush x:Key="ChipStrongBrush" Color="#E5E7EB" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#1A7F37" />
    <SolidColorBrush x:Key="WarningBrush" Color="#9A6700" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#CF222E" />
    <SolidColorBrush x:Key="InfoBrush" Color="#0969DA" />
    <SolidColorBrush x:Key="ScrimBrush" Color="#66000000" />
    <SolidColorBrush x:Key="BackdropOverlayBrush" Color="#D9F6F8FA" />
    <LinearGradientBrush x:Key="HeroScrimBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00000000" Offset="0" />
        <GradientStop Color="#33000000" Offset="0.55" />
        <GradientStop Color="#CC0D1117" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
