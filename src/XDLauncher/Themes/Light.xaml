<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F2F6F3" />
    <SolidColorBrush x:Key="TitleBarBrush" Color="#F2FFFFFF" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#F7FFFFFF" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FCFFFFFF" />
    <SolidColorBrush x:Key="SurfaceStrongBrush" Color="#F4F7F5" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#EAF1EC" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D8E3DC" />
    <SolidColorBrush x:Key="BorderSoftBrush" Color="#E7EFEA" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#152019" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#4A5E52" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#74877B" />
    <SolidColorBrush x:Key="ChipBrush" Color="#EEF4F0" />
    <SolidColorBrush x:Key="ChipStrongBrush" Color="#E0EBE4" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#219653" />
    <SolidColorBrush x:Key="WarningBrush" Color="#B47B0B" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#C43D3D" />
    <SolidColorBrush x:Key="InfoBrush" Color="#1777A8" />
    <SolidColorBrush x:Key="ScrimBrush" Color="#59000000" />
    <LinearGradientBrush x:Key="BackdropOverlayBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E2F4F8F5" Offset="0" />
        <GradientStop Color="#D6EEF4EF" Offset="0.42" />
        <GradientStop Color="#EAF7FAF8" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeroScrimBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00000000" Offset="0" />
        <GradientStop Color="#33000000" Offset="0.55" />
        <GradientStop Color="#CC050A07" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
