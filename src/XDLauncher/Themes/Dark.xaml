<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0D1117" />
    <SolidColorBrush x:Key="TitleBarBrush" Color="#0D1117" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#11161D" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#161B22" />
    <SolidColorBrush x:Key="SurfaceStrongBrush" Color="#1C2330" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#222B3A" />
    <SolidColorBrush x:Key="BorderBrush" Color="#303846" />
    <SolidColorBrush x:Key="BorderSoftBrush" Color="#232B38" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F0F6FC" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B1BAC4" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#7D8590" />
    <SolidColorBrush x:Key="ChipBrush" Color="#1C2330" />
    <SolidColorBrush x:Key="ChipStrongBrush" Color="#263041" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#3FB950" />
    <SolidColorBrush x:Key="WarningBrush" Color="#D29922" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#F85149" />
    <SolidColorBrush x:Key="InfoBrush" Color="#58A6FF" />
    <SolidColorBrush x:Key="ScrimBrush" Color="#CC000000" />
    <SolidColorBrush x:Key="BackdropOverlayBrush" Color="#CC0D1117" />
    <LinearGradientBrush x:Key="HeroScrimBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00000000" Offset="0" />
        <GradientStop Color="#660D1117" Offset="0.45" />
        <GradientStop Color="#F20D1117" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
