<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>MinecraftLauncher</AssemblyName>
    <RootNamespace>XdLauncher</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <Version>1.3.0</Version>
    <FileVersion>1.3.0.0</FileVersion>
    <Product>XD Launcher</Product>
    <AssemblyTitle>XD Launcher</AssemblyTitle>
    <Company>XD Studio</Company>
    <Description>Launcher de escritorio para Minecraft Bedrock Edition y Minecraft Java Edition, con MINECRAFT MOBILE CONNECT para jugar desde un teléfono Android.</Description>
    <Copyright>Copyright © 2026 XD Studio</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <PublishReadyToRun>false</PublishReadyToRun>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <StartupObject>XdLauncher.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Include="App.xaml" />
    <None Remove="Assets\**" />
    <Resource Include="Assets\**" />
    <None Include="..\..\README.md" Link="README.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
