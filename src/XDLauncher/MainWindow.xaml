<Window x:Class="XdLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:core="clr-namespace:XdLauncher.Core"
        Title="XD Launcher"
        Width="1440" Height="900"
        MinWidth="1120" MinHeight="720"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Opacity="0">
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
    <Window.Resources>
        <CollectionViewSource x:Key="GroupedNavigation" Source="{Binding Navigation}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
        <Style x:Key="BrandText" TargetType="TextBlock">
            <Setter Property="Text" Value="XD LAUNCHER" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style x:Key="BrandKicker" TargetType="TextBlock">
            <Setter Property="Text" Value="ECLIPSE" />
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="Foreground" Value="{DynamicResource AccentLightBrush}" />
        </Style>
        <Style x:Key="NavGroupText" TargetType="TextBlock">
            <Setter Property="Margin" Value="8,6,0,4" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="RootLayout" ClipToBounds="True" MouseMove="RootLayout_MouseMove" MouseLeave="RootLayout_MouseLeave">
        <Grid x:Name="BackdropLayer" ClipToBounds="True" IsHitTestVisible="False">
            <Grid.RenderTransform><TranslateTransform x:Name="BackdropTranslate" X="0" Y="0" /></Grid.RenderTransform>
            <Border Background="{DynamicResource WindowBackgroundBrush}" />
            <Image Source="{Binding CurrentBackgroundPath, Converter={StaticResource ImagePath}}"
                   Stretch="UniformToFill" Opacity="0.55" />
            <Border Background="{DynamicResource BackdropOverlayBrush}" />
            <Grid ClipToBounds="True">
                <Ellipse x:Name="AmbientOrbA" Width="1100" Height="1100" HorizontalAlignment="Left" VerticalAlignment="Top"
                         Margin="-520,-620,0,0" Fill="{DynamicResource AccentGlowBrush}" Opacity="0.75">
                    <Ellipse.RenderTransform><TranslateTransform X="0" Y="0" /></Ellipse.RenderTransform>
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="-70" To="90" Duration="0:0:26">
                                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="-40" To="70" Duration="0:0:31">
                                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>
                <Ellipse x:Name="AmbientOrbB" Width="900" Height="900" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                         Margin="0,0,-340,-430" Fill="{DynamicResource AccentGlowBrush}" Opacity="0.55">
                    <Ellipse.RenderTransform><TranslateTransform X="0" Y="0" /></Ellipse.RenderTransform>
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="60" To="-80" Duration="0:0:27" />
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="30" To="-60" Duration="0:0:31" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>
                <Ellipse x:Name="AmbientOrbC" Width="1100" Height="1100" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="420,-150,0,0"
                         Fill="{DynamicResource BrandVioletSoftBrush}" Opacity="0.3" />
                <Border Background="{DynamicResource GridPatternBrush}" Opacity="0.3" />
                <Border Background="{DynamicResource VignetteBrush}" />
            </Grid>
            <Canvas x:Name="ParticleCanvas" IsHitTestVisible="False" />
        </Grid>

        <Grid ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== SIDEBAR ===== -->
            <Border x:Name="SidebarPanel"
                    Width="{Binding SidebarWidth}"
                    Visibility="{Binding IsFullscreen, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"
                    Background="{DynamicResource SidebarBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="0,0,14,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="80" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="96" />
                    </Grid.RowDefinitions>

                    <Border x:Name="BrandHeader" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                            Margin="16,0,16,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="40" Height="40" CornerRadius="12"
                                    Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}"
                                    BorderThickness="1">
                                <Image Source="/Assets/logo.png" Width="18" Height="18" />
                            </Border>
                            <StackPanel Margin="12,0,0,0">
                                <TextBlock Text="XD LAUNCHER" Style="{StaticResource BrandText}" />
                                <TextBlock Text="ECLIPSE" Style="{StaticResource BrandKicker}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Background="{DynamicResource SurfaceStrongBrush}" BorderBrush="{DynamicResource BorderSoftBrush}"
                            BorderThickness="1" CornerRadius="14" Padding="0">
                        <ListBox x:Name="NavList" ItemContainerStyle="{StaticResource NavRailItem}" ItemsSource="{Binding Source={StaticResource GroupedNavigation}}"
                                 SelectedItem="{Binding CurrentNavigation, Mode=TwoWay}"
                                 Margin="10,8,10,6" BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.Panel>
                                        <ItemsPanelTemplate><StackPanel IsItemsHost="True" Margin="0,8" /></ItemsPanelTemplate>
                                    </GroupStyle.Panel>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name, Converter={StaticResource UpperText}}"
                                                       Style="{StaticResource NavGroupText}" />
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                        </ListBox>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Margin="14,10,0,0" Padding="10"
                                Background="{DynamicResource GlassStrongBrush}" BorderBrush="{DynamicResource GlassBorderBrush}"
                                BorderThickness="1" Effect="{StaticResource PanelShadow}">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="10" Height="10" CornerRadius="5" Background="{DynamicResource SuccessBrush}">
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" />
                                </Border>
                                <StackPanel Margin="10,0,0,0">
                                    <TextBlock Text="{Binding GameStatusText}" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding AccountStatusText}" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,10,10,0" Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToVisibility}}">
                            <Border Width="34" Height="34" CornerRadius="11" VerticalAlignment="Center"
                                    Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                                <TextBlock Text="{Binding AccountInitial}" Style="{StaticResource CardTitle}" FontSize="14"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                        <StackPanel Margin="14,8,14,0">
                            <Button Style="{StaticResource PrimaryButton}" Content="{Binding DisplayName}"
                                    ToolTip="Perfil de XD" Command="{Binding NavigateCommand}"
                                    CommandParameter="profile" Height="42" Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToVisibility}}"/>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource Card}" Padding="10,8" Background="{DynamicResource ChipBrush}"
                                        BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1"
                                        Width="{Binding SidebarWidth}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="30" Height="30" CornerRadius="9"
                                                Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                                            <TextBlock Text="{Binding AccountInitial}" Style="{StaticResource CardTitle}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,4,0" Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding XdAccountStatusText}" Style="{StaticResource Caption}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="&#xE7E8;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"
                                                   Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding LauncherVersion, StringFormat='v{0}'}" Style="{StaticResource Caption}"
                                       HorizontalAlignment="Left" Margin="10,10,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ===== TOP BAR + CONTENT ===== -->
            <Grid Grid.Column="1" Margin="0,0,0,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="66" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border x:Name="TopBar" Visibility="{Binding IsFullscreen, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"
                        Background="{DynamicResource TopBarBrush}" BorderBrush="{DynamicResource BorderSoftBrush}"
                        BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Style="{StaticResource IconButton}" Content="&#xE76C;"
                            Margin="14,0,6,0" ToolTip="Menú principal" Width="34" Height="34"
                            Visibility="{Binding IsFullscreen, Converter={StaticResource BoolToVisibility}}"
                            Click="ExitFullscreenClick" />
                    <Border Style="{StaticResource Pill}" Padding="11,7" Background="{DynamicResource ChipBrush}" BorderBrush="{DynamicResource BorderBrush}" Margin="8,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="StatusKicker" Text="{Binding TopBarStatusText}" Style="{StaticResource Caption}" />
                            <Border Width="7" Height="7" CornerRadius="5" Margin="8,0,0,0" Background="{DynamicResource SuccessBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Width="34" Height="34" CornerRadius="11" Margin="10,0,0,0"
                            Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                        <TextBlock Text="{Binding AccountInitial}" Style="{StaticResource CardTitle}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="3" Margin="0,0,22,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="42" Height="42" CornerRadius="14" Background="{DynamicResource AccentSoftBrush}"
                                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                                <TextBlock Text="{Binding CurrentGlyph}" FontFamily="{StaticResource IconFont}" FontSize="18"
                                           Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="14,0,0,0">
                                <TextBlock Text="{Binding CurrentTitle}" Style="{StaticResource PageTitle}" FontSize="24" />
                                <TextBlock Text="{Binding CurrentSubtitle}" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimizar" />
                        <Button x:Name="MaximizeButton" Style="{StaticResource ChromeButton}" Content="&#xE922;" Click="Maximize_Click" ToolTip="Maximizar" />
                        <Button Style="{StaticResource ChromeCloseButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Cerrar" />
                    </StackPanel>
                </Grid>
                </Border>

                <ContentControl x:Name="PageHost" Grid.Row="1" Content="{Binding CurrentPage}" Margin="24,24,24,14" RenderTransformOrigin="0.5,0.5">
                    <ContentControl.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1" ScaleY="1" />
                            <TranslateTransform Y="0" />
                        </TransformGroup>
                    </ContentControl.RenderTransform>
                </ContentControl>
            </Grid>
        </Grid>

        <ItemsControl x:Name="Toasts" ItemsSource="{Binding Toasts}" HorizontalAlignment="Right"
                      VerticalAlignment="Bottom" Margin="20,0,20,16" Width="420" Panel.ZIndex="20">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource GlassStrongBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="14" Margin="0,8,0,0" Padding="12"
                            Effect="{StaticResource PanelShadow}"                                     MaxWidth="440" MinWidth="300">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource AccentSoftBrush}"
                                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                                <TextBlock Text="{Binding IconGlyph}" FontFamily="{StaticResource IconFont}" FontSize="12"
                                           Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding Message}" Margin="10,0,10,0" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Content="&#xE711;" Style="{StaticResource IconButton}" Width="26" Height="26"
                                    Command="{Binding DataContext.DismissToastCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
