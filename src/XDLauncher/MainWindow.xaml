<Window x:Class="XdLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="XD Launcher"
        Width="1440"
        Height="900"
        MinWidth="1120"
        MinHeight="720"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Opacity="0">
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="RootLayout">
        <!-- Backdrop -->
        <Image Source="{Binding BackdropSource, Converter={StaticResource ImagePath}}"
               Stretch="UniformToFill" />
        <Border Background="{DynamicResource BackdropOverlayBrush}" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.ColumnSpan="2" Height="{Binding TitleBarHeight}" Background="{DynamicResource TitleBarBrush}"
                  Visibility="{Binding IsFullscreen, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="244" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                    <Image Source="/Assets/logo.png" Width="20" Height="20" />
                    <TextBlock Text="BEDROCK LAUNCHER" FontSize="10" FontWeight="Bold" Margin="9,0,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Border Style="{StaticResource Pill}" Padding="9,3"
                            Visibility="{Binding IsInitializing, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE895;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                       Foreground="{DynamicResource AccentBrush}" Margin="0,1,6,0" />
                            <TextBlock Text="{Binding InitializationStatus}" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Button Style="{StaticResource WindowButton}" Content="&#xE921;"
                            Click="Minimize_Click" ToolTip="Minimizar" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource WindowButton}" Content="&#xE922;"
                            Click="Maximize_Click" ToolTip="Maximizar" />
                    <Button Style="{StaticResource CloseWindowButton}" Content="&#xE8BB;"
                            Click="Close_Click" ToolTip="Cerrar" />
                </StackPanel>
            </Grid>

            <!-- Sidebar -->
            <Border x:Name="SidebarBorder" Grid.Row="1" Width="{Binding SidebarWidth}" Background="{DynamicResource SidebarBackgroundBrush}"
                    Visibility="{Binding IsFullscreen, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"
                    BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,1,1,0">
                <Grid Margin="10,12,10,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="6,0,2,10">
                        <TextBlock Text="MENÚ" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                   Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                        <Button Style="{StaticResource IconButton}" Width="30" Height="30"
                                HorizontalAlignment="Right" Content="{Binding SidebarToggleGlyph}"
                                Command="{Binding ToggleSidebarCommand}" ToolTip="Contraer o expandir menú" />
                    </Grid>

                    <ListBox Grid.Row="1" Style="{StaticResource NavListBox}"
                             ItemsSource="{Binding Navigation}"
                             SelectedItem="{Binding CurrentNavigation, Mode=TwoWay}"
                             VerticalAlignment="Top">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ToolTip="{Binding Title}" MinHeight="22">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}"
                                               FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0"
                                                Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Subtitle}" FontSize="10"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2">
                        <Border Background="{DynamicResource ChipBrush}" BorderBrush="{DynamicResource BorderSoftBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,8"
                                Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="ESTADO" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding GameStatusGlyph}" FontFamily="{StaticResource IconFont}"
                                               FontSize="11" HorizontalAlignment="Right"
                                               Foreground="{DynamicResource AccentBrush}" />
                                </Grid>
                                <TextBlock Text="{Binding GameStatusText}" FontSize="12" FontWeight="SemiBold"
                                           Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding GameStatusDetail}" Style="{StaticResource Caption}"
                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <Button Style="{StaticResource CardButton}"
                                Command="{Binding NavigateCommand}" CommandParameter="settings" ToolTip="Ajustes y perfil">
                            <Border Background="{DynamicResource ChipBrush}" BorderBrush="{DynamicResource BorderSoftBrush}"
                                    BorderThickness="1" CornerRadius="12" Padding="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="34" Height="34">
                                        <Border CornerRadius="17" Background="{DynamicResource AccentSoftBrush}" />
                                        <TextBlock Text="{Binding AccountInitial}" FontWeight="Bold" FontSize="13"
                                                   Foreground="{DynamicResource AccentLightBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Border CornerRadius="17">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding AccountAvatarPath, Converter={StaticResource ImagePath}}"
                                                            Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center"
                                                Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                                        <TextBlock Text="{Binding AccountDisplayName}" FontSize="12" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding XdAccountStatusText}" Style="{StaticResource Caption}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="{StaticResource IconFont}"
                                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                </Grid>
                            </Border>
                        </Button>

                        <Button Style="{StaticResource CardButton}" Command="{Binding SignOutCommand}"
                                ToolTip="Cerrar sesión de XD Launcher" Margin="0,6,0,0">
                            <Border Background="Transparent" BorderBrush="{DynamicResource BorderSoftBrush}"
                                    BorderThickness="1" CornerRadius="12" Padding="10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,1,9,0" />
                                    <TextBlock Text="Cerrar sesión" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                </StackPanel>
                            </Border>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="1" Grid.Column="1" Margin="26,20,26,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <StackPanel>
                        <TextBlock Text="{Binding CurrentTitle}" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="{Binding CurrentSubtitle}" Style="{StaticResource Muted}" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Style="{StaticResource Pill}" Margin="0,0,8,0"
                                Visibility="{Binding Game.IsInstalled, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding GameStatusGlyph}" FontFamily="{StaticResource IconFont}"
                                           FontSize="10" Foreground="{DynamicResource AccentBrush}" Margin="0,1,6,0" />
                                <TextBlock Text="{Binding GameStatusText}" FontSize="10" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Button Content="Ajustes" Style="{StaticResource SecondaryButton}" Padding="14,7"
                                Command="{Binding NavigateCommand}" CommandParameter="settings" />
                    </StackPanel>
                </Grid>

                <ContentControl x:Name="PageHost" Grid.Row="1" Content="{Binding CurrentPage}" Margin="0,18,0,0" RenderTransformOrigin="0.5,0.5">
                    <ContentControl.RenderTransform>
                        <TranslateTransform Y="0" />
                    </ContentControl.RenderTransform>
                </ContentControl>
            </Grid>
        </Grid>

        <!-- Toasts -->
        <ItemsControl ItemsSource="{Binding Toasts}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Margin="0,0,24,22" Width="380" Panel.ZIndex="20">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="ToastCard" Background="{DynamicResource SurfaceStrongBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="13" Padding="13" Margin="0,8,0,0"
                            Effect="{StaticResource SoftShadow}"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <TranslateTransform X="26" />
                        </Border.RenderTransform>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         From="26" To="0" Duration="0:0:0.26">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ToastGlyph" Text="{Binding IconGlyph}"
                                       FontFamily="{StaticResource IconFont}" FontSize="15"
                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top"
                                       Margin="0,1,0,0" />
                            <TextBlock Grid.Column="1" Text="{Binding Message}" FontSize="12" Margin="10,0,8,0"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <Button Grid.Column="2" Content="&#xE711;" Style="{StaticResource IconButton}"
                                    Width="26" Height="26" FontSize="10"
                                    Command="{Binding DataContext.DismissToastCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsError}" Value="True">
                            <Setter TargetName="ToastCard" Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
                            <Setter TargetName="ToastGlyph" Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
