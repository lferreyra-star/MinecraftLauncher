<Window x:Class="XdLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:core="clr-namespace:XdLauncher.Core"
        Title="XD Launcher"
        Width="1440" Height="900"
        MinWidth="1120" MinHeight="720"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Opacity="0">
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
    <Window.Resources>
        <CollectionViewSource x:Key="GroupedNavigation" Source="{Binding Navigation}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
        <Style x:Key="BrandText" TargetType="TextBlock">
            <Setter Property="Text" Value="XD LAUNCHER" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style x:Key="BrandKicker" TargetType="TextBlock">
            <Setter Property="Text" Value="ECLIPSE" />
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="Foreground" Value="{DynamicResource AccentLightBrush}" />
        </Style>
        <Style x:Key="NavGroupText" TargetType="TextBlock">
            <Setter Property="Margin" Value="8,6,0,4" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>

        <Style x:Key="AccountChipToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome" Background="{DynamicResource ChipBrush}" BorderBrush="{DynamicResource BorderSoftBrush}"
                                BorderThickness="1" CornerRadius="13" Padding="9" Margin="14,8,14,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}"
                                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                                    <TextBlock Text="{Binding AccountInitial}" FontWeight="SemiBold" FontSize="13"
                                               Foreground="{DynamicResource AccentLightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,4,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12.5"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding AccountProviderLabel}" Style="{StaticResource Caption}" FontSize="10" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9"
                                           Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="RootLayout" ClipToBounds="True" MouseMove="RootLayout_MouseMove" MouseLeave="RootLayout_MouseLeave">
        <Grid x:Name="BackdropLayer" ClipToBounds="True" IsHitTestVisible="False">
            <Grid.RenderTransform><TranslateTransform x:Name="BackdropTranslate" X="0" Y="0" /></Grid.RenderTransform>
            <Border Background="{DynamicResource WindowBackgroundBrush}" />
            <Image x:Name="BackdropImage" RenderTransformOrigin="0.5,0.5"
                   Source="{Binding CurrentBackgroundPath, Converter={StaticResource ImagePath}}"
                   Stretch="UniformToFill" Opacity="0.55">
                <Image.Effect>
                    <BlurEffect Radius="{Binding Settings.BackgroundBlur}" />
                </Image.Effect>
                <Image.RenderTransform>
                    <ScaleTransform x:Name="BackdropScale" ScaleX="1" ScaleY="1" />
                </Image.RenderTransform>
            </Image>
            <Border Background="{DynamicResource BackdropOverlayBrush}" Opacity="{Binding Settings.BackgroundOverlayIntensity}" />
            <Grid ClipToBounds="True">
                <Ellipse x:Name="AmbientOrbA" Width="1100" Height="1100" HorizontalAlignment="Left" VerticalAlignment="Top"
                         Margin="-520,-620,0,0" Fill="{DynamicResource AccentGlowBrush}" Opacity="0.75">
                    <Ellipse.RenderTransform><TranslateTransform X="0" Y="0" /></Ellipse.RenderTransform>
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard x:Name="OrbAStoryboard">
                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="-70" To="90" Duration="0:0:26">
                                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="-40" To="70" Duration="0:0:31">
                                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>
                <Ellipse x:Name="AmbientOrbB" Width="900" Height="900" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                         Margin="0,0,-340,-430" Fill="{DynamicResource AccentGlowBrush}" Opacity="0.55">
                    <Ellipse.RenderTransform><TranslateTransform X="0" Y="0" /></Ellipse.RenderTransform>
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard x:Name="OrbBStoryboard">
                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="60" To="-80" Duration="0:0:27" />
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="30" To="-60" Duration="0:0:31" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>
                <Ellipse x:Name="AmbientOrbC" Width="1100" Height="1100" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="420,-150,0,0"
                         Fill="{DynamicResource BrandVioletSoftBrush}" Opacity="0.3" />
                <Border Background="{DynamicResource GridPatternBrush}" Opacity="0.3" />
                <Border Background="{DynamicResource VignetteBrush}" />
            </Grid>
            <Canvas x:Name="ParticleCanvas" IsHitTestVisible="False" />
        </Grid>

        <Grid ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== SIDEBAR ===== -->
            <Border x:Name="SidebarPanel"
                    Width="{Binding SidebarWidth}"
                    Visibility="{Binding IsFullscreen, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"
                    Background="{DynamicResource SidebarBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="0,0,14,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="80" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="116" />
                    </Grid.RowDefinitions>

                    <Border x:Name="BrandHeader" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                            Margin="16,0,16,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="40" Height="40" CornerRadius="12"
                                    Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}"
                                    BorderThickness="1">
                                <Image Source="/Assets/logo.png" Width="18" Height="18" />
                            </Border>
                            <StackPanel Margin="12,0,0,0">
                                <TextBlock Text="XD LAUNCHER" Style="{StaticResource BrandText}" />
                                <TextBlock Text="ECLIPSE" Style="{StaticResource BrandKicker}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Background="{DynamicResource SurfaceStrongBrush}" BorderBrush="{DynamicResource BorderSoftBrush}"
                            BorderThickness="1" CornerRadius="14" Padding="0">
                        <Grid x:Name="NavStage">
                            <Border x:Name="NavIndicator" Width="3" Height="40" Margin="12,8,0,0"
                                    HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="2"
                                    Background="{DynamicResource AccentBrush}" Effect="{DynamicResource AccentGlowEffect}"
                                    IsHitTestVisible="False" Opacity="0" Panel.ZIndex="4">
                                <Border.RenderTransform><TranslateTransform x:Name="NavIndicatorTranslate" Y="0" /></Border.RenderTransform>
                            </Border>
                            <ListBox x:Name="NavList" ItemContainerStyle="{StaticResource NavRailItem}" ItemsSource="{Binding Source={StaticResource GroupedNavigation}}"
                                     SelectedItem="{Binding CurrentNavigation, Mode=TwoWay}"
                                     Margin="10,8,10,6" BorderThickness="0"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.Panel>
                                        <ItemsPanelTemplate><StackPanel IsItemsHost="True" Margin="0,8" /></ItemsPanelTemplate>
                                    </GroupStyle.Panel>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name, Converter={StaticResource UpperText}}"
                                                       Style="{StaticResource NavGroupText}" />
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            </ListBox>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,0,0,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <ToggleButton x:Name="AccountToggle" Style="{StaticResource AccountChipToggle}" Margin="14,6,14,0" />
                        <Popup x:Name="AccountPopup" Placement="Top" PlacementTarget="{Binding ElementName=AccountToggle}"
                               StaysOpen="False" IsOpen="{Binding IsChecked, ElementName=AccountToggle, Mode=TwoWay}">
                            <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource AccentBrush}"
                                    BorderThickness="1" CornerRadius="14" Padding="8" Width="260" Margin="0,0,0,8"
                                    Effect="{StaticResource PanelShadow}">
                                <StackPanel>
                                    <TextBlock Text="{Binding AccountDisplayName}" FontWeight="SemiBold" Margin="8,6,0,0" />
                                    <TextBlock Text="{Binding AccountEmail}" Style="{StaticResource Caption}" Margin="8,2,0,8" />
                                    <Border Style="{StaticResource Divider}" Margin="0,0,0,4" />
                                    <Button Content="Ver perfil" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left"
                                            Command="{Binding NavigateCommand}" CommandParameter="profile" Click="AccountMenuClick" />
                                    <Button Content="Cerrar sesión" Style="{StaticResource DangerButton}" HorizontalContentAlignment="Left"
                                            Command="{Binding SignOutCommand}" Click="AccountMenuClick" />
                                </StackPanel>
                            </Border>
                        </Popup>

                        <TextBlock Grid.Row="1" Text="{Binding LauncherVersion, StringFormat='v{0}'}" Style="{StaticResource Caption}"
                                   HorizontalAlignment="Left" Margin="22,4,0,6" VerticalAlignment="Bottom" />
                    </Grid>
                </Grid>
            </Border>

            <!-- ===== TOP BAR + CONTENT ===== -->
            <Grid Grid.Column="1" Margin="0,0,0,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="66" />
                    <RowDefinition Height="44" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border x:Name="TopBar" Visibility="{Binding IsFullscreen, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"
                        Background="{DynamicResource TopBarBrush}" BorderBrush="{DynamicResource BorderSoftBrush}"
                        BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="16,0,12,0" VerticalAlignment="Center">
                            <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource AccentSoftBrush}"
                                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                                <Image Source="/Assets/logo.png" Width="17" Height="17" />
                            </Border>
                            <StackPanel Margin="9,0,0,0">
                                <TextBlock Text="XD LAUNCHER" Style="{StaticResource BrandText}" FontSize="14" />
                                <TextBlock Text="ECLIPSE" Style="{StaticResource BrandKicker}" FontSize="8.5" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="HeaderPanel" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,18,0"
                                    ClipToBounds="True" RenderTransformOrigin="0,0.5">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="38" Height="38" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}"
                                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                                    <TextBlock Text="{Binding CurrentGlyph}" FontFamily="{StaticResource IconFont}" FontSize="16"
                                               Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="11,0,0,0">
                                    <TextBlock Text="{Binding CurrentTitle}" Style="{StaticResource PageTitle}" FontSize="20"
                                               MaxWidth="340" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding CurrentSubtitle}" Style="{StaticResource Caption}" FontSize="10.5"
                                               MaxWidth="420" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Border Style="{StaticResource Pill}" Padding="10,6" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,7,0" />
                                    <TextBlock Text="{Binding TopBarStatusText}" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Pill}" Padding="10,6" Margin="0,0,8,0"
                                    Visibility="{Binding Game.IsGameRunning, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="EN JUEGO" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentLightBrush}" />
                            </Border>
                            <Border Style="{StaticResource Pill}" Padding="10,6" Margin="0,0,10,0">
                                <TextBlock FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}">
                                    <Run Text="{Binding Downloads.ActiveDownloads, Mode=OneWay}" /><Run Text=" descargas" />
                                </TextBlock>
                            </Border>
                            <Button Style="{StaticResource GhostButton}" Height="34" Padding="9,0" Margin="0,0,10,0"
                                    Command="{Binding NavigateCommand}" CommandParameter="profile" ToolTip="Selector de perfil">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="26" Height="26" CornerRadius="9" Background="{DynamicResource AccentSoftBrush}"
                                            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                                        <TextBlock Text="{Binding AccountInitial}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentLightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding AccountDisplayName}" Margin="8,0,5,0" MaxWidth="130" FontSize="11.5"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimizar" />
                                <Button x:Name="MaximizeButton" Style="{StaticResource ChromeButton}" Content="&#xE922;" Click="Maximize_Click" ToolTip="Maximizar" />
                                <Button Style="{StaticResource ChromeCloseButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Cerrar" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border x:Name="TopTabsBar" Grid.Row="1" Margin="0,0,0,4"
                        Visibility="{Binding IsFullscreen, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"
                        Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderSoftBrush}"
                        BorderThickness="0,0,0,1" Padding="16,0,16,0">
                    <ListBox ItemsSource="{Binding QuickNavigation}" SelectedValuePath="Key"
                             SelectedValue="{Binding CurrentNavigationKey, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,0,6,0" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Chrome" CornerRadius="10" Padding="14,0" Background="Transparent"
                                                    BorderBrush="Transparent" BorderThickness="1" RenderTransformOrigin="0.5,0.5">
                                                <Border.RenderTransform><ScaleTransform x:Name="TabScale" ScaleX="1" ScaleY="1" /></Border.RenderTransform>
                                                <Grid>
                                                    <TextBlock x:Name="TabText" Text="{Binding Title}" FontSize="11.5" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                                    <Border x:Name="TabUnderline" Height="2" CornerRadius="1" VerticalAlignment="Bottom"
                                                            Margin="0,0,0,3" Background="{DynamicResource AccentBrush}" Opacity="0" />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource RowHoverBrush}" />
                                                    <Setter TargetName="TabText" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentSoftBrush}" />
                                                    <Setter TargetName="TabText" Property="Foreground" Value="{DynamicResource AccentLightBrush}" />
                                                    <Setter TargetName="TabUnderline" Property="Opacity" Value="1" />
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="TabScale" Storyboard.TargetProperty="ScaleX" From="0.92" To="1" Duration="0:0:0.2">
                                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetName="TabScale" Storyboard.TargetProperty="ScaleY" From="0.92" To="1" Duration="0:0:0.2">
                                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Border>

                <Grid x:Name="PageStage" Grid.Row="2" Margin="24,24,24,14">
                    <ContentControl x:Name="PageHost" Panel.ZIndex="1" RenderTransformOrigin="0.5,0.5">
                        <ContentControl.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                                <TranslateTransform X="0" Y="0" />
                            </TransformGroup>
                        </ContentControl.RenderTransform>
                    </ContentControl>
                    <ContentControl x:Name="PreviousPageHost" Panel.ZIndex="2" IsHitTestVisible="False" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <ContentControl.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                                <TranslateTransform X="0" Y="0" />
                            </TransformGroup>
                        </ContentControl.RenderTransform>
                    </ContentControl>
                    <Border x:Name="TransitionSweep" Panel.ZIndex="3" IsHitTestVisible="False" Opacity="0"
                            Width="300" HorizontalAlignment="Left" VerticalAlignment="Stretch">
                        <Border.RenderTransform><TranslateTransform X="0" Y="0" /></Border.RenderTransform>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00000000" Offset="0" />
                                <GradientStop Color="{DynamicResource AccentColor}" Offset="0.5" />
                                <GradientStop Color="#00000000" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect><BlurEffect Radius="14" /></Border.Effect>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <ItemsControl x:Name="Toasts" ItemsSource="{Binding Toasts}" HorizontalAlignment="Right"
                      VerticalAlignment="Bottom" Margin="20,0,20,16" Width="420" Panel.ZIndex="20">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource GlassStrongBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="14" Margin="0,8,0,0" Padding="12" Width="420"
                            Effect="{DynamicResource PanelShadow}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource ErrorSoftBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="IconTile" Width="30" Height="30" CornerRadius="9"
                                    Background="{DynamicResource AccentSoftBrush}"
                                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                                <TextBlock x:Name="IconText" Text="{Binding IconGlyph}" FontFamily="{StaticResource IconFont}" FontSize="12"
                                           Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding Message}" Margin="10,0,10,0" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Content="&#xE711;" Style="{StaticResource IconButton}" Width="26" Height="26"
                                    Command="{Binding DataContext.DismissToastCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
