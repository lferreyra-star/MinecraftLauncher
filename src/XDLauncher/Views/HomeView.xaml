<UserControl x:Class="XdLauncher.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="HomeKicker" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentLightBrush}" />
        </Style>
        <Style x:Key="HomeSection" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style x:Key="HomeBody" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="HomeSmall" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="ImageTile" TargetType="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="16" ClipToBounds="True"
                                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSoftBrush}"
                                BorderThickness="1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Root" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="1.02" ScaleY="1.02" /></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="DashboardRoot" Margin="0,0,4,16" MaxWidth="1500" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- HERO CINEMATOGRÁFICO -->
            <Border x:Name="BannerRoot" Style="{StaticResource HeroBanner}" Height="352">
                <Border.Background>
                    <ImageBrush ImageSource="{Binding CurrentBannerPath, Converter={StaticResource ImagePath}}" Stretch="UniformToFill" />
                </Border.Background>
                <Grid>
                    <Border Style="{StaticResource HeroOverlay}" />
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="30,22,30,0">
                            <Border Style="{StaticResource Badge}">
                                <TextBlock Text="MUNDO XD" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentLightBrush}" />
                            </Border>
                            <Border Style="{StaticResource Pill}" Margin="8,0,0,0">
                                <TextBlock Text="{Binding BannerPosition}" FontSize="9.5" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,20,26,0">
                            <Button Style="{StaticResource IconButton}" Content="&#xE76B;" Width="32" Height="32"
                                    Command="{Binding PreviousBannerCommand}" ToolTip="Banner anterior" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE76C;" Width="32" Height="32"
                                    Command="{Binding NextBannerCommand}" ToolTip="Siguiente banner" />
                        </StackPanel>

                        <StackPanel x:Name="BannerContent" Grid.Row="2" Margin="30,0,30,28">
                            <TextBlock Text="{Binding EditionBadgeLabel}" Style="{StaticResource Kicker}" />
                            <TextBlock Text="{Binding BannerTitle}" Style="{StaticResource DisplayHero}" FontSize="34"
                                       TextWrapping="Wrap" MaxWidth="680" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding BannerDescription}" Style="{StaticResource BodyText}" MaxWidth="620" Margin="0,8,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Height="48" MinWidth="210"
                                        Content="{Binding MainActionLabel}" Command="{Binding MainActionCommand}" />
                                <Button Style="{StaticResource SecondaryButton}" Height="48" Margin="10,0,0,0"
                                        Content="Verificar" Command="{Binding VerifyCommand}"
                                        Visibility="{Binding ShowVerify, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </StackPanel>

                        <ItemsControl Grid.Row="2" ItemsSource="{Binding BannerTitles}" HorizontalAlignment="Right"
                                      Margin="0,0,30,30" VerticalAlignment="Bottom">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="•" FontFamily="{StaticResource BodyFont}" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" VerticalContentAlignment="Center" Style="{StaticResource IconButton}" Width="9" Height="9" Padding="0" Margin="2,0"
                                            ToolTip="{Binding}" Command="{Binding DataContext.SelectBannerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Grid>
            </Border>

            <!-- DESTINOS GRÁFICOS -->
            <Grid Grid.Row="1" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource ImageTile}" Height="156" Margin="0,0,8,0"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="java">
                    <Grid>
                        <Grid.Background>
                            <ImageBrush ImageSource="pack://application:,,,/Assets/backgrounds/bg-cueva.png" Stretch="UniformToFill" />
                        </Grid.Background>
                        <Border Style="{StaticResource HeroOverlay}" />
                        <StackPanel VerticalAlignment="Bottom" Margin="18,0,18,16">
                            <TextBlock Text="JAVA EDITION" Style="{StaticResource HomeKicker}" />
                            <TextBlock Text="Crea sin límites" FontFamily="{StaticResource DisplayFont}" FontSize="20"
                                       FontWeight="SemiBold" Foreground="{DynamicResource HeroForegroundBrush}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>
                </Button>

                <Button Grid.Column="1" Style="{StaticResource ImageTile}" Height="156" Margin="8,0,8,0"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="bedrock">
                    <Grid>
                        <Grid.Background>
                            <ImageBrush ImageSource="pack://application:,,,/Assets/backgrounds/bg-fantastico.png" Stretch="UniformToFill" />
                        </Grid.Background>
                        <Border Style="{StaticResource HeroOverlay}" />
                        <StackPanel VerticalAlignment="Bottom" Margin="18,0,18,16">
                            <TextBlock Text="BEDROCK" Style="{StaticResource HomeKicker}" />
                            <TextBlock Text="Juega en cualquier lugar" FontFamily="{StaticResource DisplayFont}" FontSize="20"
                                       FontWeight="SemiBold" Foreground="{DynamicResource HeroForegroundBrush}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>
                </Button>

                <Button Grid.Column="2" Style="{StaticResource ImageTile}" Height="156" Margin="8,0,8,0"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="mods">
                    <Grid>
                        <Grid.Background>
                            <ImageBrush ImageSource="pack://application:,,,/Assets/backgrounds/bg-magico.png" Stretch="UniformToFill" />
                        </Grid.Background>
                        <Border Style="{StaticResource HeroOverlay}" />
                        <StackPanel VerticalAlignment="Bottom" Margin="18,0,18,16">
                            <TextBlock Text="MODRINTH" Style="{StaticResource HomeKicker}" />
                            <TextBlock Text="Transforma tu juego" FontFamily="{StaticResource DisplayFont}" FontSize="20"
                                       FontWeight="SemiBold" Foreground="{DynamicResource HeroForegroundBrush}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>
                </Button>

                <Button Grid.Column="3" Style="{StaticResource ImageTile}" Height="156" Margin="8,0,0,0"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="downloads">
                    <Grid>
                        <Grid.Background>
                            <ImageBrush ImageSource="pack://application:,,,/Assets/backgrounds/bg-aurora.png" Stretch="UniformToFill" />
                        </Grid.Background>
                        <Border Style="{StaticResource HeroOverlay}" />
                        <StackPanel VerticalAlignment="Bottom" Margin="18,0,18,16">
                            <TextBlock Text="DESCARGAS" Style="{StaticResource HomeKicker}" />
                            <TextBlock Text="Todo al día" FontFamily="{StaticResource DisplayFont}" FontSize="20"
                                       FontWeight="SemiBold" Foreground="{DynamicResource HeroForegroundBrush}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>
                </Button>
            </Grid>

            <!-- PANEL INFERIOR: NOTICIAS + SESIÓN -->
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.7*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" ClipToBounds="True" MinHeight="300">
                    <Grid>
                        <Grid.Background>
                            <ImageBrush ImageSource="pack://application:,,,/Assets/backgrounds/bg-amanecer.png" Stretch="UniformToFill" />
                        </Grid.Background>
                        <Border Style="{StaticResource HeroOverlay}" />
                        <StackPanel Margin="26,24,26,24">
                            <TextBlock Text="NOVEDADES DEL MUNDO" Style="{StaticResource HomeKicker}" />
                            <TextBlock Text="{Binding NewsSectionTitle}" FontFamily="{StaticResource DisplayFont}" FontSize="25"
                                       FontWeight="SemiBold" Foreground="{DynamicResource HeroForegroundBrush}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding NewsStatus}" Style="{StaticResource HomeSmall}" Foreground="{DynamicResource HeroForegroundBrush}" Margin="0,6,0,0" />
                            <ItemsControl ItemsSource="{Binding News}" Margin="0,14,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left"
                                                Foreground="{DynamicResource HeroForegroundBrush}" Margin="0,0,0,2"
                                                Command="{Binding DataContext.OpenNewsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Historias, actualizaciones y eventos aparecerán aquí cuando estén disponibles."
                                       Style="{StaticResource HomeSmall}" Foreground="{DynamicResource HeroForegroundBrush}" Margin="0,10,0,0"
                                       Visibility="{Binding ShowNews, Converter={StaticResource InverseBool}}" />
                            <Button Style="{StaticResource SecondaryButton}" Content="Actualizar" Height="40" MinWidth="130"
                                    Margin="0,16,0,0" Command="{Binding OpenUpdatesCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                    <Border Style="{StaticResource Card}" Padding="20" Background="{DynamicResource SurfaceRaisedBrush}">
                        <StackPanel>
                            <TextBlock Text="TU SESIÓN" Style="{StaticResource HomeKicker}" />
                            <TextBlock Text="{Binding Greeting}" FontFamily="{StaticResource DisplayFont}" FontSize="24"
                                       FontWeight="SemiBold" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding WelcomeName}" Style="{StaticResource HomeBody}" Margin="0,4,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Border Width="44" Height="44" CornerRadius="14" Background="{DynamicResource SurfaceSunkenBrush}"
                                        BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1">
                                    <Grid>
                                        <TextBlock Text="{Binding AccountInitial}" FontFamily="{StaticResource DisplayFont}"
                                                   FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Image Source="{Binding AccountAvatarPath, Converter={StaticResource ImagePath}}"
                                               Stretch="UniformToFill" Visibility="{Binding AccountAvatarPath, Converter={StaticResource NullToVisibility}}" />
                                    </Grid>
                                </Border>
                                <StackPanel Margin="12,2,0,0">
                                    <TextBlock Text="{Binding AccountProviderLabel}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding AccountStatusText}" Style="{StaticResource HomeSmall}" />
                                </StackPanel>
                            </StackPanel>
                            <Button Style="{StaticResource GhostButton}" Content="Abrir perfil XD" Height="42" Margin="0,16,0,0"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="profile" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,12,0,0">
                        <Grid>
                            <Grid.Background>
                                <ImageBrush ImageSource="pack://application:,,,/Assets/backgrounds/bg-nocturno.png" Stretch="UniformToFill" />
                            </Grid.Background>
                            <Border Style="{StaticResource HeroOverlay}" />
                            <StackPanel Margin="6">
                                <TextBlock Text="MÓVIL" Style="{StaticResource HomeKicker}" />
                                <TextBlock Text="{Binding Mobile.StatusLabel}" FontFamily="{StaticResource DisplayFont}" FontSize="20"
                                           FontWeight="SemiBold" Foreground="{DynamicResource HeroForegroundBrush}" Margin="0,6,0,0" />
                                <TextBlock Text="{Binding Mobile.StatusMessage}" Style="{StaticResource HomeSmall}" Foreground="{DynamicResource HeroForegroundBrush}" Margin="0,4,0,0" />
                                <Button Style="{StaticResource GhostButton}" Content="Conectar teléfono" Height="38" Margin="0,10,0,0"
                                        Foreground="{DynamicResource HeroForegroundBrush}" Command="{Binding OpenMobileCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
