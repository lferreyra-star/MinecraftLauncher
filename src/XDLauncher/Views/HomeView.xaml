<UserControl x:Class="XdLauncher.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="HomeKicker" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentLightBrush}" />
        </Style>
        <Style x:Key="HomeSection" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style x:Key="HomeBody" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="HomeSmall" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="HomeTile" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1"
                                CornerRadius="14" Padding="14">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceStrongBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentSoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="DashboardRoot" Margin="0,0,4,16" MaxWidth="1400" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="284" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- ==================== IDENTIDAD Y SESIÓN ==================== -->
            <StackPanel Margin="0,0,12,0" Grid.Column="0" Grid.RowSpan="2">
                <Border Style="{StaticResource Card}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="HOLA" Style="{StaticResource HomeKicker}" />
                        <TextBlock Text="{Binding Greeting}" Style="{StaticResource HomeSection}" FontSize="22" />
                        <TextBlock Text="{Binding WelcomeName}" Style="{StaticResource HomeBody}" Margin="0,8,0,0" />
                        <Border Width="40" Height="40" CornerRadius="13" Background="{DynamicResource SurfaceSunkenBrush}"
                                BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" Margin="0,16,0,0">
                            <Grid>
                                <TextBlock Text="{Binding AccountInitial}" FontFamily="{StaticResource DisplayFont}"
                                           FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image Source="{Binding AccountAvatarPath, Converter={StaticResource ImagePath}}"
                                       Stretch="UniformToFill" Visibility="{Binding AccountAvatarPath, Converter={StaticResource NullToVisibility}}" />
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding AccountEmail}" Style="{StaticResource HomeSmall}" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding AccountProviderLabel}" Style="{StaticResource HomeBody}" FontWeight="SemiBold" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding AccountStatusText}" Style="{StaticResource HomeSmall}" />
                        <Border Height="1" Background="{DynamicResource BorderSoftBrush}" Margin="0,16,0,16" />
                        <Button Style="{StaticResource HomeTile}" Content="Perfil XD · Cuenta"
                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="profile" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="20">
                    <StackPanel>
                        <TextBlock Text="CONEXIÓN" Style="{StaticResource HomeKicker}" />
                        <TextBlock Text="{Binding AccountProviderLabel}" Style="{StaticResource HomeBody}" FontWeight="SemiBold" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding AccountEmail}" Style="{StaticResource HomeSmall}" Margin="0,5,0,0" />
                        <TextBlock Text="Sesión protegida y automática con Firebase." Style="{StaticResource HomeSmall}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="20">
                    <StackPanel>
                        <TextBlock Text="ACCESOS RÁPIDOS" Style="{StaticResource HomeKicker}" />
                        <Button Style="{StaticResource HomeTile}" Content="Minecraft Java"
                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="java" Margin="0,8,0,0" />
                        <Button Style="{StaticResource HomeTile}" Content="Juego" Margin="8,8,0,0"
                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="game" />
                        <Button Style="{StaticResource HomeTile}" Content="Modrinth" Margin="8,8,0,0"
                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="mods" />
                        <Button Style="{StaticResource HomeTile}" Content="Descargas" Margin="8,8,0,0"
                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="downloads" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== JUEGO / CÓMPLICES ==================== -->
            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                <Border Style="{StaticResource HeroBanner}" Height="218" Margin="0,0,0,14">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding DataContext.CurrentBackgroundPath, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ImagePath}}"
                                    Stretch="UniformToFill" />
                    </Border.Background>
                    <Grid>
                        <Border Style="{StaticResource HeroOverlay}" />
                    <StackPanel Margin="24" VerticalAlignment="Bottom">
                        <Border Style="{StaticResource Badge}" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding EditionBadgeLabel}" FontSize="9.5" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentLightBrush}" />
                        </Border>
                        <TextBlock Text="{Binding HeroHeadline}" Style="{StaticResource HeroTitle}" FontSize="30" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding HeroDetail}" Style="{StaticResource BodyText}" MaxWidth="560" Margin="0,6,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Height="42" MinWidth="180"
                                    Content="{Binding MainActionLabel}" Command="{Binding MainActionCommand}" />
                            <Button Style="{StaticResource SecondaryButton}" Height="42" Margin="8,0,0,0"
                                    Content="Verificar" Command="{Binding VerifyCommand}"
                                    Visibility="{Binding ShowVerify, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </StackPanel>
                                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="STATUS" Style="{StaticResource HomeKicker}" />
                            <TextBlock Text="{Binding Game.StatusHeadline}" Style="{StaticResource HomeSection}" Margin="0,10,0,0" />
                            <TextBlock Text="{Binding Game.StatusDetail}" Style="{StaticResource HomeBody}" Margin="0,6,0,0" />
                            <WrapPanel Margin="0,16,0,0">
                                <Border Background="{DynamicResource ChipBrush}" CornerRadius="9" Padding="8,5" Margin="0,0,6,6">
                                    <TextBlock Text="{Binding Game.VersionLabel, StringFormat='Versión {0}'}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Border>
                                <Border Background="{DynamicResource ChipBrush}" CornerRadius="9" Padding="8,5" Margin="0,0,6,6">
                                    <TextBlock Text="{Binding Game.ChannelLabel}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Border>
                                <Border Background="{DynamicResource ChipBrush}" CornerRadius="9" Padding="8,5" Margin="0,0,6,6">
                                    <TextBlock Text="{Binding Game.InstallDateLabel}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Border>
                            </WrapPanel>
                            <TextBlock Text="{Binding Game.ComponentsSummary}" Style="{StaticResource HomeSmall}" Margin="0,10,0,0" />
                            <TextBlock Text="{Binding Game.UpdateStatus}" Style="{StaticResource HomeSmall}" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Top" Margin="0,0,0,14">
                            <Button Style="{StaticResource PrimaryButton}" Height="46" MinWidth="220"
                                    Command="{Binding MainActionCommand}" Content="{Binding MainActionLabel}"
                                    Foreground="{DynamicResource AccentTextBrush}" />
                            <Button Style="{StaticResource SecondaryButton}" Height="46" Margin="8,10,0,0"
                                    Visibility="{Binding ShowVerify, Converter={StaticResource BoolToVisibility}}"
                                    Command="{Binding VerifyCommand}" Content="Verificar" />
                            <Button Style="{StaticResource SecondaryButton}" Height="46" Margin="8,10,0,0"
                                    Command="{Binding OpenUpdatesCommand}" Content="Novedades" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="20">
                    <StackPanel>
                        <TextBlock Text="ESTADO DE SERVICIOS" Style="{StaticResource HomeKicker}" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="FIREBASE AUTH" Style="{StaticResource HomeBody}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="●" Foreground="{DynamicResource SuccessBrush}" FontSize="10" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="MICROSOFT STORE" Style="{StaticResource HomeBody}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="●" Foreground="{DynamicResource SuccessBrush}" FontSize="10" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="MOBILE CONNECT" Style="{StaticResource HomeBody}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="●" Foreground="{DynamicResource SuccessBrush}" FontSize="10" VerticalAlignment="Center" />
                        </Grid>
                        <Button Style="{StaticResource HomeTile}" Content="Minecraft Java" Margin="0,14,0,0"
                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="java" />
                        <Button Style="{StaticResource HomeTile}" Content="Centro de Mods" Margin="0,8,0,0"
                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="mods" />
                        <Button Style="{StaticResource HomeTile}" Content="Descargas" Margin="0,8,0,0"
                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="downloads" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== NOVEDADES ==================== -->
            <Border Style="{StaticResource Card}" Grid.Column="1" Grid.Row="1" Margin="0,14,0,0" Padding="20" Height="420" Visibility="{Binding ShowNews, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="NOVEDADES" Style="{StaticResource HomeKicker}" />
                    <TextBlock Text="{Binding NewsSectionTitle}" Style="{StaticResource HomeSection}" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding NewsSectionSubtitle}" Style="{StaticResource HomeBody}" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding NewsStatus}" Style="{StaticResource HomeSmall}" Margin="0,10,0,0" />
                    <ListBox ItemsSource="{Binding News}" Margin="0,12,0,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource HomeTile}" Margin="0,0,0,8"
                                        Command="{Binding DataContext.OpenNewsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="{Binding Title}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                        <StackPanel Grid.Row="1" Orientation="Horizontal">
                                            <TextBlock Text="{Binding Category}" Style="{StaticResource HomeSmall}" />
                                            <TextBlock Text=" · " Style="{StaticResource HomeSmall}" />
                                            <TextBlock Text="{Binding DateLabel}" Style="{StaticResource HomeSmall}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
            <StackPanel Grid.Column="1" Grid.Row="1" Margin="0,14,0,0" Visibility="{Binding ShowNews, Converter={StaticResource InverseBool}}">
                <Border Style="{StaticResource Card}" Padding="20" Height="420">
                    <StackPanel>
                        <TextBlock Text="NOVEDADES" Style="{StaticResource HomeKicker}" />
                        <TextBlock Text="Aún no se han cargado" Style="{StaticResource HomeSection}" Margin="0,10,0,0" />
                        <TextBlock Text="Disfruta cuando estén disponibles." Style="{StaticResource HomeBody}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== MÓVIL ==================== -->
            <Border Style="{StaticResource Card}" Grid.Column="2" Grid.RowSpan="2" Margin="0,0,0,14" Padding="20">
                <StackPanel>
                    <TextBlock Text="MÓVIL" Style="{StaticResource HomeKicker}" />
                    <TextBlock Text="{Binding Mobile.StatusLabel}" Style="{StaticResource HomeSection}" Margin="0,10,0,0" />
                    <TextBlock Text="{Binding Mobile.StatusMessage}" Style="{StaticResource HomeBody}" Margin="0,6,0,0" />
                    <Button Style="{StaticResource HomeTile}" Content="Conectar teléfono" Margin="0,14,0,0"
                            Command="{Binding OpenMobileCommand}" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
