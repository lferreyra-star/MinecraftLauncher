<UserControl x:Class="XdLauncher.Views.JavaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="LaunchPanelCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Effect" Value="{StaticResource PanelShadow}" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
        <Style x:Key="LaunchSectionCard" TargetType="Border" BasedOn="{StaticResource InnerCard}">
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="LaunchMemorySlider" TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
            <Setter Property="Height" Value="18" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style x:Key="LaunchSecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Height" Value="48" />
        </Style>
        <Style x:Key="LaunchPlayButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Height" Value="56" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="ToolTip" Value="Selecciona e instala una versión" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                    CornerRadius="14" RenderTransformOrigin="0.5,0.5">
                                <Grid>
                                    <Border x:Name="Sheen" CornerRadius="13" IsHitTestVisible="False"
                                            Opacity="0" Background="{DynamicResource GlassStrongBrush}" />
                                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                      RecognizesAccessKey="True" />
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Sheen" Property="Opacity" Value="0.2" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentLightBrush}" />
                                <Setter TargetName="Chrome" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.6" Color="{DynamicResource AccentColor}" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Sheen" Property="Opacity" Value="0.08" />
                                <Setter TargetName="Chrome" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="0.985" ScaleY="0.985" /></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentLightBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.62" />
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter TargetName="Sheen" Property="Opacity" Value="0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="0,0,4,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Style="{StaticResource HeroBanner}" Height="236" Margin="0,0,0,18">
                <Border.Background>
                    <ImageBrush ImageSource="pack://application:,,,/Assets/backgrounds/bg-cueva.png" Stretch="UniformToFill" />
                </Border.Background>
                <Grid>
                    <Border Style="{StaticResource HeroOverlay}" />
                    <StackPanel Margin="30" VerticalAlignment="Bottom">
                        <TextBlock Text="JAVA EDITION" Style="{StaticResource Kicker}" />
                        <TextBlock Text="Tu mundo, tus reglas" Style="{StaticResource DisplayHero}" FontSize="32" Margin="0,6,0,0" />
                        <TextBlock Text="Versiones oficiales, perfiles aislados y lanzamiento con la configuración exacta que necesitas."
                                   Style="{StaticResource BodyText}" MaxWidth="680" Margin="0,8,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Border Style="{StaticResource Pill}" Margin="0,0,8,0">
                                <TextBlock Text="{Binding LatestReleaseLabel}" FontSize="10" FontWeight="SemiBold" />
                            </Border>
                            <Border Style="{StaticResource Pill}" Margin="0,0,8,0">
                                <TextBlock Text="{Binding WorkspaceName}" FontSize="10" FontWeight="SemiBold" />
                            </Border>
                            <Border Style="{StaticResource Pill}">
                                <TextBlock Text="{Binding VisibleCountLabel}" FontSize="10" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="LayoutRoot" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="MainRow" Height="Auto" />
                    <RowDefinition x:Name="LaunchRow" Height="0" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="LaunchColumn" Width="380" />
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="LeftColumn" Grid.Row="0" Grid.Column="0">
                    <Border Style="{StaticResource Card}" Padding="22">
                        <StackPanel>
                            <TextBlock Text="RELEASE" Style="{StaticResource Kicker}" />
                            <TextBlock Text="{Binding LatestReleaseLabel}" Style="{StaticResource HeroTitle}" FontSize="28" />
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Esquema de instalación" Style="{StaticResource StatLabel}" />
                                <TextBlock Grid.Column="1" Text="{Binding WorkspaceName}" Style="{StaticResource BodyText}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </Grid>
                            <Button Style="{StaticResource GhostButton}" Content="Actualizar" Command="{Binding RefreshCommand}"
                                    HorizontalAlignment="Left" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Padding="16">
                            <StackPanel>
                                <TextBlock Text="VERSIONES" Style="{StaticResource StatLabel}" />
                                <TextBlock Text="{Binding VisibleCountLabel}" Style="{StaticResource StatValue}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="16" Margin="10,0,0,0">
                            <StackPanel>
                                <TextBlock Text="INSTALADAS" Style="{StaticResource StatLabel}" />
                                <TextBlock Text="{Binding InstalledCountLabel}" Style="{StaticResource StatValue}" Foreground="{DynamicResource SuccessBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="16" Margin="10,0,0,0">
                            <StackPanel>
                                <TextBlock Text="DETALLES" Style="{StaticResource StatLabel}" />
                                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatValue}" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource Card}" Padding="20" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="BIBLIOTECA DE VERSIONES" Style="{StaticResource SectionTitle}" />
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Margin="0,0,10,0">
                                    <TextBox Style="{StaticResource InputTextBox}"
                                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}"
                                          MinWidth="132" Margin="0,0,10,0" />
                                <ComboBox Grid.Column="2" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}" MinWidth="158" />
                            </Grid>
                            <WrapPanel Margin="0,10,0,0">
                                <CheckBox Content="Solo instaladas" IsChecked="{Binding ShowOnlyInstalled}" Style="{StaticResource ToggleSwitch}" Margin="0,0,16,0" />
                                <CheckBox Content="Solo nuevas" IsChecked="{Binding ShowOnlyNew}" Style="{StaticResource ToggleSwitch}" />
                            </WrapPanel>
                            <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                                <Border Style="{StaticResource InnerCard}" Padding="16" Margin="0,12,0,0">
                                    <StackPanel>
                                        <Border Style="{StaticResource SkeletonBar}" Width="420" Margin="0,6,0,0" />
                                        <Border Style="{StaticResource SkeletonBar}" Width="320" Margin="0,6,0,0" />
                                        <Border Style="{StaticResource SkeletonBar}" Width="260" Margin="0,6,0,0" />
                                        <Border Style="{StaticResource SkeletonBar}" Width="380" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Versions}" Margin="0,14,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource InnerCard}" Padding="12" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="42" Height="42" CornerRadius="11" Background="{DynamicResource ChipBrush}">
                                                        <TextBlock Text="{Binding TypeGlyph}" FontFamily="{StaticResource IconFont}" FontSize="17"
                                                                   Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Id}" FontWeight="SemiBold" FontSize="14" />
                                                            <Border Style="{StaticResource Pill}"><TextBlock Text="{Binding TypeLabel}" FontSize="10" FontWeight="SemiBold" /></Border>
                                                            <Border Style="{StaticResource Pill}" Margin="6,0,0,0"><TextBlock Text="{Binding ProfileTypeLabel}" FontSize="10" /></Border>
                                                        </StackPanel>
                                                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0">
                                                            <Run Text="{Binding DateLabel, Mode=OneWay}" />
                                                            <Run Text=" · " />
                                                            <Run Text="{Binding StatusLabel, Mode=OneWay}" />
                                                            <Run Text=" · " />
                                                            <Run Text="{Binding ProfileSummary, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <WrapPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" MaxWidth="330">
                                                        <Button Content="INSTALAR" Style="{StaticResource SecondaryButton}" FontSize="11" Margin="0,0,6,6"
                                                                Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                                Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                                        <Button Content="JUGAR" Style="{StaticResource PrimaryButton}" FontSize="11" Margin="0,0,6,6"
                                                                Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                                Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}" />
                                                        <Button Content="CONFIGURAR" Style="{StaticResource GhostButton}" FontSize="11" Margin="0,0,6,6"
                                                                Command="{Binding DataContext.ConfigureCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                                        <Button Content="ELIMINAR" Style="{StaticResource DangerButton}" FontSize="11" Margin="0,0,6,6"
                                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                                Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}" />
                                                        <Button Content="MODS" Style="{StaticResource GhostButton}" FontSize="10" Margin="0,0,6,6"
                                                                Command="{Binding DataContext.ModDownloadCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                                Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}" />
                                                    </WrapPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            <Border Style="{StaticResource InnerCard}" Padding="24"
                                    Visibility="{Binding HasVersions, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                                <StackPanel Style="{StaticResource EmptyState}">
                                    <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="26"
                                               Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Ninguna versión coincide" Style="{StaticResource CardTitle}" HorizontalAlignment="Center" Margin="0,10,0,0" />
                                    <TextBlock Text="Cambia el filtro o pulsa Actualizar." Style="{StaticResource EmptyStateBody}" />
                                    <Button Content="Actualizar versiones" Style="{StaticResource PrimaryButton}" Margin="0,16,0,0"
                                            Command="{Binding RefreshCommand}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border x:Name="LaunchPanel" Style="{StaticResource LaunchPanelCard}" Grid.Row="0" Grid.Column="1"
                        VerticalAlignment="Top" Margin="16,0,0,0" MaxWidth="420" MinWidth="0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="LAUNCH &amp; PERFIL" Style="{StaticResource Kicker}" />
                                <TextBlock Text="{Binding SelectedVersionLabel}" Style="{StaticResource CardTitle}" FontSize="26"
                                           Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding SelectedProfileSummary}" Style="{StaticResource Caption}"
                                           Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right">
                                <Border Style="{StaticResource Pill}" Padding="10,4"
                                        Visibility="{Binding HasPremiumAccount, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="PREMIUM" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" />
                                </Border>
                                <Border Style="{StaticResource Pill}" Padding="10,4"
                                        Visibility="{Binding HasPremiumAccount, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                                    <TextBlock Text="NO PREMIUM" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource Divider}" Margin="0,16,0,0" />

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="MEMORIA" Style="{StaticResource StatLabel}" />
                                <TextBlock Text="{Binding MemoryLabel}" Style="{StaticResource StatValue}" FontSize="16" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="VERSIÓN" Style="{StaticResource StatLabel}" />
                                <TextBlock Text="{Binding SelectedVersionLabel}" Style="{StaticResource StatValue}" FontSize="16"
                                           Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,16,0,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="MEMORIA ASIGNADA" Style="{StaticResource StatLabel}" />
                                <TextBlock Grid.Column="1" Text="GB" Style="{StaticResource Caption}" />
                            </Grid>
                            <Slider Grid.Row="1" Style="{StaticResource LaunchMemorySlider}"
                                    Minimum="1024" Maximum="32768" TickFrequency="1024" IsSnapToTickEnabled="True"
                                    Value="{Binding MemoryMb, Mode=TwoWay}" />
                            <Grid Grid.Row="2" Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="4*" />
                                    <ColumnDefinition Width="8*" /><ColumnDefinition Width="16*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="1" Style="{StaticResource Caption}" FontSize="10" HorizontalAlignment="Left" />
                                <TextBlock Grid.Column="1" Text="2" Style="{StaticResource Caption}" FontSize="10" HorizontalAlignment="Left" />
                                <TextBlock Grid.Column="2" Text="4" Style="{StaticResource Caption}" FontSize="10" HorizontalAlignment="Left" />
                                <TextBlock Grid.Column="3" Text="8" Style="{StaticResource Caption}" FontSize="10" HorizontalAlignment="Left" />
                                <TextBlock Grid.Column="4" Text="16" Style="{StaticResource Caption}" FontSize="10" HorizontalAlignment="Left" />
                                <TextBlock Grid.Column="4" Text="32" Style="{StaticResource Caption}" FontSize="10" HorizontalAlignment="Right" />
                            </Grid>
                        </Grid>

                        <Button Style="{StaticResource LaunchPlayButton}" Content="JUGAR"
                                Command="{Binding PrimaryCommand}" Margin="0,20,0,0" />
                        <Button Style="{StaticResource LaunchSecondaryButton}" Content="Detectar Java"
                                Command="{Binding DetectJavaCommand}" Margin="0,8,0,0" />

                        <Border Style="{StaticResource LaunchSectionCard}" Margin="0,16,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="MODLOADER" Style="{StaticResource StatLabel}" />
                                    <TextBlock Grid.Column="1" Text="FABRIC / FORGE" Style="{StaticResource Caption}" FontSize="9" />
                                </Grid>
                                <ComboBox ItemsSource="{Binding ModLoaderOptions}" SelectedItem="{Binding ModLoader}" Margin="0,8,0,0" />
                                <Button Content="Descargar mods" Style="{StaticResource LaunchSecondaryButton}" Margin="0,8,0,0" Command="{Binding ModDownloadCommand}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource LaunchSectionCard}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="RUTA DE JAVA" Style="{StaticResource StatLabel}" />
                                <TextBox Style="{StaticResource InputTextBox}" Text="{Binding JavaPath}" Margin="0,8,0,0" />
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="Elegir" Style="{StaticResource GhostButton}" Margin="0,0,6,6" Command="{Binding BrowseJavaCommand}" />
                                    <Button Content="Detectar" Style="{StaticResource GhostButton}" Margin="0,0,6,6" Command="{Binding DetectJavaCommand}" />
                                    <Button Content="Automático" Style="{StaticResource GhostButton}" Margin="0,0,0,6" Command="{Binding ResetJavaPathCommand}" />
                                </WrapPanel>
                                <TextBlock Text="{Binding JavaPathHint}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding JavaInfo}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource LaunchSectionCard}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="CARPETA DE PARTIDAS" Style="{StaticResource StatLabel}" />
                                <TextBox Style="{StaticResource InputTextBox}" Text="{Binding GameDirectory}" Margin="0,8,0,0" />
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="Elegir carpeta" Style="{StaticResource GhostButton}" Margin="0,0,6,6" Command="{Binding BrowseGameFolderCommand}" />
                                    <Button Content="Abrir partidas" Style="{StaticResource GhostButton}" Margin="0,0,6,6" Command="{Binding OpenProfileSavesCommand}" />
                                    <Button Content="Abrir mods" Style="{StaticResource GhostButton}" Margin="0,0,0,6" Command="{Binding OpenProfileModsCommand}" />
                                </WrapPanel>
                                <TextBlock Text="{Binding GameDirectoryHint}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource LaunchSectionCard}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="PERMISOS Y LOGS" Style="{StaticResource StatLabel}" />
                                <Button Content="Abrir workspace" Style="{StaticResource GhostButton}" Margin="0,8,0,0" Command="{Binding OpenWorkspaceFolderCommand}" />
                                <Button Content="Abrir registros" Style="{StaticResource GhostButton}" Margin="0,0,0,4" Command="{Binding OpenWorkspaceLogsCommand}" />
                                <TextBlock Text="{Binding PremiumStatus}" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
