<UserControl x:Class="XdLauncher.Views.JavaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,6,28">

            <!-- Header -->
            <Border Style="{StaticResource Card}" Padding="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="64" Height="64" CornerRadius="18" Background="{DynamicResource ChipBrush}">
                        <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" FontSize="28"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Minecraft Java Edition" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="Administrador de versiones con workspaces independientes Premium y No-Premium: perfiles, Java, RAM, Fabric, mundos y registros sin mezclarse."
                                   Style="{StaticResource Muted}" Margin="0,4,0,0" MaxWidth="760" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="&#xE72C;  Actualizar" Style="{StaticResource GhostButton}"
                                Margin="0,0,10,0" Command="{Binding RefreshCommand}" />
                        <Button Content="Cancelar" Style="{StaticResource DangerButton}"
                                Command="{Binding CancelCommand}"
                                Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Workspaces -->
            <Border Style="{StaticResource Card}" Padding="20" Margin="0,14,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Workspaces independientes" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding WorkspaceSummary}" Style="{StaticResource Caption}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <RadioButton GroupName="JavaWorkspace" Style="{StaticResource SegmentRadio}"
                                     IsChecked="{Binding IsPremiumTab, Mode=OneWay}"
                                     Command="{Binding SelectWorkspaceCommand}" CommandParameter="Premium">
                            <StackPanel>
                                <TextBlock Text="PREMIUM" FontWeight="Bold" />
                                <TextBlock Text="{Binding PremiumInstalledCountLabel}" FontSize="10" Opacity="0.8" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="JavaWorkspace" Style="{StaticResource SegmentRadio}"
                                     Margin="8,0,0,0"
                                     IsChecked="{Binding IsNoPremiumTab, Mode=OneWay}"
                                     Command="{Binding SelectWorkspaceCommand}" CommandParameter="NoPremium">
                            <StackPanel>
                                <TextBlock Text="NO-PREMIUM" FontWeight="Bold" />
                                <TextBlock Text="{Binding NoPremiumInstalledCountLabel}" FontSize="10" Opacity="0.8" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <Border Style="{StaticResource InnerCard}" Padding="12" Margin="0,12,0,0"
                            Visibility="{Binding AccountWarningVisible, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                       Foreground="{DynamicResource WarningBrush}" Margin="0,0,10,0" />
                            <TextBlock Text="El workspace Premium no usa perfiles locales. Inicia sesión con Microsoft y configura el Client ID en Ajustes para jugar con tu cuenta."
                                       Style="{StaticResource Muted}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,12,0,0">
                        <TextBlock Text="{Binding WorkspacePath}" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button Content="Abrir carpeta del workspace" Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Right" Command="{Binding OpenWorkspaceFolderCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Stats -->
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource InnerCard}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="ÚLTIMA RELEASE" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding LatestReleaseLabel}" Style="{StaticResource StatValue}"
                                   Foreground="{DynamicResource AccentBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource InnerCard}" Padding="16" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="VERSIONES" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding VisibleCountLabel}" Style="{StaticResource StatValue}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource InnerCard}" Padding="16" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="INSTALADAS" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding InstalledCountLabel}" Style="{StaticResource StatValue}"
                                   Foreground="{DynamicResource SuccessBrush}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource InnerCard}" Padding="16" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="ESTADO" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatValue}"
                                   FontSize="12" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Version library -->
                <Border Style="{StaticResource Card}" Padding="20">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Biblioteca de versiones" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding VisibleCountLabel}" Style="{StaticResource Caption}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Margin="0,0,10,0">
                                <TextBox Style="{StaticResource InputTextBox}"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="34,9,12,9" />
                                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="12,0,0,0"
                                           VerticalAlignment="Center" IsHitTestVisible="False" />
                                <TextBlock Text="Buscar versión (1.21.4, 1.8.9…)" Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center" Margin="34,0,0,0" IsHitTestVisible="False"
                                           FontSize="12"
                                           Visibility="{Binding SearchText, Converter={StaticResource StringToVisibility}, ConverterParameter=invert}" />
                            </Grid>

                            <ComboBox Grid.Column="1" ItemsSource="{Binding Filters}"
                                      SelectedItem="{Binding SelectedFilter}" MinWidth="140" Margin="0,0,10,0" />
                            <ComboBox Grid.Column="2" ItemsSource="{Binding SortOptions}"
                                      SelectedItem="{Binding SelectedSort}" MinWidth="170" />
                        </Grid>

                        <WrapPanel Margin="0,10,0,0">
                            <CheckBox Content="Solo instaladas" IsChecked="{Binding ShowOnlyInstalled}"
                                      Style="{StaticResource ToggleSwitch}" Margin="0,0,16,0" />
                            <CheckBox Content="Solo nuevas" IsChecked="{Binding ShowOnlyNew}"
                                      Style="{StaticResource ToggleSwitch}" />
                        </WrapPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="560" Margin="0,14,0,0">
                            <ItemsControl ItemsSource="{Binding Versions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource InnerCard}" Padding="12" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Width="42" Height="42" CornerRadius="11"
                                                        Background="{DynamicResource ChipBrush}">
                                                    <TextBlock Text="{Binding TypeGlyph}" FontFamily="{StaticResource IconFont}"
                                                               FontSize="17" Foreground="{DynamicResource AccentBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>

                                                <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Id}" FontWeight="SemiBold" FontSize="14" />
                                                        <Border Style="{StaticResource Pill}" Margin="8,0,0,0">
                                                            <TextBlock Text="{Binding TypeLabel}" FontSize="10" FontWeight="SemiBold" />
                                                        </Border>
                                                        <Border Style="{StaticResource Pill}" Margin="6,0,0,0"
                                                                Background="{DynamicResource ChipBrush}">
                                                            <TextBlock Text="{Binding ProfileTypeLabel}" FontSize="10" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0">
                                                        <Run Text="{Binding DateLabel, Mode=OneWay}" />
                                                        <Run Text=" · " />
                                                        <Run Text="{Binding StatusLabel, Mode=OneWay}" />
                                                        <Run Text=" · " />
                                                        <Run Text="{Binding ProfileSummary, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="INSTALAR" Style="{StaticResource SecondaryButton}"
                                                            Margin="0,0,6,0" FontSize="11"
                                                            Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                                    <Button Content="JUGAR" Style="{StaticResource PrimaryButton}"
                                                            Margin="0,0,6,0" FontSize="11"
                                                            Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}" />
                                                    <Button Content="CONFIGURAR" Style="{StaticResource GhostButton}"
                                                            Margin="0,0,6,0" FontSize="11"
                                                            Command="{Binding DataContext.ConfigureCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="ELIMINAR" Style="{StaticResource DangerButton}"
                                                            FontSize="11"
                                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}" />
                                                    <Button Content="MODS" Style="{StaticResource GhostButton}"
                                                            Margin="0,0,6,0" FontSize="10"
                                                            Command="{Binding DataContext.ModDownloadCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Border Style="{StaticResource InnerCard}" Padding="24" Margin="0,4,0,0"
                                Visibility="{Binding HasVersions, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="26"
                                           Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="No hay versiones que coincidan" Style="{StaticResource CardTitle}"
                                           HorizontalAlignment="Center" Margin="0,10,0,0" />
                                <TextBlock Text="Cambia el filtro o pulsa Actualizar para consultar el manifiesto oficial."
                                           Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                <Button Content="Recargar manifiesto" Style="{StaticResource GhostButton}"
                                        Margin="0,12,0,0" Command="{Binding RefreshCommand}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Cada workspace guarda sus versiones, bibliotecas, recursos, Java, perfiles, mods, mundos y registros en carpetas independientes. Fabric se instala y ejecuta de forma real."
                                   Style="{StaticResource Caption}" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <!-- Launch & settings -->
                <Border Grid.Column="1" Style="{StaticResource Card}" Width="400" Margin="14,0,0,0" Padding="20"
                        VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Lanzamiento y configuración" Style="{StaticResource SectionTitle}" />

                        <Border Style="{StaticResource InnerCard}" Padding="14" Margin="0,12,0,0">
                            <StackPanel>
                                <Border Height="120" CornerRadius="12" Background="{DynamicResource ChipBrush}" Margin="0,0,0,12">
                                    <Grid>
                                        <Image Source="/Assets/logo.png" Width="72" Height="72" Opacity="0.22"
                                               HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,8"/>
                                        <StackPanel VerticalAlignment="Center" Margin="14">
                                            <TextBlock Text="MINECRAFT JAVA" Style="{StaticResource Caption}" />
                                            <TextBlock Text="{Binding SelectedVersionLabel}" FontSize="22" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <Border Style="{StaticResource Pill}">
                                                    <TextBlock Text="{Binding SelectedVersionType}" FontSize="10" FontWeight="SemiBold" />
                                                </Border>
                                                <TextBlock Text="{Binding SelectedProfileSummary}" Style="{StaticResource Caption}"
                                                           Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding SelectedVersionDate}" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="PERFIL" Style="{StaticResource Caption}" />
                                        <TextBlock Text="{Binding WorkspaceName}" FontWeight="SemiBold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="MEMORIA" Style="{StaticResource Caption}" />
                                        <TextBlock Text="{Binding MemoryLabel}" FontWeight="SemiBold" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Text="JAVA DETECTADO" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding JavaInfo}" Style="{StaticResource Muted}" Margin="0,2,0,0" MaxHeight="34" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <Button Style="{StaticResource PrimaryButton}" Height="52" Margin="0,14,0,0"
                                        Command="{Binding PrimaryCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                                   Margin="0,1,10,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                                                    <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1" ScaleY="1"/></Setter.Value></Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard x:Name="Pulse">
                                                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" From="1" To="1.2" Duration="0:0:0.5"/>
                                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" From="1" To="1.2" Duration="0:0:0.5"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                            <DataTrigger.ExitActions>
                                                                <StopStoryboard BeginStoryboardName="Pulse" />
                                                            </DataTrigger.ExitActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding PrimaryActionLabel}" FontSize="15" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>

                                <Button Content="Instalar Fabric" Style="{StaticResource SecondaryButton}" Margin="0,8,0,0"
                                        Command="{Binding InstallFabricCommand}"
                                        Visibility="{Binding IsSelectedFabricPending, Converter={StaticResource BoolToVisibility}}" />

                                <Button Content="&#xE71A;  Cerrar juego" Style="{StaticResource DangerButton}" Margin="0,8,0,0"
                                        Command="{Binding CloseGameCommand}"
                                        Visibility="{Binding IsSelectedRunning, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Border>

                        <!-- Progress -->
                        <Border Style="{StaticResource InnerCard}" Padding="14" Margin="0,12,0,0"
                                Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{Binding ProgressStage}" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text="{Binding ProgressPercent, StringFormat={}{0:0} %}"
                                               Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                                </Grid>
                                <ProgressBar Height="8" Margin="0,8,0,0" Minimum="0" Maximum="100"
                                             Value="{Binding ProgressPercent, Mode=OneWay}"
                                             IsIndeterminate="{Binding IsProgressIndeterminate}"
                                             Foreground="{DynamicResource AccentBrush}"
                                             Background="{DynamicResource ChipBrush}" />
                                <TextBlock Text="{Binding ProgressDetail}" Style="{StaticResource Caption}"
                                           Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Muted}" Margin="0,10,0,0"
                                   MaxHeight="44" TextTrimming="CharacterEllipsis" />

                        <Grid Margin="0,16,0,0">
                            <TextBlock Text="MEMORIA ASIGNADA" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding MemoryLabel}" Style="{StaticResource Caption}"
                                       HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}" />
                        </Grid>
                        <Slider Minimum="1024" Maximum="32768" TickFrequency="1024" IsSnapToTickEnabled="True"
                                Value="{Binding MemoryMb, Mode=TwoWay}" Margin="0,4,0,0" />

                        <TextBlock Text="TIPO DE PERFIL" Style="{StaticResource Caption}" Margin="0,12,0,0" />
                        <Border Style="{StaticResource InnerCard}" Padding="10" Margin="0,4,0,0">
                            <TextBlock Text="{Binding WorkspaceName}" FontWeight="SemiBold" />
                        </Border>

                        <TextBlock Text="NOMBRE DE JUGADOR LOCAL" Style="{StaticResource Caption}"
                                   Margin="0,12,0,0"
                                   Visibility="{Binding IsPlayerNameEditable, Converter={StaticResource BoolToVisibility}}" />
                        <TextBox Style="{StaticResource InputTextBox}" Margin="0,4,0,0"
                                 Text="{Binding PlayerName, UpdateSourceTrigger=LostFocus}" MaxLength="16"
                                 Visibility="{Binding IsPlayerNameEditable, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding PremiumStatus}" Style="{StaticResource Muted}" Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding IsPlayerNameEditable, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

                        <TextBlock Text="MODLOADER" Style="{StaticResource Caption}" Margin="0,12,0,0" />
                        <ComboBox ItemsSource="{Binding ModLoaderOptions}" SelectedItem="{Binding ModLoader}"
                                  Margin="0,4,0,0" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}">
                            <Run Text="Versión de Fabric: " />
                            <Run Text="{Binding FabricLoaderLabel, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                        <TextBlock Text="MODS" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                        <Border Style="{StaticResource InnerCard}" Padding="10" Margin="0,4,0,0">
                            <Button Content="Descargar mods para esta versión" Style="{StaticResource PrimaryButton}"
                                Command="{Binding ModDownloadCommand}" />
                        </Border>

                        <TextBlock Text="RUTA DE JAVA (OPCIONAL)" Style="{StaticResource Caption}" Margin="0,12,0,0" />
                        <TextBox Style="{StaticResource InputTextBox}" Margin="0,4,0,0"
                                 Text="{Binding JavaPath, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Text="{Binding JavaPathHint}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis" />
                        <WrapPanel Margin="0,6,0,0">
                            <Button Content="Elegir java.exe" Style="{StaticResource GhostButton}" Margin="0,0,6,6"
                                    Command="{Binding BrowseJavaCommand}" />
                            <Button Content="Detectar" Style="{StaticResource GhostButton}" Margin="0,0,6,6"
                                    Command="{Binding DetectJavaCommand}" />
                            <Button Content="Automático" Style="{StaticResource GhostButton}" Margin="0,0,0,6"
                                    Command="{Binding ResetJavaPathCommand}" />
                        </WrapPanel>
                        <TextBlock Text="{Binding JavaInfo}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                   MaxHeight="46" TextTrimming="CharacterEllipsis" />

                        <TextBlock Text="CARPETA DE PARTIDAS Y MUNDOS" Style="{StaticResource Caption}" Margin="0,12,0,0" />
                        <TextBox Style="{StaticResource InputTextBox}" Margin="0,4,0,0"
                                 Text="{Binding GameDirectory, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Text="{Binding GameDirectoryHint}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis" />
                        <WrapPanel Margin="0,6,0,0">
                            <Button Content="Elegir carpeta" Style="{StaticResource GhostButton}" Margin="0,0,6,6"
                                    Command="{Binding BrowseGameFolderCommand}" />
                            <Button Content="Predeterminada" Style="{StaticResource GhostButton}" Margin="0,0,6,6"
                                    Command="{Binding ResetGameFolderCommand}" />
                            <Button Content="Abrir partidas" Style="{StaticResource GhostButton}" Margin="0,0,6,6"
                                    Command="{Binding OpenProfileSavesCommand}" />
                            <Button Content="Abrir mods" Style="{StaticResource GhostButton}" Margin="0,0,0,6"
                                    Command="{Binding OpenProfileModsCommand}" />
                        </WrapPanel>

                        <Border Style="{StaticResource Divider}" Margin="0,12,0,0" />

                        <TextBlock Text="{Binding PremiumStatus}" Style="{StaticResource Muted}" Margin="0,12,0,0"
                                   TextWrapping="Wrap" />

                        <WrapPanel Margin="0,12,0,0">
                            <Button Content="Abrir workspace" Style="{StaticResource GhostButton}" Margin="0,0,6,6"
                                    Command="{Binding OpenWorkspaceFolderCommand}" />
                            <Button Content="Abrir registros" Style="{StaticResource GhostButton}" Margin="0,0,0,6"
                                    Command="{Binding OpenWorkspaceLogsCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
