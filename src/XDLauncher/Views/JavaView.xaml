<UserControl x:Class="XdLauncher.Views.JavaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="0,0,4,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <Border Style="{StaticResource HeroBanner}" Height="164" Margin="0,0,0,14">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding DataContext.CurrentBackgroundPath, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ImagePath}}"
                                    Stretch="UniformToFill" />
                    </Border.Background>
                    <Grid>
                        <Border Style="{StaticResource HeroOverlay}" />
                    <StackPanel Margin="26" VerticalAlignment="Bottom">
                        <TextBlock Text="BIBLIOTECA JAVA" Style="{StaticResource Kicker}" />
                        <TextBlock Text="Versiones y lanzamiento" Style="{StaticResource HeroTitle}" FontSize="28" Margin="0,6,0,0" />
                        <TextBlock Text="Instala versiones oficiales, aísla perfiles y lanza Minecraft con la configuración que necesitas." Style="{StaticResource BodyText}" MaxWidth="620" Margin="0,4,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Border Style="{StaticResource Pill}" Margin="0,0,8,0">
                            <TextBlock Text="{Binding LatestReleaseLabel}" FontSize="10" FontWeight="SemiBold" />
                        </Border>
                        <Border Style="{StaticResource Pill}" Margin="0,0,8,0">
                            <TextBlock Text="{Binding WorkspaceName}" FontSize="10" FontWeight="SemiBold" />
                        </Border>
                        </StackPanel>
                    </StackPanel>
                                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Padding="22">
                    <StackPanel>
                        <TextBlock Text="RELEASE" Style="{StaticResource Kicker}" />
                        <TextBlock Text="{Binding LatestReleaseLabel}" Style="{StaticResource HeroTitle}" FontSize="28" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Esquema de instalación" Style="{StaticResource StatLabel}" />
                            <TextBlock Grid.Column="1" Text="{Binding WorkspaceName}" Style="{StaticResource BodyText}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        </Grid>
                        <Button Style="{StaticResource GhostButton}" Content="Actualizar" Command="{Binding RefreshCommand}"
                                HorizontalAlignment="Left" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="VERSICONES" Style="{StaticResource StatLabel}" />
                            <TextBlock Text="{Binding VisibleCountLabel}" Style="{StaticResource StatValue}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="16" Margin="10,0,0,0">
                        <StackPanel>
                            <TextBlock Text="INSTALADAS" Style="{StaticResource StatLabel}" />
                            <TextBlock Text="{Binding InstalledCountLabel}" Style="{StaticResource StatValue}" Foreground="{DynamicResource SuccessBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="16" Margin="10,0,0,0">
                        <StackPanel>
                            <TextBlock Text="DETALLES" Style="{StaticResource StatLabel}" />
                            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatValue}" FontSize="12" TextWrapping="Wrap" MaxHeight="42" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource Card}" Padding="20" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="BIBLIOTECA DE VERSIONES" Style="{StaticResource SectionTitle}" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Margin="0,0,10,0">
                                <TextBox Style="{StaticResource InputTextBox}"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}"
                                      MinWidth="140" Margin="0,0,10,0" />
                            <ComboBox Grid.Column="2" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}" MinWidth="170" />
                        </Grid>
                        <WrapPanel Margin="0,10,0,0">
                            <CheckBox Content="Solo instaladas" IsChecked="{Binding ShowOnlyInstalled}" Style="{StaticResource ToggleSwitch}" Margin="0,0,16,0" />
                            <CheckBox Content="Solo nuevas" IsChecked="{Binding ShowOnlyNew}" Style="{StaticResource ToggleSwitch}" />
                        </WrapPanel>
                    <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" Margin="0,12,0,0">
                        <Border Style="{StaticResource InnerCard}" Padding="16">
                            <StackPanel>
                            <Border Style="{StaticResource SkeletonBar}" Width="420" Margin="0,6,0,0" />
                            <Border Style="{StaticResource SkeletonBar}" Width="320" Margin="0,6,0,0" />
                            <Border Style="{StaticResource SkeletonBar}" Width="260" Margin="0,6,0,0" />
                            <Border Style="{StaticResource SkeletonBar}" Width="380" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="620" Margin="0,14,0,0">
                            <ItemsControl ItemsSource="{Binding Versions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource InnerCard}" Padding="12" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="42" Height="42" CornerRadius="11" Background="{DynamicResource ChipBrush}">
                                                    <TextBlock Text="{Binding TypeGlyph}" FontFamily="{StaticResource IconFont}" FontSize="17"
                                                               Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Id}" FontWeight="SemiBold" FontSize="14" />
                                                        <Border Style="{StaticResource Pill}"><TextBlock Text="{Binding TypeLabel}" FontSize="10" FontWeight="SemiBold" /></Border>
                                                        <Border Style="{StaticResource Pill}" Margin="6,0,0,0"><TextBlock Text="{Binding ProfileTypeLabel}" FontSize="10" /></Border>
                                                    </StackPanel>
                                                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0">
                                                        <Run Text="{Binding DateLabel, Mode=OneWay}" />
                                                        <Run Text=" · " />
                                                        <Run Text="{Binding StatusLabel, Mode=OneWay}" />
                                                        <Run Text=" · " />
                                                        <Run Text="{Binding ProfileSummary, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="INSTALAR" Style="{StaticResource SecondaryButton}" FontSize="11" Margin="0,0,6,0"
                                                            Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                            Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                                    <Button Content="JUGAR" Style="{StaticResource PrimaryButton}" FontSize="11" Margin="0,0,6,0"
                                                            Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                            Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}" />
                                                    <Button Content="CONFIGURAR" Style="{StaticResource GhostButton}" FontSize="11" Margin="0,0,6,0"
                                                            Command="{Binding DataContext.ConfigureCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                                    <Button Content="ELIMINAR" Style="{StaticResource DangerButton}" FontSize="11"
                                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                            Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}" />
                                                    <Button Content="MODS" Style="{StaticResource GhostButton}" FontSize="10" Margin="0,0,6,0"
                                                            Command="{Binding DataContext.ModDownloadCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                            Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Border Style="{StaticResource InnerCard}" Padding="24"
                                Visibility="{Binding HasVersions, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="26"
                                           Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="Ninguna versión coincide" Style="{StaticResource CardTitle}" HorizontalAlignment="Center" Margin="0,10,0,0" />
                                <TextBlock Text="Cambia el filtro o pulsa Actualizar." Style="{StaticResource Muted}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Style="{StaticResource Card}" Width="420" Margin="20,0,0,0" Padding="20" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="LAUNCH &amp; PERFIL" Style="{StaticResource SectionTitle}" />
                    <Border Style="{StaticResource InnerCard}" Padding="14" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedVersionLabel}" Style="{StaticResource CardTitle}" FontSize="24" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding SelectedProfileSummary}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="MEMORIA" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding MemoryLabel}" FontWeight="SemiBold" /></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="VERSION" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding SelectedVersionLabel}" FontWeight="SemiBold" /></StackPanel>
                            </Grid>
                            <Slider Minimum="1024" Maximum="32768" TickFrequency="1024" IsSnapToTickEnabled="True" Value="{Binding MemoryMb, Mode=TwoWay}" Margin="0,8,0,0" />
                            <Button Style="{StaticResource PrimaryButton}" Height="50" Content="JUGAR"
                                    Command="{Binding PrimaryCommand}" Margin="0,12,0,0" />
                            <Button Style="{StaticResource SecondaryButton}" Height="50" Content="Detectar Java"
                                    Command="{Binding DetectJavaCommand}" Margin="6,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource InnerCard}" Padding="14" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="MODLOADER" Style="{StaticResource StatLabel}" />
                            <ComboBox ItemsSource="{Binding ModLoaderOptions}" SelectedItem="{Binding ModLoader}" Margin="0,6,0,0" />
                            <Button Content="Descargar mods" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding ModDownloadCommand}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource InnerCard}" Padding="14" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="RUTA DE JAVA" Style="{StaticResource StatLabel}" />
                            <TextBox Style="{StaticResource InputTextBox}" Text="{Binding JavaPath}" Margin="0,6,0,0" />
                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="Elegir" Style="{StaticResource GhostButton}" Margin="0,0,6,6" Command="{Binding BrowseJavaCommand}" />
                                <Button Content="Detectar" Style="{StaticResource GhostButton}" Margin="0,0,6,6" Command="{Binding DetectJavaCommand}" />
                                <Button Content="Automático" Style="{StaticResource GhostButton}" Margin="0,0,0,6" Command="{Binding ResetJavaPathCommand}" />
                            </WrapPanel>
                            <TextBlock Text="{Binding JavaPathHint}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding JavaInfo}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource InnerCard}" Padding="14" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="CARPETA DE PARTIDAS" Style="{StaticResource StatLabel}" />
                            <TextBox Style="{StaticResource InputTextBox}" Text="{Binding GameDirectory}" Margin="0,6,0,0" />
                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="Elegir carpeta" Style="{StaticResource GhostButton}" Margin="0,0,6,6" Command="{Binding BrowseGameFolderCommand}" />
                                <Button Content="Abrir partidas" Style="{StaticResource GhostButton}" Margin="0,0,6,6" Command="{Binding OpenProfileSavesCommand}" />
                                <Button Content="Abrir mods" Style="{StaticResource GhostButton}" Margin="0,0,0,6" Command="{Binding OpenProfileModsCommand}" />
                            </WrapPanel>
                            <TextBlock Text="{Binding GameDirectoryHint}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource InnerCard}" Padding="14" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="PERMISOS Y LOGS" Style="{StaticResource StatLabel}" />
                            <Button Content="Abrir workspace" Style="{StaticResource GhostButton}" Margin="0,6,0,0" Command="{Binding OpenWorkspaceFolderCommand}" />
                            <Button Content="Abrir registros" Style="{StaticResource GhostButton}" Margin="0,0,0,6" Command="{Binding OpenWorkspaceLogsCommand}" />
                            <TextBlock Text="{Binding PremiumStatus}" Style="{StaticResource Caption}" Margin="6,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
