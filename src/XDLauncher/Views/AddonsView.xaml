<UserControl x:Class="XdLauncher.Views.AddonsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True"
             DragOver="UserControl_DragOver"
             Drop="UserControl_Drop">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,6,28">

            <Border Style="{StaticResource Card}" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Explorador de complementos" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Addons, texturas, paquetes de comportamiento, skins, mapas y plantillas instalados o guardados en tu biblioteca."
                                   Style="{StaticResource Muted}" Margin="0,4,0,0" MaxWidth="650" HorizontalAlignment="Left" />

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="210" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Margin="0,0,10,0">
                                <TextBox x:Name="SearchBox" Style="{StaticResource InputTextBox}"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="34,9,12,9" />
                                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="12,0,0,0"
                                           VerticalAlignment="Center" IsHitTestVisible="False" />
                                <TextBlock Text="Buscar por nombre o categoría" Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center" Margin="34,0,0,0" IsHitTestVisible="False"
                                           FontSize="12"
                                           Visibility="{Binding SearchText, Converter={StaticResource StringToVisibility}, ConverterParameter=invert}" />
                            </Grid>

                            <ComboBox Grid.Column="1" Margin="0,0,10,0" ItemsSource="{Binding Categories}"
                                      SelectedItem="{Binding SelectedCategory}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="2" Content="Importar" Style="{StaticResource PrimaryButton}"
                                    Margin="0,0,8,0" Command="{Binding ImportCommand}" />
                            <Button Grid.Column="3" Content="Añadir a biblioteca" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding AddToLibraryCommand}" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="20,0,0,0">
                        <Button Content="&#xE72C;  Actualizar" Style="{StaticResource GhostButton}"
                                Command="{Binding RefreshCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Margin="0,14,0,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding CountLabel}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                    <Border Width="1" Height="12" Background="{DynamicResource BorderBrush}" Margin="10,0" />
                    <TextBlock Text="{Binding FilterSummary}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Abrir carpeta del juego" Style="{StaticResource GhostButton}"
                            Command="{Binding OpenGameFolderCommand}" />
                    <Button Content="Abrir biblioteca" Style="{StaticResource GhostButton}" Margin="4,0,0,0"
                            Command="{Binding OpenLibraryCommand}" />
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource Card}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center" Margin="20">
                    <Border Width="64" Height="64" CornerRadius="18" Background="{DynamicResource ChipBrush}"
                            HorizontalAlignment="Center">
                        <TextBlock Text="&#xE7B8;" FontFamily="{StaticResource IconFont}" FontSize="26"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Todavía no hay complementos" Style="{StaticResource SectionTitle}"
                               HorizontalAlignment="Center" Margin="0,14,0,0" />
                    <TextBlock Text="Importa un archivo .mcpack, .mcaddon, .mcworld o .mctemplate, o arrástralo a esta ventana. También puedes añadir archivos a tu biblioteca sin instalarlos."
                               Style="{StaticResource Muted}" HorizontalAlignment="Center" TextAlignment="Center"
                               MaxWidth="520" Margin="0,6,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                        <Button Content="Importar complemento" Style="{StaticResource PrimaryButton}"
                                Command="{Binding ImportCommand}" />
                        <Button Content="Añadir a biblioteca" Style="{StaticResource SecondaryButton}"
                                Margin="10,0,0,0" Command="{Binding AddToLibraryCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding VisibleItems}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Width="318" Height="286" Padding="16" Margin="0,0,12,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Border Width="54" Height="54" CornerRadius="14" Background="{DynamicResource ChipBrush}"
                                            HorizontalAlignment="Left">
                                        <Grid>
                                            <TextBlock Text="&#xE7B8;" FontFamily="{StaticResource IconFont}" FontSize="20"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Border CornerRadius="14">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding IconPath, Converter={StaticResource ImagePath}}"
                                                                Stretch="UniformToFill" />
                                                </Border.Background>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <StackPanel HorizontalAlignment="Right">
                                        <Border Style="{StaticResource Pill}" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding CategoryLabel}" FontSize="10" FontWeight="SemiBold" />
                                        </Border>
                                        <TextBlock Text="{Binding OriginLabel}" Style="{StaticResource Caption}"
                                                   HorizontalAlignment="Right" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Grid.Row="1" Margin="0,12,0,0">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitle}"
                                               TextTrimming="CharacterEllipsis" MaxHeight="40" />
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <TextBlock Text="{Binding Version, StringFormat='v{0}'}" Style="{StaticResource Caption}" />
                                        <TextBlock Text="·" Style="{StaticResource Caption}" Margin="6,0" />
                                        <TextBlock Text="{Binding ExtraInfo}" Style="{StaticResource Caption}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Grid.Row="2" Text="{Binding Description}" Style="{StaticResource Muted}"
                                           Margin="0,8,0,0" MaxHeight="52" TextTrimming="CharacterEllipsis" />

                                <Grid Grid.Row="3" Margin="0,10,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Abrir" Style="{StaticResource SecondaryButton}" Padding="12,6"
                                                FontSize="11" Command="{Binding DataContext.OpenItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="Instalar" Style="{StaticResource PrimaryButton}" Padding="12,6"
                                                FontSize="11" Margin="6,0,0,0"
                                                Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"
                                                Command="{Binding DataContext.InstallItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                    <Button Content="&#xE74D;" Style="{StaticResource IconButton}" Width="30" Height="30"
                                            HorizontalAlignment="Right" Foreground="{DynamicResource ErrorBrush}"
                                            ToolTip="Eliminar"
                                            Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource InnerCard}" Margin="0,4,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="14"
                               Foreground="{DynamicResource InfoBrush}" VerticalAlignment="Top" Margin="0,1,10,0" />
                    <TextBlock Style="{StaticResource Muted}" MaxWidth="900" HorizontalAlignment="Left"
                               Text="La importación se realiza en las carpetas oficiales com.mojang que Minecraft lee. Se validan rutas ZIP, tamaños, manifiestos y UUID duplicados. El launcher no descarga complementos de Internet ni modifica archivos del juego." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
