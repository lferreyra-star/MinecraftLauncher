<UserControl x:Class="XdLauncher.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="0,0,6,28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <StackPanel Margin="0,0,8,0">

                <!-- Appearance -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="40" Height="40" CornerRadius="11" Background="{DynamicResource ChipBrush}">
                                <TextBlock Text="&#xE790;" FontFamily="{StaticResource IconFont}" FontSize="17"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Apariencia" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Tema, color de acento, fondo y escala de la interfaz." Style="{StaticResource Muted}" />
                            </StackPanel>
                        </StackPanel>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="210" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Height="122" CornerRadius="12" Background="{DynamicResource ChipBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Border CornerRadius="12">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding State.BackgroundPath, Converter={StaticResource ImagePath}}"
                                                        Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                    <Border CornerRadius="12">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#00000000" Offset="0" />
                                                <GradientStop Color="#BB000000" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <TextBlock Text="Vista previa del fondo" Foreground="#E9FFF1" FontSize="10"
                                               FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="10" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="18,0,0,0">
                                <TextBlock Text="TEMA" Style="{StaticResource Caption}" />
                                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                    <RadioButton Content="Oscuro" Style="{StaticResource SegmentRadio}"
                                                 GroupName="Theme" IsChecked="{Binding State.IsDarkTheme, Mode=TwoWay}" />
                                    <RadioButton Content="Claro" Style="{StaticResource SegmentRadio}" Margin="8,0,0,0"
                                                 GroupName="Theme" IsChecked="{Binding State.IsLightTheme, Mode=TwoWay}" />
                                </StackPanel>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="COLOR DE ACENTO" Style="{StaticResource Caption}" />
                                        <ComboBox Margin="0,6,0,0" ItemsSource="{Binding State.Accents}"
                                                  SelectedValuePath="Name" SelectedValue="{Binding State.Accent}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="FONDO" Style="{StaticResource Caption}" />
                                        <ComboBox Margin="0,6,0,0" ItemsSource="{Binding State.Backgrounds}"
                                                  SelectedItem="{Binding State.SelectedBackground}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <Button Content="Elegir imagen personalizada…" Style="{StaticResource GhostButton}"
                                        HorizontalAlignment="Left" Padding="0,6,0,0" Margin="0,6,0,0"
                                        Command="{Binding State.AddBackgroundCommand}" />
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource Divider}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="TAMAÑO DE VENTANA" Style="{StaticResource Caption}" />
                                <ComboBox Margin="0,6,0,0" ItemsSource="{Binding State.WindowSizes}"
                                          SelectedValuePath="Label" SelectedValue="{Binding State.WindowSizeLabel}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Label}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <Grid>
                                    <TextBlock Text="ESCALA DE INTERFAZ" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding State.UiScaleLabel}" Style="{StaticResource Caption}"
                                               HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Grid>
                                <Slider Margin="0,8,0,0" Minimum="0.85" Maximum="1.15" TickFrequency="0.05"
                                        IsSnapToTickEnabled="True" Value="{Binding State.UiScale}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Behavior -->
                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="40" Height="40" CornerRadius="11" Background="{DynamicResource ChipBrush}">
                                <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" FontSize="17"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Inicio y comportamiento" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Acciones del launcher al iniciar Minecraft." Style="{StaticResource Muted}" />
                            </StackPanel>
                        </StackPanel>

                        <Grid Margin="0,16,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,16,12">
                                <TextBlock Text="Verificar antes de iniciar" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="Comprueba paquete, firma y componentes oficiales antes de jugar." Style="{StaticResource Caption}" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                      IsChecked="{Binding State.VerifyBeforeLaunch}" />

                            <StackPanel Grid.Row="1" Margin="0,0,16,12">
                                <TextBlock Text="Minimizar al jugar" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="Reduce el launcher para dejar el juego en primer plano." Style="{StaticResource Caption}" />
                            </StackPanel>
                            <CheckBox Grid.Row="1" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                      IsChecked="{Binding State.MinimizeOnLaunch}" />

                            <StackPanel Grid.Row="2" Margin="0,0,16,12">
                                <TextBlock Text="Cerrar el launcher al jugar" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="Libera memoria cerrando la interfaz después de iniciar el juego." Style="{StaticResource Caption}" />
                            </StackPanel>
                            <CheckBox Grid.Row="2" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                      IsChecked="{Binding State.CloseOnLaunch}" />

                            <StackPanel Grid.Row="3" Margin="0,0,16,12">
                                <TextBlock Text="Comprobar actualizaciones al abrir" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="Consulta la fecha oficial del catálogo de Microsoft Store." Style="{StaticResource Caption}" />
                            </StackPanel>
                            <CheckBox Grid.Row="3" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                      IsChecked="{Binding State.AutoCheckUpdates}" />

                            <StackPanel Grid.Row="4" Margin="0,0,16,12">
                                <TextBlock Text="Mostrar novedades" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="Muestra información oficial en el inicio." Style="{StaticResource Caption}" />
                            </StackPanel>
                            <CheckBox Grid.Row="4" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                      IsChecked="{Binding State.ShowNews}" />

                            <StackPanel Grid.Row="5" Margin="0,0,16,0">
                                <TextBlock Text="Iniciar con Windows" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="Registra el launcher en el inicio de sesión del usuario actual." Style="{StaticResource Caption}" />
                            </StackPanel>
                            <CheckBox Grid.Row="5" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                      IsChecked="{Binding State.StartWithWindows}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Account -->
                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="40" Height="40" CornerRadius="11" Background="{DynamicResource ChipBrush}">
                                <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="17"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Cuenta y perfil" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Perfil local del launcher o cuenta Microsoft con Xbox Live." Style="{StaticResource Muted}" />
                            </StackPanel>
                        </StackPanel>

                        <Border Style="{StaticResource InnerCard}" Margin="0,16,0,0"
                                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="46" Height="46">
                                    <Border CornerRadius="23" Background="{DynamicResource AccentSoftBrush}" />
                                    <TextBlock Text="{Binding AccountInitial}" FontWeight="Bold" FontSize="18"
                                               Foreground="{DynamicResource AccentLightBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Border CornerRadius="23">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding AccountAvatarPath, Converter={StaticResource ImagePath}}"
                                                        Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding AccountDisplayName}" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock Text="{Binding AccountEmail}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding AccountProviderLabel}" Style="{StaticResource Caption}"
                                               Margin="0,2,0,0" Foreground="{DynamicResource AccentLightBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Cerrar sesión" Style="{StaticResource SecondaryButton}" Padding="14,8"
                                            Command="{Binding DataContext.SignOutCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource InnerCard}" Margin="0,16,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="46" Height="46">
                                    <Border CornerRadius="23" Background="{DynamicResource AccentSoftBrush}" />
                                    <TextBlock Text="{Binding Profile.Initial}" FontWeight="Bold" FontSize="18"
                                               Foreground="{DynamicResource AccentLightBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Border CornerRadius="23">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding Profile.AvatarPath, Converter={StaticResource ImagePath}}"
                                                        Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Profile.DisplayName}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Profile.AccountTypeLabel}" Style="{StaticResource Caption}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="{Binding Profile.SignInLabel}" Style="{StaticResource PrimaryButton}"
                                            Padding="14,8" Command="{Binding Profile.SignInCommand}"
                                            Visibility="{Binding Profile.IsMicrosoftAccount, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                    <Button Content="Cerrar sesión" Style="{StaticResource SecondaryButton}" Padding="14,8"
                                            Command="{Binding Profile.SignOutCommand}"
                                            Visibility="{Binding Profile.IsMicrosoftAccount, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Content="Usar perfil local" Style="{StaticResource GhostButton}" Margin="6,0,0,0"
                                            Command="{Binding Profile.UseLocalCommand}"
                                            Visibility="{Binding Profile.IsMicrosoftAccount, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="NOMBRE DEL PERFIL LOCAL" Style="{StaticResource Caption}" />
                                <TextBox Style="{StaticResource InputTextBox}" Margin="0,6,0,0"
                                         Text="{Binding State.LocalProfileName, UpdateSourceTrigger=LostFocus}" MaxLength="32" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Cambiar avatar" Style="{StaticResource SecondaryButton}"
                                    VerticalAlignment="Bottom" Command="{Binding Profile.PickAvatarCommand}" />
                        </Grid>

                        <Border Style="{StaticResource Divider}" />

                        <TextBlock Text="MICROSOFT ENTRA · CLIENT ID PÚBLICO" Style="{StaticResource Caption}" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource InputTextBox}" Margin="0,0,8,0"
                                     Text="{Binding State.MicrosoftClientId, UpdateSourceTrigger=LostFocus}"
                                     ToolTip="Client ID de una aplicación pública registrada para XboxLive.signin" />
                            <Button Grid.Column="1" Content="Abrir Microsoft Entra" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding OpenAzureCommand}" />
                        </Grid>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" LineHeight="16"
                                   Text="El launcher no incluye credenciales de terceros. Registra una aplicación pública (cliente nativo) con permiso XboxLive.signin y pega aquí su Client ID. El inicio de sesión usa código de dispositivo; nunca se solicitan contraseñas y el token se guarda cifrado con DPAPI." />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Right column -->
            <StackPanel Grid.Column="1" Margin="8,0,0,0">

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="40" Height="40" CornerRadius="11" Background="{DynamicResource ChipBrush}">
                                <TextBlock Text="&#xE770;" FontFamily="{StaticResource IconFont}" FontSize="17"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Sistema" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Información del equipo y diagnóstico." Style="{StaticResource Muted}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Margin="0,16,0,0">
                            <TextBlock Text="PROCESADOR" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding State.SystemInfo.CpuName}" FontSize="12" Margin="0,3,0,10" />

                            <TextBlock Text="GRÁFICOS" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding State.SystemInfo.GpuName}" FontSize="12" Margin="0,3,0,10" />

                            <TextBlock Text="MEMORIA" Style="{StaticResource Caption}" />
                            <TextBlock FontSize="12" Margin="0,3,0,10">
                                <Run Text="{Binding State.SystemInfo.TotalRamText, Mode=OneWay}" />
                                <Run Text=" · " />
                                <Run Text="{Binding State.SystemInfo.RamUsageText, Mode=OneWay}" />
                            </TextBlock>

                            <TextBlock Text="WINDOWS" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding State.SystemInfo.WindowsName}" FontSize="12" Margin="0,3,0,10" />

                            <TextBlock Text="LAUNCHER EN MEMORIA" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding State.LauncherMemoryText}" FontSize="12" Margin="0,3,0,0" />
                        </StackPanel>

                        <Border Style="{StaticResource Divider}" />
                        <WrapPanel>
                            <Button Content="Actualizar datos" Style="{StaticResource GhostButton}" Margin="0,0,4,4"
                                    Command="{Binding RefreshInfoCommand}" />
                            <Button Content="Abrir registros" Style="{StaticResource GhostButton}" Margin="0,0,4,4"
                                    Command="{Binding OpenLogsCommand}" />
                            <Button Content="Copiar diagnóstico" Style="{StaticResource GhostButton}" Margin="0,0,4,4"
                                    Command="{Binding CopyDiagnosticsCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="Acerca de" Style="{StaticResource SectionTitle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Border Width="54" Height="54" CornerRadius="14" Background="{DynamicResource ChipBrush}">
                                <Image Source="/Assets/logo.png" Stretch="Uniform" Margin="8" />
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding LauncherVersion, StringFormat='Versión {0}'}" Style="{StaticResource Caption}"
                                           Margin="0,2,0,0" />
                                <TextBlock Text="{Binding RuntimeLabel}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Style="{StaticResource Muted}" Margin="0,14,0,0" LineHeight="18"
                                   Text="Launcher de escritorio no oficial para Minecraft Bedrock Edition. No está afiliado a Mojang Studios ni Microsoft. Minecraft es una marca de Mojang Synergies AB." />

                        <Border Style="{StaticResource Divider}" />
                        <WrapPanel>
                            <Button Content="Sitio oficial" Style="{StaticResource GhostButton}" Margin="0,0,4,4"
                                    Command="{Binding OpenWebsiteCommand}" />
                            <Button Content="Abrir README" Style="{StaticResource GhostButton}" Margin="0,0,4,4"
                                    Command="{Binding OpenReadmeCommand}" />
                            <Button Content="Restablecer ajustes" Style="{StaticResource GhostButton}" Margin="0,0,4,4"
                                    Foreground="{DynamicResource ErrorBrush}" Command="{Binding State.ResetCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource InnerCard}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="Seguridad y privacidad" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,5,0,0" LineHeight="17"
                                   Text="No se recopilan datos personales. No se guardan contraseñas. Los tokens de Microsoft se cifran con DPAPI para el usuario actual. El launcher solo usa APIs oficiales de Windows y Microsoft." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
