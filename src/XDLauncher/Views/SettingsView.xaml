<UserControl x:Class="XdLauncher.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:XdLauncher.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="900" d:DesignWidth="1100">
    <UserControl.Resources>

        <Style x:Key="SettingsPanel" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
        <Style x:Key="SettingsPanelAccount" TargetType="Border" BasedOn="{StaticResource SettingsPanel}">
            <Style.Triggers><DataTrigger Binding="{Binding SelectedCategory}" Value="account"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
        </Style>

        <Style x:Key="SettingsPanelAppearance" TargetType="Border" BasedOn="{StaticResource SettingsPanel}">
            <Style.Triggers><DataTrigger Binding="{Binding SelectedCategory}" Value="appearance"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
        </Style>

        <Style x:Key="SettingsPanelThemes" TargetType="Border" BasedOn="{StaticResource SettingsPanel}">
            <Style.Triggers><DataTrigger Binding="{Binding SelectedCategory}" Value="themes"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
        </Style>

        <Style x:Key="SettingsPanelBackgrounds" TargetType="Border" BasedOn="{StaticResource SettingsPanel}">
            <Style.Triggers><DataTrigger Binding="{Binding SelectedCategory}" Value="backgrounds"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
        </Style>

        <Style x:Key="SettingsPanelMotion" TargetType="Border" BasedOn="{StaticResource SettingsPanel}">
            <Style.Triggers><DataTrigger Binding="{Binding SelectedCategory}" Value="motion"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
        </Style>

        <Style x:Key="SettingsPanelInterface" TargetType="Border" BasedOn="{StaticResource SettingsPanel}">
            <Style.Triggers><DataTrigger Binding="{Binding SelectedCategory}" Value="interface"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
        </Style>

        <Style x:Key="SettingsPanelMinecraft" TargetType="Border" BasedOn="{StaticResource SettingsPanel}">
            <Style.Triggers><DataTrigger Binding="{Binding SelectedCategory}" Value="minecraft"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
        </Style>

        <Style x:Key="SettingsPanelJava" TargetType="Border" BasedOn="{StaticResource SettingsPanel}">
            <Style.Triggers><DataTrigger Binding="{Binding SelectedCategory}" Value="java"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
        </Style>

        <Style x:Key="SettingsPanelDownloads" TargetType="Border" BasedOn="{StaticResource SettingsPanel}">
            <Style.Triggers><DataTrigger Binding="{Binding SelectedCategory}" Value="downloads"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
        </Style>

        <Style x:Key="SettingsPanelPerformance" TargetType="Border" BasedOn="{StaticResource SettingsPanel}">
            <Style.Triggers><DataTrigger Binding="{Binding SelectedCategory}" Value="performance"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
        </Style>

        <Style x:Key="SettingsPanelSystem" TargetType="Border" BasedOn="{StaticResource SettingsPanel}">
            <Style.Triggers><DataTrigger Binding="{Binding SelectedCategory}" Value="system"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
        </Style>

        <Style x:Key="SettingsPanelDiagnostics" TargetType="Border" BasedOn="{StaticResource SettingsPanel}">
            <Style.Triggers><DataTrigger Binding="{Binding SelectedCategory}" Value="diagnostics"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
        </Style>

        <Style x:Key="SettingsPanelPrivacy" TargetType="Border" BasedOn="{StaticResource SettingsPanel}">
            <Style.Triggers><DataTrigger Binding="{Binding SelectedCategory}" Value="privacy"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
        </Style>

        <Style x:Key="SettingsPanelAbout" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedCategory}" Value="about"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,4,24">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="AJUSTES" Style="{StaticResource Kicker}" />
                    <TextBlock Text="Configura identidad, apariencia, juego y sistema sin salir del launcher."
                               Style="{StaticResource PageTitle}" FontSize="26" TextWrapping="Wrap" MaxWidth="900" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="14">
                <ItemsControl ItemsSource="{Binding Categories}" BorderThickness="0" Background="Transparent" Margin="0">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource TextButton}" Content="{Binding Title}" Width="Auto"
                                    Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding Key}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <Border Style="{StaticResource SettingsPanelAccount}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="CUENTA Y PERFIL" Style="{StaticResource SectionTitle}" />
                    <Border Style="{StaticResource InnerCard}" Padding="16" Margin="0,14,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Grid Width="56" Height="56" Background="{DynamicResource AccentGlowBrush}">
                                    <TextBlock Text="{Binding AccountInitial}" FontSize="24" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentTextBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Ellipse Width="18" Height="18" Fill="{DynamicResource SuccessBrush}"
                                             Stroke="{DynamicResource WindowBackgroundBrush}" StrokeThickness="3"
                                             HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding AccountDisplayName}" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding AccountEmail}" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding AccountProviderLabel}" Style="{StaticResource Caption}"
                                               Foreground="{DynamicResource AccentLightBrush}" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="Cerrar sesión" Style="{StaticResource DangerButton}"
                                        Command="{Binding DataContext.SignOutCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource InnerCard}" Padding="14" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="NOMBRE LOCAL" Style="{StaticResource Caption}" />
                                <TextBox Style="{StaticResource InputTextBox}" Margin="0,8,0,0" Text="{Binding State.LocalProfileName, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock Text="AVATAR" Style="{StaticResource Caption}" />
                                <Button Content="{StaticResource IconGlyph}" Style="{StaticResource CardButton}" Padding="8" Margin="0,8,0,0"
                                        Command="{Binding Profile.PickAvatarCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsPanelAppearance}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="APARIENCIA" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Diez temas completos: superficies, bordes, textos, glows y fondos cambian a la vez."
                               Style="{StaticResource Caption}" Margin="0,4,0,0" />

                    <Border Style="{StaticResource InnerCard}" Padding="16" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="TEMA VISUAL" Style="{StaticResource Kicker}" />
                            <ListBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding State.Theme, Mode=TwoWay}"
                                     Background="Transparent" BorderThickness="0" Margin="0,10,0,0">
                                <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Margin" Value="0,0,10,10" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Chrome" Width="150" Height="56" CornerRadius="12"
                                                            Background="{DynamicResource ChipBrush}" BorderThickness="1"
                                                            BorderBrush="{DynamicResource BorderSoftBrush}" Padding="12,8">
                                                        <StackPanel>
                                                            <Border Height="3" CornerRadius="2" Background="{DynamicResource AccentGradientBrush}" />
                                                            <TextBlock Text="{Binding}" FontWeight="SemiBold" FontSize="11.5" Margin="0,7,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource InnerCard}" Padding="16" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="ILUMINACIÓN Y PROFUNDIDAD" Style="{StaticResource Kicker}" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Intensidad ambiental" VerticalAlignment="Center" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                        Value="{Binding State.AmbientIntensity, Mode=TwoWay}" Margin="14,0" />
                                <TextBlock Grid.Column="2" Text="{Binding State.AmbientIntensity, StringFormat={}{0:P0}}" Foreground="{DynamicResource AccentBrush}" />
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Transparencia" VerticalAlignment="Center" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                        Value="{Binding State.TransparencyLevel, Mode=TwoWay}" Margin="14,0" />
                                <TextBlock Grid.Column="2" Text="{Binding State.TransparencyLevel, StringFormat={}{0:P0}}" Foreground="{DynamicResource AccentBrush}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource InnerCard}" Padding="16" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="EFECTOS" Style="{StaticResource Kicker}" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Animaciones de interfaz" Style="{StaticResource BodyText}" />
                            <TextBlock Text="Fundidos, entradas y microinteracciones." Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding State.AnimationsEnabled, Mode=TwoWay}" />
                    </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsPanelThemes}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="TEMAS Y ACENTOS" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Selecciona un tema en Apariencia y después ajusta el color de acento aquí."
                               Style="{StaticResource Caption}" Margin="0,4,0,0" />
                    <TextBlock Text="Paletas ac TECHF: verde Elite, esmeralda, Lima FÁRbnb, Cian, ocean" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                    <ListBox Margin="0,14,0,0" ItemsSource="{Binding State.Accents}"
                             SelectedValuePath="Name" SelectedValue="{Binding State.Accent, Mode=TwoWay}"
                             BorderThickness="0" Background="Transparent">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,0,10,10" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Grid Width="132" Height="48">
                                                <Border x:Name="Ring" CornerRadius="14" BorderThickness="2" BorderBrush="Transparent">
                                                    <Grid><Border x:Name="Swatch" CornerRadius="11" Margin="4" Background="{Binding Hex}" /></Grid>
                                                </Border>
                                                <TextBlock x:Name="AccentName" Text="{Binding Name}" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="BorderBrush" Value="#88FFFFFF" /></Trigger>
                                                <Trigger Property="IsSelected" Value="True"><Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <Border Style="{StaticResource InnerCard}" Margin="0,16,0,0">
                        <Grid>
                            <TextBlock Text="COLOR PERSONALIZADO" Style="{StaticResource Caption}" />
                            <TextBox Style="{StaticResource InputTextBox}" Text="{Binding State.CustomAccentHex, UpdateSourceTrigger=LostFocus}"
                                     Margin="0,8,0,0" ToolTip="Ejemplo: #5CE07A" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsPanelBackgrounds}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="FONDOS" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Ambientes cinematicográficos del launcher." Style="{StaticResource Caption}" Margin="0,4,0,0" />
                    <ListBox Margin="0,14,0,0" ItemsSource="{Binding State.Backgrounds}"
                             SelectedItem="{Binding State.SelectedBackground, Mode=TwoWay}" BorderThickness="0"
                             Background="Transparent">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,0,12,12" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Ring" Width="188" Height="108" CornerRadius="14" BorderThickness="2" BorderBrush="Transparent" Padding="2">
                                                <Grid>
                                                    <Border CornerRadius="13">
                                                        <Border.Background>
                                                            <ImageBrush ImageSource="{Binding PreviewPath, Converter={StaticResource ImagePath}}" Stretch="UniformToFill" />
                                                        </Border.Background>
                                                    </Border>
                                                    <Border CornerRadius="13"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" Offset="0.3" /><GradientStop Color="#DD000000" Offset="1" /></LinearGradientBrush></Border.Background></Border>
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Caption}" Margin="0,0,10,8" />
                                                    <Border x:Name="Check" Width="22" Height="22" CornerRadius="11" Background="{DynamicResource AccentBrush}"
                                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6,6,0,0" Visibility="Collapsed">
                                                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                                                   Foreground="{DynamicResource TextInverseBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="BorderBrush" Value="#88FFFFFF" /></Trigger>
                                                <Trigger Property="IsSelected" Value="True"><Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter TargetName="Check" Property="Visibility" Value="Visible" /></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <Button Content="Importar imagen local" Style="{StaticResource PrimaryButton}" Margin="0,8,0,0"
                            Command="{Binding State.AddBackgroundCommand}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsPanelMotion}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="ANIMACIONES" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Controla cada efecto por separado. Todo se guarda al instante." Style="{StaticResource Caption}" Margin="0,4,0,0" />
                    <Border Style="{StaticResource InnerCard}" Padding="16" Margin="0,14,0,0">
                        <StackPanel>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Transiciones de navegación" Style="{StaticResource BodyText}" />
                            <TextBlock Text="Deslizamiento al cambiar de sección." Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding State.NavTransitionsEnabled, Mode=TwoWay}" />
                    </Grid>                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Partículas ambientales" Style="{StaticResource BodyText}" />
                            <TextBlock Text="Luces suspendidas en el fondo." Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding State.ParticleEffectsEnabled, Mode=TwoWay}" />
                    </Grid>                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Efectos hover" Style="{StaticResource BodyText}" />
                            <TextBlock Text="Elevación y brillo al pasar el cursor." Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding State.HoverEffectsEnabled, Mode=TwoWay}" />
                    </Grid>                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Parallax del fondo" Style="{StaticResource BodyText}" />
                            <TextBlock Text="Profundidad suave según el puntero." Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding State.ParallaxEnabled, Mode=TwoWay}" />
                    </Grid>                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Animaciones de tarjetas" Style="{StaticResource BodyText}" />
                            <TextBlock Text="Aparición escalonada del contenido." Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding State.CardAnimationsEnabled, Mode=TwoWay}" />
                    </Grid>                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Animaciones de carga" Style="{StaticResource BodyText}" />
                            <TextBlock Text="Skeletons y progreso animado." Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding State.LoadingAnimationsEnabled, Mode=TwoWay}" />
                    </Grid>                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Auras ambientales" Style="{StaticResource BodyText}" />
                            <TextBlock Text="Orbes luminosos en movimiento." Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding State.AmbientEffectsEnabled, Mode=TwoWay}" />
                    </Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource InnerCard}" Padding="16" Margin="0,12,0,0">
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Modo de alto rendimiento" Style="{StaticResource BodyText}" />
                            <TextBlock Text="Desactiva partículas, parallax y animaciones costosas." Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding State.PerformanceMode, Mode=TwoWay}" />
                    </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsPanelInterface}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="INTERFAZ" Style="{StaticResource SectionTitle}" />
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="TAMAÑO VENTANA" Style="{StaticResource Caption}" />
                            <ComboBox Margin="0,8,0,0" ItemsSource="{Binding State.WindowSizes}"
                                      SelectedValuePath="Label" SelectedValue="{Binding State.WindowSizeLabel}">
                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Text="ESCALA" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding State.UiScaleLabel}" Foreground="{DynamicResource AccentBrush}" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Mostrar novedades en el inicio" Style="{StaticResource Caption}" />
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding State.ShowNews, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsPanelMinecraft}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="MINECRAFT" Style="{StaticResource SectionTitle}" />
                    <Border Style="{StaticResource InnerCard}" Padding="16" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Canal preferente" Style="{StaticResource Caption}" />
                            <ComboBox ItemsSource="{Binding PreferredChannelOptions}" SelectedValue="{Binding State.PreferredChannel, Mode=TwoWay}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Verificar antes de iniciar"/>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding State.VerifyBeforeLaunch, Mode=TwoWay}" />
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Minimizar al jugar"/>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding State.MinimizeOnLaunch, Mode=TwoWay}" />
                    </Grid>
                    <Button Content="Abrir workspace Java" Style="{StaticResource SecondaryButton}" Margin="0,16,0,0" Command="{Binding OpenJavaWorkspaceCommand}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsPanelJava}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="JAVA EDITION" Style="{StaticResource SectionTitle}" />
                    <Border Style="{StaticResource InnerCard}" Padding="16" Margin="0,14,0,0">
                        <Grid>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="NOMBRE DEL JUGADOR" Style="{StaticResource Caption}" />
                                <TextBox Style="{StaticResource InputTextBox}" Margin="0,8,0,0" Text="{Binding State.JavaPlayerName, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock Text="MEMORIA" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding State.JavaMemoryMb, StringFormat='{}{0} MB'}" FontWeight="SemiBold" />
                                <Slider Minimum="1024" Maximum="32768" IsSnapToTickEnabled="True" TickFrequency="1024" Margin="0,6,0,0" Value="{Binding State.JavaMemoryMb, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource InnerCard}" Padding="16" Margin="0,12,0,0">
                        <Grid>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="RUTA DE JAVA" Style="{StaticResource Caption}" />
                                <TextBox Style="{StaticResource InputTextBox}" Margin="0,8,0,0" Text="{Binding State.JavaPath, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock Text="DIRECTORIO DEL JUEGO" Style="{StaticResource Caption}" />
                                <TextBox Style="{StaticResource InputTextBox}" Margin="0,8,0,0" Text="{Binding State.JavaGameDirectory, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsPanelDownloads}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="DESCARGAS" Style="{StaticResource SectionTitle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Abrir carpeta" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Command="{Binding OpenDownloadsFolderCommand}" />
                        <Button Content="Abrir centro de descargas" Style="{StaticResource PrimaryButton}" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="downloads" />
                    </StackPanel>
                    <TextBlock Text="Cache / Downloads y progreso en tiempo real" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsPanelPerformance}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="RENDIMIENTO" Style="{StaticResource SectionTitle}" />
                    <UniformGrid Columns="3" Margin="0,14,0,0">
                        <Border Style="{StaticResource StatTile}"><StackPanel><TextBlock Style="{StaticResource StatLabel}" Text="CPU" /><TextBlock Text="{Binding State.SystemInfo.CpuName}" FontSize="12" /></StackPanel></Border>
                        <Border Style="{StaticResource StatTile}"><StackPanel><TextBlock Style="{StaticResource StatLabel}" Text="GPU" /><TextBlock Text="{Binding State.SystemInfo.GpuName}" FontSize="12" /></StackPanel></Border>
                        <Border Style="{StaticResource StatTile}"><StackPanel><TextBlock Style="{StaticResource StatLabel}" Text="RAM" /><TextBlock Text="{Binding State.SystemInfo.TotalRamText}" FontWeight="SemiBold" /></StackPanel></Border>
                    </UniformGrid>
                    <TextBlock Text="{Binding State.LauncherMemoryText}" Style="{StaticResource StatValue}" Foreground="{DynamicResource AccentBrush}" Margin="0,12,0,0" />
                    <TextBlock Text="{Binding State.SystemInfo.WindowsName}" Style="{StaticResource Caption}" />
                    <WrapPanel Margin="0,12,0,0">
                        <Button Content="Actualizar datos" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Command="{Binding RefreshInfoCommand}" />
                        <Button Content="Gráficos" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Command="{Binding State.OpenGraphicsSettingsCommand}" />
                        <Button Content="Administrador de tareas" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Command="{Binding State.OpenTaskManagerCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsPanelSystem}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="SISTEMA" Style="{StaticResource SectionTitle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Iniciar con Windows" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Command="{Binding State.OpenStartupAppsCommand}" />
                        <Button Content="Abrir registros" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Command="{Binding State.OpenLogsFolderCommand}" />
                        <Button Content="Datos del launcher" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Command="{Binding OpenDataFolderCommand}" />
                    </StackPanel>
                    <WrapPanel Margin="0,12,0,0">
                        <Button Content="Limpiar caché" Style="{StaticResource DangerButton}" Margin="0,0,8,0" Command="{Binding State.ClearCacheCommand}" />
                        <Button Content="Actualizar manualmente" Style="{StaticResource SecondaryButton}" Margin="0,0,0,0" Command="{Binding State.RefreshSystemInfoCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsPanelDiagnostics}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="DIAGNÓSTICO" Style="{StaticResource SectionTitle}" />
                    <WrapPanel Margin="0,12,0,0">
                        <Button Content="Copiar diagnóstico" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Command="{Binding CopyDiagnosticsCommand}" />
                        <Button Content="Actualizar información" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Command="{Binding RefreshInfoCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsPanelPrivacy}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="PRIVACIDAD Y SECURIDAD" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="No se recopilan datos personales. Las contraseñas no se guardan en disco y los tokens se protegen con DPAPI para el usuario actual. Firebase y la cuenta de XD Launcher conservan su flujo de autenticación original."
                               Style="{StaticResource BodyText}" MaxWidth="900" />
                    <Button Content="Datos del launcher" Style="{StaticResource SecondaryButton}" Margin="0,12,0,0" Command="{Binding OpenDataFolderCommand}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsPanelAbout}" Margin="0,14,0,0">
                <views:AboutView />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
