<UserControl x:Class="XdLauncher.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:XdLauncher.Views"
             xmlns:local="clr-namespace:XdLauncher.Core"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="900" d:DesignWidth="1100">
    <UserControl.Resources>
        <local:PercentToGaugeOffsetConverter x:Key="GaugeOffset" />

        <Style x:Key="SettingsPanel" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="24" />
            <Setter Property="Effect" Value="{StaticResource PanelShadow}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
        <Style x:Key="SettingsSubCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="SettingsRow" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,0,0,12" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="SettingsScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder" Background="{DynamicResource GlassBorderBrush}" CornerRadius="4"
                                Opacity="0.55" Margin="2" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Opacity" Value="0.95" />
                                <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SettingsScrollThumb}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Width" Value="Auto" />
                                <Setter Property="Height" Value="8" />
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsPanelAccount" TargetType="Border" BasedOn="{StaticResource SettingsPanel}">
            <Style.Triggers><DataTrigger Binding="{Binding SelectedCategory}" Value="account"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
        </Style>

        <Style x:Key="SettingsPanelAppearance" TargetType="Border" BasedOn="{StaticResource SettingsPanel}">
            <Style.Triggers><DataTrigger Binding="{Binding SelectedCategory}" Value="appearance"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
        </Style>

        <Style x:Key="SettingsPanelThemes" TargetType="Border" BasedOn="{StaticResource SettingsPanel}">
            <Style.Triggers><DataTrigger Binding="{Binding SelectedCategory}" Value="themes"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
        </Style>

        <Style x:Key="SettingsPanelBackgrounds" TargetType="Border" BasedOn="{StaticResource SettingsPanel}">
            <Style.Triggers><DataTrigger Binding="{Binding SelectedCategory}" Value="backgrounds"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
        </Style>

        <Style x:Key="SettingsPanelMotion" TargetType="Border" BasedOn="{StaticResource SettingsPanel}">
            <Style.Triggers><DataTrigger Binding="{Binding SelectedCategory}" Value="motion"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
        </Style>

        <Style x:Key="SettingsPanelInterface" TargetType="Border" BasedOn="{StaticResource SettingsPanel}">
            <Style.Triggers><DataTrigger Binding="{Binding SelectedCategory}" Value="interface"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
        </Style>

        <Style x:Key="SettingsPanelMinecraft" TargetType="Border" BasedOn="{StaticResource SettingsPanel}">
            <Style.Triggers><DataTrigger Binding="{Binding SelectedCategory}" Value="minecraft"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
        </Style>

        <Style x:Key="SettingsPanelJava" TargetType="Border" BasedOn="{StaticResource SettingsPanel}">
            <Style.Triggers><DataTrigger Binding="{Binding SelectedCategory}" Value="java"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
        </Style>

        <Style x:Key="SettingsPanelDownloads" TargetType="Border" BasedOn="{StaticResource SettingsPanel}">
            <Style.Triggers><DataTrigger Binding="{Binding SelectedCategory}" Value="downloads"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
        </Style>

        <Style x:Key="SettingsPanelPerformance" TargetType="Border" BasedOn="{StaticResource SettingsPanel}">
            <Style.Triggers><DataTrigger Binding="{Binding SelectedCategory}" Value="performance"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
        </Style>

        <Style x:Key="SettingsPanelSystem" TargetType="Border" BasedOn="{StaticResource SettingsPanel}">
            <Style.Triggers><DataTrigger Binding="{Binding SelectedCategory}" Value="system"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
        </Style>

        <Style x:Key="SettingsPanelDiagnostics" TargetType="Border" BasedOn="{StaticResource SettingsPanel}">
            <Style.Triggers><DataTrigger Binding="{Binding SelectedCategory}" Value="diagnostics"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
        </Style>

        <Style x:Key="SettingsPanelPrivacy" TargetType="Border" BasedOn="{StaticResource SettingsPanel}">
            <Style.Triggers><DataTrigger Binding="{Binding SelectedCategory}" Value="privacy"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
        </Style>

        <Style x:Key="SettingsPanelAbout" TargetType="Border" BasedOn="{StaticResource SettingsPanel}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedCategory}" Value="about"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,4,32">
            <Border Height="224" CornerRadius="18" ClipToBounds="True" Margin="0,0,0,16"
                    BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1">
                <Grid>
                    <Grid.Background>
                        <ImageBrush ImageSource="pack://application:,,,/Assets/backgrounds/bg-fantastico.png" Stretch="UniformToFill" />
                    </Grid.Background>
                    <Border Style="{StaticResource HeroOverlay}" />
                    <Grid>
                        <StackPanel VerticalAlignment="Center" Margin="30,0,0,0" MaxWidth="760">
                            <Border Style="{StaticResource Badge}" HorizontalAlignment="Left">
                                <TextBlock Text="CENTRO DE CONTROL" FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentLightBrush}" />
                            </Border>
                            <TextBlock Text="Configura tu experiencia" Style="{StaticResource DisplayHero}"
                                       FontSize="34" Foreground="White" Margin="0,10,0,0" />
                            <TextBlock Text="Identidad, apariencia, mundo y sistema. Todo se aplica al instante y se conserva entre sesiones."
                                       Style="{StaticResource BodyText}" Foreground="#D9D3E8" MaxWidth="640" Margin="0,8,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Border Style="{StaticResource Pill}" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding State.Theme, StringFormat='Tema · {0}'}" FontSize="10" FontWeight="SemiBold" />
                                </Border>
                                <Border Style="{StaticResource Pill}" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding State.MotionLevelLabel, StringFormat='Movimiento · {0}'}" FontSize="10" FontWeight="SemiBold" />
                                </Border>
                                <Border Style="{StaticResource Pill}">
                                    <TextBlock Text="{Binding LauncherVersion, StringFormat='v{0}'}" FontSize="10" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <Border x:Name="SettingsHeroIcon" Width="92" Height="92" CornerRadius="26"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,40,0"
                                Background="{DynamicResource GlassStrongBrush}" BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1" RenderTransformOrigin="0.5,0.5" Effect="{DynamicResource AccentGlowEffect}">
                            <Border.RenderTransform><ScaleTransform x:Name="SettingsHeroIconScale" ScaleX="0.9" ScaleY="0.9" /></Border.RenderTransform>
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="38"
                                       Foreground="{DynamicResource AccentLightBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SettingsHeroIconScale" Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.6">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="SettingsHeroIconScale" Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.6">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Border CornerRadius="18" Padding="12" Margin="0,0,0,14" BorderThickness="0"
                    Background="{DynamicResource SurfaceBrush}" Effect="{StaticResource PanelShadow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="32" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="CategoryLeft" Grid.Column="0" Content="&#xE76B;" ToolTip="Categorías anteriores"
                            Style="{StaticResource GhostButton}" Width="30" Height="44" Padding="0" FontSize="14"
                            FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource AccentLightBrush}"
                            Click="CategoryLeft_Click" VerticalAlignment="Center" />

                    <ListBox x:Name="CategoryList" Grid.Column="1"
                             ItemsSource="{Binding Categories}" SelectedValuePath="Key"
                             SelectedValue="{Binding SelectedCategory, Mode=TwoWay}" BorderThickness="0"
                             Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,0,8,0" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Chrome" Width="164" Height="58" CornerRadius="14"
                                                    Background="{DynamicResource ChipBrush}" BorderThickness="1"
                                                    BorderBrush="{DynamicResource BorderSoftBrush}" Padding="10,8">
                                                <Grid>
                                                    <Border x:Name="AccentBar" Width="3" Height="28" CornerRadius="2"
                                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                                            Background="{DynamicResource AccentBrush}" Opacity="0" />
                                                    <TextBlock x:Name="Glyph" Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}"
                                                               FontSize="16" Foreground="{DynamicResource TextMutedBrush}"
                                                               HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                    <StackPanel Margin="32,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        <TextBlock Text="{Binding Description}" FontSize="9" Margin="0,2,0,0"
                                                                   Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>
                                                <Border.RenderTransformOrigin><Point X="0.5" Y="0.5" /></Border.RenderTransformOrigin>
                                                <Border.RenderTransform><ScaleTransform x:Name="ChipScale" ScaleX="1" ScaleY="1" /></Border.RenderTransform>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource AccentLightBrush}" />
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="ChipScale" Storyboard.TargetProperty="ScaleX"
                                                                                 To="1.03" Duration="0:0:0.16">
                                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetName="ChipScale" Storyboard.TargetProperty="ScaleY"
                                                                                 To="1.03" Duration="0:0:0.16">
                                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="ChipScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.16" />
                                                                <DoubleAnimation Storyboard.TargetName="ChipScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.16" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                    <Setter TargetName="AccentBar" Property="Opacity" Value="1" />
                                                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource AccentLightBrush}" />
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="ChipScale" Storyboard.TargetProperty="ScaleX"
                                                                                 From="0.96" To="1" Duration="0:0:0.18">
                                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetName="ChipScale" Storyboard.TargetProperty="ScaleY"
                                                                                 From="0.96" To="1" Duration="0:0:0.18">
                                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <Button x:Name="CategoryRight" Grid.Column="2" Content="&#xE76C;" ToolTip="Más categorías"
                            Style="{StaticResource GhostButton}" Width="30" Height="44" Padding="0" FontSize="14"
                            FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource AccentLightBrush}"
                            Click="CategoryRight_Click" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Grid x:Name="SettingsContentRoot">
            <Border Style="{StaticResource SettingsPanelAccount}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="CUENTA Y PERFIL" Style="{StaticResource SectionTitle}" />
                    <Border Style="{StaticResource SettingsSubCard}" Padding="16" Margin="0,14,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Grid Width="56" Height="56" Background="{DynamicResource AccentGlowBrush}">
                                    <TextBlock Text="{Binding AccountInitial}" FontSize="24" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentTextBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Ellipse Width="18" Height="18" Fill="{DynamicResource SuccessBrush}"
                                             Stroke="{DynamicResource WindowBackgroundBrush}" StrokeThickness="3"
                                             HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding AccountDisplayName}" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding AccountEmail}" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding AccountProviderLabel}" Style="{StaticResource Caption}"
                                               Foreground="{DynamicResource AccentLightBrush}" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="Cerrar sesión" Style="{StaticResource DangerButton}"
                                        Command="{Binding DataContext.SignOutCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SettingsSubCard}" Padding="14" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="NOMBRE LOCAL" Style="{StaticResource Caption}" />
                                <TextBox Style="{StaticResource InputTextBox}" Margin="0,8,0,0" Text="{Binding State.LocalProfileName, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock Text="AVATAR" Style="{StaticResource Caption}" />
                                <Button Content="&#xE13D;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{DynamicResource AccentBrush}" Style="{StaticResource CardButton}" Padding="8" Margin="0,8,0,0"
                                        Command="{Binding Profile.PickAvatarCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsPanelAppearance}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="APARIENCIA" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Diez temas completos: superficies, bordes, textos, glows y fondos cambian a la vez."
                               Style="{StaticResource Caption}" Margin="0,4,0,0" />

                    <Border Style="{StaticResource SettingsSubCard}" Padding="16" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="TEMA VISUAL" Style="{StaticResource Kicker}" />
                            <ListBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding State.Theme, Mode=TwoWay}"
                                     Background="Transparent" BorderThickness="0" Margin="0,10,0,0">
                                <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Margin" Value="0,0,10,10" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Chrome" Width="150" Height="56" CornerRadius="12"
                                                            Background="{DynamicResource ChipBrush}" BorderThickness="1"
                                                            BorderBrush="{DynamicResource BorderSoftBrush}" Padding="12,8">
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Border Width="30" Height="13" CornerRadius="3" Background="{DynamicResource AccentBrush}" Margin="0,0,4,0" />
                                                                <Border Width="30" Height="13" CornerRadius="3" Background="{DynamicResource SurfaceStrongBrush}" Margin="0,0,4,0" />
                                                                <Border Width="30" Height="13" CornerRadius="3" Background="{DynamicResource AccentSoftBrush}" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding}" FontWeight="SemiBold" FontSize="11.5" Margin="0,7,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsSubCard}" Padding="16" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="ILUMINACIÓN Y PROFUNDIDAD" Style="{StaticResource Kicker}" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Intensidad ambiental" VerticalAlignment="Center" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                        Value="{Binding State.AmbientIntensity, Mode=TwoWay}" Margin="14,0" />
                                <TextBlock Grid.Column="2" Text="{Binding State.AmbientIntensity, StringFormat={}{0:P0}}" Foreground="{DynamicResource AccentBrush}" />
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Transparencia" VerticalAlignment="Center" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                        Value="{Binding State.TransparencyLevel, Mode=TwoWay}" Margin="14,0" />
                                <TextBlock Grid.Column="2" Text="{Binding State.TransparencyLevel, StringFormat={}{0:P0}}" Foreground="{DynamicResource AccentBrush}" />
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Desenfoque del fondo" VerticalAlignment="Center" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="8" TickFrequency="0.5" IsSnapToTickEnabled="True"
                                        Value="{Binding State.BackgroundBlur, Mode=TwoWay}" Margin="14,0" />
                                <TextBlock Grid.Column="2" Text="{Binding State.BackgroundBlur, StringFormat={}{0:0.0} px}" Foreground="{DynamicResource AccentBrush}" />
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Intensidad del velo" VerticalAlignment="Center" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                        Value="{Binding State.BackgroundOverlayIntensity, Mode=TwoWay}" Margin="14,0" />
                                <TextBlock Grid.Column="2" Text="{Binding State.BackgroundOverlayIntensity, StringFormat={}{0:P0}}" Foreground="{DynamicResource AccentBrush}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsSubCard}" Padding="16" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="EFECTOS" Style="{StaticResource Kicker}" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Animaciones de interfaz" Style="{StaticResource BodyText}" />
                            <TextBlock Text="Fundidos, entradas y microinteracciones." Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding State.AnimationsEnabled, Mode=TwoWay}" />
                    </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsPanelThemes}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="TEMAS Y ACENTOS" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Selecciona un tema en Apariencia y después ajusta el color de acento aquí."
                               Style="{StaticResource Caption}" Margin="0,4,0,0" />
                    <ListBox Margin="0,14,0,0" ItemsSource="{Binding State.Accents}"
                             SelectedValuePath="Name" SelectedValue="{Binding State.Accent, Mode=TwoWay}"
                             BorderThickness="0" Background="Transparent">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,0,10,10" />
