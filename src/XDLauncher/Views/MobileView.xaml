<UserControl x:Class="XdLauncher.Views.MobileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:XdLauncher.Views.Controls">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left: controls -->
        <Grid Margin="0,0,14,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="11" Background="{DynamicResource ChipBrush}">
                            <TextBlock Text="&#xE8EA;" FontFamily="{StaticResource IconFont}" FontSize="17"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="MINECRAFT MOBILE CONNECT" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Juega al Minecraft del teléfono con teclado y ratón" Style="{StaticResource Muted}" />
                        </StackPanel>
                    </StackPanel>

                    <Border Style="{StaticResource InnerCard}" Margin="0,16,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="DISPOSITIVO" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold" FontSize="14" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding DeviceDetails}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1" Style="{StaticResource Pill}" VerticalAlignment="Top">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                                   Foreground="{DynamicResource AccentBrush}" Margin="0,1,6,0" />
                                        <TextBlock Text="{Binding StatusLabel}" FontSize="10" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Muted}" Margin="0,10,0,0" LineHeight="18" />

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="RESOLUCIÓN" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding Resolution}" FontWeight="SemiBold" FontSize="14" Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                    <TextBlock Text="FPS" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding FpsLabel}" FontWeight="SemiBold" FontSize="14" Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                    <TextBlock Text="CALIDAD" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding Quality}" FontWeight="SemiBold" FontSize="14" Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <WrapPanel Margin="0,14,0,0">
                        <Button Content="CONECTAR CELULAR" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"
                                Command="{Binding ConnectCommand}" />
                        <Button Content="CONECTAR POR USB" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"
                                Command="{Binding ConnectUsbCommand}" />
                        <Button Content="CONECTAR POR WIFI" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"
                                Command="{Binding ConnectWifiCommand}" />
                    </WrapPanel>

                    <WrapPanel Margin="0,0,0,0">
                        <Button Content="INICIAR TRANSMISIÓN" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"
                                Command="{Binding StartStreamCommand}" />
                        <Button Content="DETENER TRANSMISIÓN" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"
                                Command="{Binding StopStreamCommand}" />
                        <Button Content="PANTALLA COMPLETA" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"
                                Command="{Binding FullscreenCommand}" />
                    </WrapPanel>

                    <WrapPanel>
                        <Button Content="CONFIGURAR CONTROLES" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"
                                Command="{Binding ConfigureControlsCommand}" />
                        <Button Content="DESCONECTAR" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"
                                Command="{Binding DisconnectCommand}" />
                        <Button Content="Refrescar" Style="{StaticResource GhostButton}" Margin="0,0,8,8"
                                Command="{Binding RefreshCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="AJUSTES DE TRANSMISIÓN" Style="{StaticResource SectionTitle}" />

                    <TextBlock Text="CALIDAD DE IMAGEN" Style="{StaticResource Caption}" Margin="0,14,0,0" />
                    <ComboBox ItemsSource="{Binding Qualities}" SelectedValuePath="Id" SelectedValue="{Binding Quality}"
                              Margin="0,6,0,0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="LÍMITE DE FPS" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding MaxFpsLabel}" Style="{StaticResource Caption}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    </Grid>
                    <Slider Minimum="15" Maximum="120" TickFrequency="15" IsSnapToTickEnabled="True"
                            Value="{Binding MaxFps}" Margin="0,6,0,0" />

                    <Border Style="{StaticResource Divider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Audio del teléfono" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="Reproduce el sonido del juego desde el móvil." Style="{StaticResource Caption}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                  IsChecked="{Binding AudioEnabled}" />
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Mantener el teléfono despierto" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="Evita que la pantalla se apague durante la partida." Style="{StaticResource Caption}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                  IsChecked="{Binding StayAwake}" />
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Mostrar toques" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="Dibuja los puntos de contacto en la pantalla del teléfono." Style="{StaticResource Caption}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                  IsChecked="{Binding ShowTouches}" />
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Reconexión automática" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="Vuelve a conectar el teléfono si se pierde la señal." Style="{StaticResource Caption}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                  IsChecked="{Binding AutoReconnect}" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Control táctil" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="{Binding TouchModeLabel}" Style="{StaticResource Caption}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                  IsChecked="{Binding TouchModeEnabled}" />
                    </Grid>

                    <Button Content="Calibrar posiciones táctiles" Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Left" Margin="0,12,0,0" Command="{Binding ConfigureTouchCommand}" />

                    <Border Style="{StaticResource Divider}" />

                    <TextBlock Text="HERRAMIENTAS" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding AdbStatus}" Style="{StaticResource Muted}" Margin="0,4,0,0" LineHeight="17" />
                    <TextBlock Text="{Binding ScrcpyStatus}" Style="{StaticResource Muted}" Margin="0,3,0,0" LineHeight="17" />
                    <Button Content="Instalar ADB y scrcpy oficiales" Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Left" Margin="0,10,0,0" Command="{Binding InstallToolsCommand}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Right: stream -->
        <Grid Grid.Column="1">
            <Border Style="{StaticResource Card}" Padding="14">
                <Grid>
                    <Border CornerRadius="12" Background="#F2050A07" ClipToBounds="True">
                        <Grid>
                            <controls:ScrcpyHost x:Name="StreamHost" />
                            <StackPanel x:Name="Placeholder" VerticalAlignment="Center" HorizontalAlignment="Center"
                                        MaxWidth="420">
                                <Border Width="54" Height="54" CornerRadius="15" Background="{DynamicResource ChipBrush}"
                                        HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource IconFont}" FontSize="22"
                                               Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="SIN TRANSMISIÓN" Style="{StaticResource SectionTitle}" Margin="0,14,0,0"
                                           HorizontalAlignment="Center" />
                                <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" TextAlignment="Center" LineHeight="18"
                                           Text="Conecta tu teléfono Android y pulsa INICIAR TRANSMISIÓN para ver y controlar tu Minecraft Bedrock original." />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
