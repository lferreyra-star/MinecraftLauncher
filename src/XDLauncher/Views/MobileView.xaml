<UserControl x:Class="XdLauncher.Views.MobileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:XdLauncher.Views.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="0,0,4,20" MaxWidth="1440" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions><ColumnDefinition Width="390" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

            <StackPanel Margin="0,0,14,0" VerticalAlignment="Top">
                <Border Style="{StaticResource HeroBanner}" Height="164" Margin="0,0,0,14">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding DataContext.CurrentBackgroundPath, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ImagePath}}"
                                    Stretch="UniformToFill" />
                    </Border.Background>
                    <Grid>
                        <Border Style="{StaticResource HeroOverlay}" />
                    <StackPanel Margin="26" VerticalAlignment="Bottom">
                        <TextBlock Text="MINECRAFT MOBILE CONNECT" Style="{StaticResource Kicker}" />
                        <TextBlock Text="Juega desde tu teléfono" Style="{StaticResource HeroTitle}" FontSize="28" Margin="0,6,0,0" />
                        <TextBlock Text="Conecta Android por USB o Wi-Fi y transmite tu mundo al PC con scrcpy." Style="{StaticResource BodyText}" MaxWidth="620" Margin="0,4,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Border Style="{StaticResource Pill}" Margin="0,0,8,0">
                            <TextBlock Text="{Binding StatusLabel}" FontSize="10" FontWeight="SemiBold" />
                        </Border>
                        <Border Style="{StaticResource Pill}" Margin="0,0,8,0">
                            <TextBlock Text="{Binding DeviceName}" FontSize="10" FontWeight="SemiBold" />
                        </Border>
                        </StackPanel>
                    </StackPanel>
                                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Padding="22">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource ChipBrush}">
                                <TextBlock Text="&#xE8EA;" FontFamily="{StaticResource IconFont}" FontSize="17"
                                           Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="MINECRAFT MOBILE CONNECT" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Juega desde el teléfono con teclado y ratón." Style="{StaticResource Caption}" Margin="0,3,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <Border Style="{StaticResource InnerCard}" Padding="14" Margin="0,16,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="DISPOSITIVO" Style="{StaticResource Caption}" />
                                        <TextBlock Text="{Binding DeviceName}" Style="{StaticResource BodyText}" FontSize="14" />
                                        <TextBlock Text="{Binding DeviceDetails}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Style="{StaticResource Badge}" Margin="8,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{DynamicResource AccentBrush}" />
                                            <TextBlock Text="{Binding StatusLabel}" Margin="4,0,0,4" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource BodyText}" Margin="0,10,0,0" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="RESOLUCIÓN" Style="{StaticResource Caption}" />
                                        <TextBlock Text="{Binding Resolution}" Style="{StaticResource BodyText}" />
                                    </StackPanel>
                                    <StackPanel Margin="10,0,10,0">
                                        <TextBlock Text="FPS" Style="{StaticResource Caption}" />
                                        <TextBlock Text="{Binding FpsLabel}" Style="{StaticResource BodyText}" />
                                    </StackPanel>
                                    <StackPanel Margin="10,0,0,0">
                                        <TextBlock Text="CALIDAD" Style="{StaticResource Caption}" />
                                        <TextBlock Text="{Binding Quality}" Style="{StaticResource BodyText}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <Button Content="CONECTAR CELULAR" Style="{StaticResource PrimaryButton}" Margin="0,0,0,4" Command="{Binding ConnectCommand}" />
                                <Button Content="POR USB" Style="{StaticResource SecondaryButton}" Margin="4,6,0,4" Command="{Binding ConnectUsbCommand}" />
                                <Button Content="POR WIFI" Style="{StaticResource SecondaryButton}" Margin="4,0,0,4" Command="{Binding ConnectWifiCommand}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <Button Content="INICIAR TRANSMISIÓN" Style="{StaticResource PrimaryButton}" Margin="0,0,0,4" Command="{Binding StartStreamCommand}" />
                                <Button Content="DETENER" Style="{StaticResource SecondaryButton}" Margin="4,6,0,4" Command="{Binding StopStreamCommand}" />
                                <Button Content="PANTALLA COMPLETA" Style="{StaticResource SecondaryButton}" Margin="4,0,0,4" Command="{Binding FullscreenCommand}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,0">
                                <Button Content="CONFIGURAR CONTROLES" Style="{StaticResource SecondaryButton}" Margin="0,0,0,4" Command="{Binding ConfigureControlsCommand}" />
                                <Button Content="REFRESCAR" Style="{StaticResource SecondaryButton}" Margin="4,0,0,4" Command="{Binding RefreshCommand}" />
                                <Button Content="DESCONECTAR" Style="{StaticResource DangerButton}" Margin="4,0,0,4" Command="{Binding DisconnectCommand}" />
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource Card}" Padding="12" Margin="0,16,0,0" Background="{DynamicResource ChipBrush}">
                            <StackPanel>
                                <TextBlock Text="HERRAMIENTAS" Style="{StaticResource Kicker}" />
                                <TextBlock Text="{Binding AdbStatus}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                                <TextBlock Text="{Binding ScrcpyStatus}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                                <Button Content="Instalar ADB y scrcpy" Style="{StaticResource PrimaryButton}" Margin="0,8,0,0" Command="{Binding InstallToolsCommand}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="AJUSTES DE TRANSMISIÓN" Style="{StaticResource SectionTitle}" />
                                <Border Style="{StaticResource InnerCard}" Padding="14" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="CALIDAD" Style="{StaticResource Caption}" />
                                        <ComboBox Margin="0,8,0,0" ItemsSource="{Binding Qualities}" SelectedValuePath="Id" SelectedValue="{Binding Quality}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Label}" />
                                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Grid Margin="0,12,0,0">
                                            <TextBlock Text="MAX FPS" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding MaxFpsLabel}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                        </Grid>
                                        <Slider Minimum="15" Maximum="120" TickFrequency="15" IsSnapToTickEnabled="True" Value="{Binding MaxFps}" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Audio del teléfono" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AudioEnabled}" />
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Mantener el teléfono despierto" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StayAwake}" />
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Mostrar toques" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowTouches}" />
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Auto reconexión" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AutoReconnect}" />
                                </Grid>
                                <Button Content="Configurar controles" Style="{StaticResource SecondaryButton}" Margin="0,12,0,0" Command="{Binding ConfigureTouchCommand}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Grid Grid.Column="1">
                <Border Style="{StaticResource Card}" Padding="14">
                    <Border CornerRadius="12" Background="{DynamicResource ChipBrush}" ClipToBounds="True">
                        <Grid>
                            <controls:ScrcpyHost x:Name="StreamHost" />
                            <StackPanel x:Name="Placeholder" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
                                <Border Width="54" Height="54" CornerRadius="15" Background="{DynamicResource ChipBrush}" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource IconFont}" FontSize="22"
                                               Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="SIN TRANSMISIÓN" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" Margin="0,14,0,0" />
                                <TextBlock Style="{StaticResource BodyText}" Margin="0,8,0,0" TextAlignment="Center" LineHeight="18"
                                           Text="Conecta tu teléfono y pulsa INICIAR TRANSMISIÓN para ver y controlar Minecraft de forma inmediata." />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
