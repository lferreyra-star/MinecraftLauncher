<UserControl x:Class="XdLauncher.Views.ModsCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="ModCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="MinWidth" Value="300" />
            <Setter Property="MinHeight" Value="260" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="TinyButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,0,6,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource HeroBanner}" Height="150" Margin="0,0,0,14">
            <Border.Background>
                <ImageBrush ImageSource="{Binding DataContext.CurrentBackgroundPath, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ImagePath}}"
                            Stretch="UniformToFill" />
            </Border.Background>
            <Grid>
                <Border Style="{StaticResource HeroOverlay}" />
                <StackPanel Margin="24,0,0,20" VerticalAlignment="Bottom">
                    <TextBlock Text="MODRINTH · CATÁLOGO REAL" Style="{StaticResource Kicker}" />
                    <TextBlock Text="Centro de Mods" Style="{StaticResource HeroTitle}" FontSize="28" Margin="0,5,0,0" />
                    <TextBlock Text="Portadas, dependencias y compatibilidad real con tu versión de Minecraft."
                               Style="{StaticResource BodyText}" MaxWidth="620" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Margin="0,0,10,0">
                    <TextBox Style="{StaticResource InputTextBox}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </Grid>
                <StackPanel Margin="0,0,10,0" Orientation="Horizontal">
                    <ComboBox ItemsSource="{Binding GameVersions}" SelectedItem="{Binding SelectedGameVersion}" MinWidth="160" Margin="0,0,10,0" />
                    <ComboBox ItemsSource="{Binding Loaders}" SelectedItem="{Binding SelectedLoader}" MinWidth="130" Margin="0,0,10,0" />
                    <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" MinWidth="170" Margin="0,0,10,0" />
                    <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}" MinWidth="170" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Buscar" Style="{StaticResource PrimaryButton}" Padding="16,9" Command="{Binding SearchCommand}" />
                    <Button Content="Actualizar" Style="{StaticResource IconButton}" Width="40" Height="40" Margin="6,0,0,0" Command="{Binding RefreshCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="326" />
            </Grid.ColumnDefinitions>

            <TabControl Background="{DynamicResource SurfaceSunkenBrush}" BorderBrush="{DynamicResource BorderSoftBrush}">
                <TabItem Header="CATALOGO GLOBAL">
                    <StackPanel Margin="0,10,0,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ResultSummary}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"><Run Text=" | " /><Run Text="{Binding CompatibilitySummary, Mode=OneWay}" /></TextBlock>
                            </StackPanel>
                            <Button Content="Comprobar actualizaciones" Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Right" Command="{Binding CheckUpdatesCommand}" />
                        </Grid>
                    <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" Margin="0,12,0,0">
                        <Border Style="{StaticResource InnerCard}" Padding="16">
                            <StackPanel>
                            <Border Style="{StaticResource SkeletonBar}" Width="520" Margin="0,6,0,0" />
                            <Border Style="{StaticResource SkeletonBar}" Width="460" Margin="0,6,0,0" />
                            <Border Style="{StaticResource SkeletonBar}" Width="380" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520" Margin="0,10,0,0">
                            <ListBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Margin" Value="0,0,12,12" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Chrome" Background="Transparent" CornerRadius="14"
                                                            BorderThickness="1" BorderBrush="Transparent">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource RowHoverBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ModCard}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid>
                                                    <Border Width="48" Height="48" CornerRadius="14" Background="{DynamicResource ChipBrush}">
                                                        <Grid>
                                                            <TextBlock Text="&#xE7B8;" FontFamily="{StaticResource IconFont}" FontSize="19"
                                                                       Foreground="{DynamicResource AccentBrush}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            <Border Visibility="{Binding IconUrl, Converter={StaticResource NullToVisibility}}">
                                                                <Border.Background>
                                                                    <ImageBrush ImageSource="{Binding IconUrl}" Stretch="UniformToFill" />
                                                                </Border.Background>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel HorizontalAlignment="Right" Margin="14,0,0,0">
                                                        <Border Style="{StaticResource Pill}">
                                                            <TextBlock Text="MODRINTH" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                                        </Border>
                                                        <TextBlock Text="{Binding Downloads, StringFormat='{}{0:N0} descargas'}"
                                                                   Style="{StaticResource Caption}" Margin="0,6,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                                <StackPanel Grid.Row="1" Margin="0,12,0,0">
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitle}" TextTrimming="CharacterEllipsis" MaxHeight="40" />
                                                    <TextBlock Text="{Binding Author, StringFormat='por {0}'}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                                                </StackPanel>
                                                <TextBlock Grid.Row="2" Text="{Binding Description}" Style="{StaticResource BodyText}"
                                                           Margin="0,8,0,0" MaxHeight="48" TextTrimming="CharacterEllipsis" />
                                                <Grid Grid.Row="3" Margin="0,8,0,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="INSTALAR" Style="{StaticResource PrimaryButton}" FontSize="11" Padding="16,7"
                                                                Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}" />
                                                        <Button Content="Abrir" Style="{StaticResource GhostButton}" FontSize="11" Margin="6,0,0,0"
                                                                Command="{Binding DataContext.OpenWebsiteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding SourceUrl}" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Followers, StringFormat='{}{0} seguidores'}" Style="{StaticResource Caption}"
                                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>
                        <Button Content="Cargar más resultados" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Center"
                                Margin="0,8,0,0" Visibility="{Binding CanLoadMore, Converter={StaticResource BoolToVisibility}}"
                                Command="{Binding LoadMoreCommand}" />
                    </StackPanel>
                </TabItem>

                <TabItem Header="MI BIBLIOTECA">
                    <StackPanel Margin="0,10,0,0">
                        <Grid>
                            <TextBlock Text="{Binding ActiveProfileLabel}" Style="{StaticResource Caption}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Abrir carpeta mods" Style="{StaticResource GhostButton}" Command="{Binding OpenModsFolderCommand}" />
                                <Button Content="Actualizar datos" Style="{StaticResource GhostButton}" Margin="4,0,0,0" Command="{Binding RefreshCommand}" />
                            </StackPanel>
                        </Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                            <ItemsControl ItemsSource="{Binding Library}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource InnerCard}" Margin="0,0,0,8" Padding="13">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}">
                                                    <TextBlock Text="&#xE7B8;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                                                    <TextBlock Text="{Binding VersionLabel, StringFormat='v{0}'}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                                                    <TextBlock Text="{Binding Loader}" Style="{StaticResource Caption}" Foreground="{DynamicResource AccentBrush}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="{Binding IsEnabled, Converter={StaticResource BoolToText}, ConverterParameter=ACTIVAR|DESACTIVAR}" Style="{StaticResource TinyButton}"
                                                            Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="Actualizar" Style="{StaticResource TinyButton}" Margin="6,0,0,0"
                                                            Command="{Binding DataContext.UpdateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="&#xE74D;" Style="{StaticResource IconButton}" Width="30" Height="30" Margin="6,0,0,0"
                                                            Foreground="{DynamicResource ErrorBrush}"
                                                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </TabItem>

                <TabItem Header="MODPACKS">
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="Modpacks compatibles · cada instalación crea un perfil independiente" Style="{StaticResource Caption}" />
                        <ScrollViewer Margin="0,10,0,0" VerticalScrollBarVisibility="Auto" MaxHeight="520">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding Modpacks}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource ModCard}">
                                                <Grid>
                                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                    <Border Style="{StaticResource Pill}" HorizontalAlignment="Left"><TextBlock Text="MODPACK" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" /></Border>
                                                    <StackPanel Grid.Row="1" Margin="0,12,0,0">
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitle}" TextTrimming="CharacterEllipsis" MaxHeight="40" />
                                                        <TextBlock Text="{Binding Author, StringFormat='por {0}'}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                                                        <TextBlock Text="{Binding Description}" Style="{StaticResource BodyText}" Margin="0,8,0,0" MaxHeight="46" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                                                        <Button Content="INSTALAR MODPACK" Style="{StaticResource PrimaryButton}" FontSize="11" Padding="14,7"
                                                                Command="{Binding DataContext.InstallModpackCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}" />
                                                        <Button Content="Abrir" Style="{StaticResource GhostButton}" FontSize="11" Margin="6,0,0,0"
                                                                Command="{Binding DataContext.OpenWebsiteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding SourceUrl}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="MODPACKS INSTALADOS" Style="{StaticResource SectionTitle}" Margin="0,16,0,8" />
                                <ItemsControl ItemsSource="{Binding ModpackLibrary}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource InnerCard}" Margin="0,0,0,8" Padding="13">
                                                <Grid>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                                                        <TextBlock Text="{Binding VersionLabel, StringFormat='v{0}'}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                                                        <TextBlock Text="{Binding MinecraftVersion, StringFormat='Minecraft {0}'}" Style="{StaticResource Caption}" />
                                                    </StackPanel>
                                                    <Button Content="Abrir carpeta" Style="{StaticResource TinyButton}" HorizontalAlignment="Right"
                                                            Command="{Binding DataContext.OpenModpackFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>
                </TabItem>
            </TabControl>

            <StackPanel Grid.Column="1" Margin="14,10,0,0">
                <Border Style="{StaticResource Card}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="DETALLES" Style="{StaticResource SectionTitle}" />
                        <Border Visibility="{Binding SelectedProject, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedProject.Name}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding SelectedProject.Author, StringFormat='por {0}'}" Style="{StaticResource Caption}" Margin="0,5,0,0" />
                                <TextBlock Text="{Binding SelectedProject.Description}" Style="{StaticResource BodyText}" Margin="0,10,0,0" />
                                <Border Style="{StaticResource Divider}" />
                                <TextBlock Text="{Binding SelectedProject.Downloads, StringFormat='Descargas: {0:N0}'}" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding SelectedProject.UpdatedAt, StringFormat='Actualizado: {0}'}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                                <Border Style="{StaticResource Divider}" Margin="0,14,0,0" />
                                <TextBlock Text="VERSIÓN DEL MOD" Style="{StaticResource Kicker}" Margin="0,12,0,0" />
                                <ComboBox ItemsSource="{Binding ModVersions}" SelectedItem="{Binding SelectedModVersion}"
                                          Margin="0,8,0,0" HorizontalAlignment="Stretch" MinWidth="220">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding VersionNumber}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding DatePublished, StringFormat='  ·  {0}'}"
                                                           Style="{StaticResource Caption}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="Cargando versiones…" Style="{StaticResource Caption}" Margin="0,6,0,0"
                                           Visibility="{Binding IsLoadingVersions, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="No hay versiones compatibles con este perfil." Style="{StaticResource Caption}"
                                           Margin="0,6,0,0"
                                           Visibility="{Binding HasModVersions, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                <TextBlock Text="{Binding TargetFolder, StringFormat='Se instalará en: {0}'}"
                                           Style="{StaticResource Caption}" Margin="0,10,0,0" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding TargetFolder}" />
                                <Button Content="INSTALAR VERSIÓN SELECCIONADA" Style="{StaticResource PrimaryButton}"
                                        Margin="0,16,0,0" Command="{Binding InstallSelectedVersionCommand}" />
                                <Button Content="Instalar última compatible" Style="{StaticResource SecondaryButton}"
                                        Margin="0,8,0,0" Command="{Binding InstallCommand}"
                                        CommandParameter="{Binding SelectedProject}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Visibility="{Binding SelectedProject, Converter={StaticResource NullToVisibility}}"
                                   Style="{StaticResource Muted}" Margin="0,14,0,0" Text="Selecciona un mod del catálogo para ver sus detalles." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="18" Margin="0,12,0,0" Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{Binding ProgressStage}" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="{Binding ProgressDetail}" Style="{StaticResource BodyText}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                        <ProgressBar Height="7" Margin="0,12,0,0" Value="{Binding ProgressPercent, Mode=OneWay}" Minimum="0" Maximum="100"
                                     Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource ProgressTrackBrush}" />
                        <Grid Margin="0,8,0,0">
                            <TextBlock Text="{Binding ProgressSpeed}" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding ProgressEta}" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource InnerCard}" Padding="16" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="ESTADO" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource BodyText}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
