<Window x:Class="XdLauncher.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XD Launcher"
        Width="960" Height="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Opacity="0">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.28">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid x:Name="SplashRoot" ClipToBounds="True" Background="{DynamicResource WindowBackgroundBrush}">

        <!-- Luces ambientales -->
        <Grid IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse x:Name="AmbientGlowA" Width="820" Height="820" HorizontalAlignment="Left"
                     VerticalAlignment="Top" Margin="-320,-360,0,0"
                     Fill="{DynamicResource AmbientOrbBrushA}" Opacity="0.85">
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="GlowATranslate" X="0" Y="0" />
                </Ellipse.RenderTransform>
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                 From="-20" To="70" Duration="0:0:24">
                                    <DoubleAnimation.EasingFunction>
                                        <SineEase EasingMode="EaseInOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 From="-10" To="50" Duration="0:0:30">
                                    <DoubleAnimation.EasingFunction>
                                        <SineEase EasingMode="EaseInOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>

            <Ellipse x:Name="AmbientGlowB" Width="720" Height="720" HorizontalAlignment="Right"
                     VerticalAlignment="Bottom" Margin="0,0,-260,-320"
                     Fill="{DynamicResource AmbientOrbBrushB}" Opacity="0.7">
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="GlowBTranslate" X="0" Y="0" />
                </Ellipse.RenderTransform>
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                 From="10" To="-60" Duration="0:0:27">
                                    <DoubleAnimation.EasingFunction>
                                        <SineEase EasingMode="EaseInOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 From="0" To="-46" Duration="0:0:33">
                                    <DoubleAnimation.EasingFunction>
                                        <SineEase EasingMode="EaseInOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>

            <Ellipse Width="520" Height="520" HorizontalAlignment="Center" VerticalAlignment="Top"
                     Margin="140,-300,0,0" Fill="{DynamicResource AmbientOrbBrushC}" Opacity="0.5" />
        </Grid>

        <Rectangle Fill="{DynamicResource GridPatternBrush}" Opacity="0.4" IsHitTestVisible="False" />
        <Canvas x:Name="ParticleLayer" IsHitTestVisible="False" />
        <Rectangle Fill="{DynamicResource VignetteBrush}" IsHitTestVisible="False" />

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="520" Margin="0,0,0,22">

            <!-- Logotipo -->
            <Grid x:Name="LogoPanel" Width="196" Height="196" HorizontalAlignment="Center"
                  RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Grid.RenderTransform>
                <Grid.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.5" />
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 From="0.84" To="1" Duration="0:0:0.75">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 From="0.84" To="1" Duration="0:0:0.75">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Grid.Triggers>

                <Ellipse Width="196" Height="196" Fill="{DynamicResource AccentGlowBrush}" Opacity="0.9" />

                <Ellipse x:Name="OrbitRing" Width="168" Height="168" Stroke="{DynamicResource AccentBrush}"
                         StrokeThickness="1" StrokeDashArray="3 7" Opacity="0.7"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="OrbitRotate" Angle="0" />
                    </Ellipse.RenderTransform>
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                     From="0" To="360" Duration="0:0:26" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>

                <Ellipse Width="132" Height="132" Fill="{DynamicResource ChipStrongBrush}"
                         Stroke="{DynamicResource GlassBorderBrush}" StrokeThickness="1">
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="0" Opacity="0.45" />
                    </Ellipse.Effect>
                </Ellipse>
                <Image Source="/Assets/logo.png" Width="96" Height="96" />

                <Ellipse Width="9" Height="9" Fill="{DynamicResource AccentLightBrush}"
                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,18,0">
                    <Ellipse.Effect>
                        <DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="10"
                                          ShadowDepth="0" Opacity="0.7" />
                    </Ellipse.Effect>
                </Ellipse>
            </Grid>

            <TextBlock Text="XD LAUNCHER" FontFamily="{StaticResource DisplayFont}" FontSize="36"
                       FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalAlignment="Center" Margin="0,22,0,0" x:Name="TitleText">
                <TextBlock.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1"
                                                 BeginTime="0:0:0.18" Duration="0:0:0.45" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </TextBlock.Triggers>
            </TextBlock>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Border Style="{StaticResource Pill}" Padding="12,4">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}"
                                 VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBlock Text="BEDROCK EDITION" FontSize="9.5" FontWeight="Bold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Pill}" Padding="12,4" Margin="8,0,0,0">
                    <TextBlock x:Name="VersionText" Text="v1.0.0" FontSize="9.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}" />
                </Border>
            </StackPanel>

            <!-- Progreso -->
            <Grid Width="320" Margin="0,42,0,0" HorizontalAlignment="Center">
                <TextBlock Text="PROGRESO DE INICIO" Style="{StaticResource Caption}" FontSize="9.5"
                           HorizontalAlignment="Left" />
                <TextBlock x:Name="PercentText" Text="0 %" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" />
            </Grid>

            <Border x:Name="ProgressTrack" Width="320" Height="6" CornerRadius="3" Margin="0,9,0,0"
                    Background="{DynamicResource ProgressTrackBrush}" HorizontalAlignment="Center">
                <Border x:Name="ProgressFill" Width="0" Height="6" CornerRadius="3" HorizontalAlignment="Left"
                        Background="{DynamicResource AccentGradientBrush}">
                    <Border.Effect>
                        <DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="14"
                                          ShadowDepth="0" Opacity="0.55" />
                    </Border.Effect>
                </Border>
            </Border>

            <Grid Width="320" Margin="0,16,0,0" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{DynamicResource AccentBrush}"
                             VerticalAlignment="Center" Margin="0,0,9,0">
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25"
                                                         Duration="0:0:1.2" AutoReverse="True" RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <TextBlock x:Name="StatusText" Text="Preparando el launcher…"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                               TextWrapping="NoWrap" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="StageText" Text="Inicializando" Style="{StaticResource Caption}" FontSize="9.5"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </StackPanel>

        <!-- Pie -->
        <Grid VerticalAlignment="Bottom" Margin="34,0,34,24">
            <StackPanel Orientation="Horizontal">
                <Border Width="22" Height="22" CornerRadius="7" Background="{DynamicResource AccentSoftBrush}"
                        BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1">
                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="9"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Arranque seguro · sesión cifrada y datos locales"
                           Style="{StaticResource Caption}" FontSize="10" VerticalAlignment="Center"
                           Margin="9,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="FIREBASE AUTH" Style="{StaticResource Caption}" FontSize="9" />
                <TextBlock Text="  ·  " Style="{StaticResource Caption}" FontSize="9" />
                <TextBlock Text="MICROSOFT STORE" Style="{StaticResource Caption}" FontSize="9" />
                <TextBlock Text="  ·  " Style="{StaticResource Caption}" FontSize="9" />
                <TextBlock Text="JAVA &amp; BEDROCK" Style="{StaticResource Caption}" FontSize="9" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
