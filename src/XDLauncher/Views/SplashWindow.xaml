<Window x:Class="XdLauncher.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XD Launcher"
        Width="960" Height="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#070A0F"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid ClipToBounds="True">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#070A0F" Offset="0" />
                <GradientStop Color="#0B1119" Offset="0.6" />
                <GradientStop Color="#080C13" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Ellipse Width="760" Height="760" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-260,-260,0,0" Opacity="0.55">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#4C2BD46A" Offset="0" />
                    <GradientStop Color="#002BD46A" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="640" Height="640" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-240,-240" Opacity="0.45">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#4238BDF8" Offset="0" />
                    <GradientStop Color="#0038BDF8" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Canvas x:Name="ParticleLayer" IsHitTestVisible="False" />

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="460">
            <Grid x:Name="LogoPanel" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Grid.RenderTransform>
                <Grid.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.5" />
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 From="0.86" To="1" Duration="0:0:0.7">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 From="0.86" To="1" Duration="0:0:0.7">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Grid.Triggers>
                <Ellipse Width="150" Height="150" Fill="#1A2A22">
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#5CE07A" BlurRadius="46" ShadowDepth="0" Opacity="0.55" />
                    </Ellipse.Effect>
                </Ellipse>
                <Image Source="/Assets/logo.png" Width="104" Height="104" />
            </Grid>

            <TextBlock Text="XD LAUNCHER" FontSize="34" FontWeight="Bold" Foreground="#F2F6FC"
                       HorizontalAlignment="Center" Margin="0,26,0,0" x:Name="TitleText" />
            <TextBlock Text="BEDROCK LAUNCHER" FontSize="11" FontWeight="SemiBold" Foreground="#7C8CA0"
                       HorizontalAlignment="Center" Margin="0,6,0,0" x:Name="SubtitleText" />

            <Border x:Name="ProgressTrack" Width="260" Height="4" CornerRadius="2" Background="#182130"
                    HorizontalAlignment="Center" Margin="0,34,0,0" Opacity="1">
                <Border x:Name="ProgressFill" Width="0" Height="4" CornerRadius="2" HorizontalAlignment="Left">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#5CE07A" Offset="0" />
                            <GradientStop Color="#38BDF8" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Border>

            <TextBlock x:Name="StatusText" Text="Preparando el launcher…" Foreground="#94A3B8" FontSize="12"
                       HorizontalAlignment="Center" Margin="0,16,0,0" TextWrapping="NoWrap" />
        </StackPanel>
    </Grid>
</Window>
