<UserControl x:Class="XdLauncher.Views.VersionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,6,28">

            <Border Style="{StaticResource Card}" Padding="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="62" Height="62" CornerRadius="18" Background="{DynamicResource ChipBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFont}" FontSize="26"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="18,0,18,0" VerticalAlignment="Center">
                        <TextBlock Text="Versión instalada" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding Version}" Style="{StaticResource PageTitle}" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Border x:Name="UpdateBadge" HorizontalAlignment="Right" Margin="0,0,0,10">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Pill}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsUpToDate}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding UpdateStatus}" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                        <Button Content="{Binding CheckLabel}" Style="{StaticResource PrimaryButton}"
                                MinWidth="190" Command="{Binding CheckCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource ChipBrush}">
                                <TextBlock x:Name="UpdateGlyph" Text="&#xE896;" FontFamily="{StaticResource IconFont}"
                                           FontSize="18" Foreground="{DynamicResource InfoBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding UpdateHeadline}" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="{Binding StoreUpdatedLabel}" Style="{StaticResource Caption}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="{Binding UpdateDescription}" Style="{StaticResource Muted}" Margin="0,16,0,0"
                                   LineHeight="19" />

                        <Border Style="{StaticResource InnerCard}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="DETALLE DE LA COMPARACIÓN" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding UpdateDetail}" Style="{StaticResource Muted}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Content="Abrir Microsoft Store" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding OpenStoreCommand}" />
                            <Button Content="Buscar actualizaciones" Style="{StaticResource SecondaryButton}"
                                    Margin="10,0,0,0" Command="{Binding OpenUpdatesCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Datos del paquete" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="FECHA DE INSTALACIÓN" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding InstalledDate}" FontWeight="SemiBold" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="CANAL" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding Channel}" FontWeight="SemiBold" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="ARQUITECTURA" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding Architecture}" FontWeight="SemiBold" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="EDITOR" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding Publisher}" FontWeight="SemiBold" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="ESTADO" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding PackageStatus}" FontWeight="SemiBold" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="FIRMA" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding SignatureKind}" FontSize="11" Margin="0,3,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <Border Style="{StaticResource Divider}" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Copiar versión" Style="{StaticResource GhostButton}"
                                    Command="{Binding CopyVersionCommand}" />
                            <Button Content="Carpeta de datos" Style="{StaticResource GhostButton}" Margin="4,0,0,0"
                                    Command="{Binding OpenFolderCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Notas de la versión oficial" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Texto publicado por Microsoft Store para el producto. No se inventan versiones ni fechas."
                                       Style="{StaticResource Muted}" Margin="0,4,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding CatalogStatus}" Style="{StaticResource Caption}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   MaxWidth="300" TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <Border Style="{StaticResource InnerCard}" Margin="0,16,0,0">
                        <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding Changelog}" Style="{StaticResource Muted}" LineHeight="20"
                                       FontSize="12" />
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel Orientation="Horizontal">
                    <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource ChipBrush}">
                        <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="18"
                                   Foreground="{DynamicResource InfoBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Actualizaciones gestionadas por Windows" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="El launcher no descarga parches ni versiones anteriores. Microsoft Store es el único canal oficial: instala, repara y actualiza el paquete firmado. La detección usa PackageManager y la fecha del catálogo oficial."
                                   Style="{StaticResource Muted}" Margin="0,4,0,0" MaxWidth="850" HorizontalAlignment="Left" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
