<UserControl x:Class="XdLauncher.Views.VersionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,4,20">
                <Border Style="{StaticResource HeroBanner}" Height="164" Margin="0,0,0,14">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding DataContext.CurrentBackgroundPath, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ImagePath}}"
                                    Stretch="UniformToFill" />
                    </Border.Background>
                    <Grid>
                        <Border Style="{StaticResource HeroOverlay}" />
                    <StackPanel Margin="26" VerticalAlignment="Bottom">
                        <TextBlock Text="BEDROCK · VERSIONES" Style="{StaticResource Kicker}" />
                        <TextBlock Text="Actualizaciones oficiales" Style="{StaticResource HeroTitle}" FontSize="28" Margin="0,6,0,0" />
                        <TextBlock Text="Comprueba la versión instalada, la fecha del catálogo y el estado real del paquete de Microsoft Store." Style="{StaticResource BodyText}" MaxWidth="620" Margin="0,4,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Border Style="{StaticResource Pill}" Margin="0,0,8,0">
                            <TextBlock Text="{Binding Version}" FontSize="10" FontWeight="SemiBold" />
                        </Border>
                        <Border Style="{StaticResource Pill}" Margin="0,0,8,0">
                            <TextBlock Text="{Binding Channel}" FontSize="10" FontWeight="SemiBold" />
                        </Border>
                        </StackPanel>
                    </StackPanel>
                                    </Grid>
                </Border>

            <Border Style="{StaticResource Card}" Padding="22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="54" Height="54" CornerRadius="16" Background="{DynamicResource ChipBrush}"
                            BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1">
                        <TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFont}" FontSize="26"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="MINECRAFT BEDROCK · VERSIONES" Style="{StaticResource Kicker}" />
                        <TextBlock Text="{Binding Version}" Style="{StaticResource HeroTitle}" FontSize="30" Margin="0,4,0,2" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Border Style="{StaticResource Pill}" Margin="0,0,8,0"><TextBlock Text="{Binding Channel}" FontSize="10.5" FontWeight="SemiBold" /></Border>
                            <Border Style="{StaticResource Pill}"><TextBlock Text="{Binding PackageStatus}" FontSize="10.5" FontWeight="SemiBold" /></Border>
                        </StackPanel>
                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="NIEVACIÓN" Style="{StaticResource StatLabel}" />
                            <Border Style="{StaticResource Badge}" Background="{DynamicResource ErrorSoftBrush}"
                                    BorderBrush="{DynamicResource ErrorBrush}" Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="{Binding UpdateStatus}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ErrorBrush}" />
                            </Border>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <Border x:Name="UpdateBadge" Padding="12,7" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource Caption}" />
                                <TextBlock Text="!" FontFamily="{StaticResource IconFont}" FontSize="12"
                                           Foreground="{DynamicResource ErrorBrush}" Margin="8,0,0,0" />
                            </StackPanel>
                        </Border>
                        <Button Content="{Binding CheckLabel}" Style="{StaticResource PrimaryButton}" Height="44" MinWidth="220" Command="{Binding CheckCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="ACTUALIZACIÓN DISPONIBLE" Style="{StaticResource Kicker}" Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="Actualmente Windows lo maneja" Style="{StaticResource CardTitle}" Margin="0,8,0,4" />
                        <TextBlock Text="{Binding UpdateDescription}" Style="{StaticResource BodyText}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,12,0,0"><Run Text="Fecha del catálogo: " /><Run Text="{Binding StoreUpdatedLabel, Mode=OneWay}" /></TextBlock>
                        <Border Style="{StaticResource InnerCard}" Padding="12" Margin="0,12,0,0">
                            <TextBlock Text="{Binding UpdateDetail}" Style="{StaticResource BodyText}" />
                        </Border>
                        <Button Content="Abrir Microsoft Store" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" Command="{Binding OpenStoreCommand}" />
                        <Button Content="Solicitar reparación" Style="{StaticResource SecondaryButton}" Margin="4,10,0,0" Command="{Binding OpenUpdatesCommand}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="DATOS DEL PAQUETE" Style="{StaticResource SectionTitle}" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Fecha de instalación" Style="{StaticResource StatLabel}" />
                            <TextBlock Text="{Binding InstalledDate}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Arquitectura" Style="{StaticResource StatLabel}" />
                            <TextBlock Text="{Binding Architecture}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Editor" Style="{StaticResource StatLabel}" />
                            <TextBlock Text="{Binding Publisher}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Estado" Style="{StaticResource StatLabel}" />
                            <TextBlock Text="{Binding PackageStatus}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Firma" Style="{StaticResource StatLabel}" />
                            <TextBlock Text="{Binding SignatureKind}" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Grid>
                        <Border Style="{StaticResource Divider}" Margin="0,12,0,10" />
                        <WrapPanel Margin="0,0,0,0">
                            <Button Content="Copiar versión" Style="{StaticResource GhostButton}" Command="{Binding CopyVersionCommand}" />
                            <Button Content="Carpeta de datos" Style="{StaticResource GhostButton}" Margin="4,0,0,0" Command="{Binding OpenFolderCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel Orientation="Horizontal">
                    <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource ChipBrush}">
                        <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="18"
                                   Foreground="{DynamicResource InfoBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="NOTA SOBRE LA VERSIÓN" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="Se trata de la versión instalada desde Microsoft Store. Windows es la fuente fiable: si la versión es errónea por una instalación incompleta, la mejor opción es instalar, reparar o actualizar desde la Store. No modificamos ni creamos paquetes."
                                   Style="{StaticResource BodyText}" Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
