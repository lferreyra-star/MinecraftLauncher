<UserControl x:Class="XdLauncher.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:XdLauncher.Core"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="760" d:DesignWidth="1100">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1180" Margin="0,0,4,8">
            <Border CornerRadius="22" Padding="26" BorderThickness="1"
                    Background="{DynamicResource SurfaceStrongBrush}"
                    BorderBrush="{DynamicResource BorderSoftBrush}" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="112" Height="112" VerticalAlignment="Center">
                        <Border CornerRadius="28" Background="{DynamicResource AvatarGradientBrush}" Padding="2">
                            <Border CornerRadius="26" Background="{DynamicResource WindowBackgroundBrush}" />
                        </Border>
                        <Border CornerRadius="24" Margin="5" ClipToBounds="True" Background="{DynamicResource SurfaceSunkenBrush}">
                            <Grid>
                                <TextBlock Text="{Binding Initial}" FontFamily="{StaticResource DisplayFont}" FontSize="40"
                                           FontWeight="Bold" Foreground="{DynamicResource AccentLightBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image Source="{Binding AvatarPath, Converter={StaticResource ImagePath}}"
                                       Stretch="UniformToFill"
                                       Visibility="{Binding AvatarPath, Converter={StaticResource NullToVisibility}}" />
                            </Grid>
                        </Border>
                        <Ellipse Width="16" Height="16" Fill="{DynamicResource SuccessBrush}" Stroke="{DynamicResource WindowBackgroundBrush}"
                                 StrokeThickness="3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,6" />
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="22,0,20,0" VerticalAlignment="Center">
                        <TextBlock Text="PERFIL XD" Style="{StaticResource Kicker}" />
                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource HeroTitle}" FontSize="30" Margin="0,4,0,2" />
                        <TextBlock Text="{Binding Email}" Style="{StaticResource BodyText}" FontSize="13" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Border Style="{StaticResource Pill}" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                               Foreground="{DynamicResource SuccessBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding SessionStateLabel}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Pill}">
                                <TextBlock Text="{Binding ProviderLabel}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentLightBrush}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <Button Content="Gestionar cuenta" Style="{StaticResource PrimaryButton}"
                                Command="{Binding OpenAccountSettingsCommand}" />
                        <Button Content="Sitio web de XD" Style="{StaticResource GhostButton}" Margin="0,8,0,0"
                                Command="{Binding OpenWebsiteCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <Border Style="{StaticResource Card}" Padding="22">
                        <StackPanel>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="IDENTIDAD DE MINECRAFT" Style="{StaticResource Kicker}" />
                                    <TextBlock Text="Tu jugador" Style="{StaticResource SectionTitle}" Margin="0,4,0,0" />
                                </StackPanel>
                                <Border Style="{StaticResource Badge}" HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding AccountTypeLabel}" FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentLightBrush}" />
                                </Border>
                            </Grid>
                            <Grid Margin="0,20,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="62" Height="62" CornerRadius="18" Background="{DynamicResource SurfaceSunkenBrush}"
                                        BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1">
                                    <Grid>
                                        <TextBlock Text="{Binding MinecraftInitial}" FontFamily="{StaticResource DisplayFont}"
                                                   FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Image Source="{Binding Profile.AvatarPath, Converter={StaticResource ImagePath}}"
                                               Stretch="UniformToFill"
                                               Visibility="{Binding Profile.AvatarPath, Converter={StaticResource NullToVisibility}}" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Gamertag}" Style="{StaticResource CardTitle}" FontSize="20" />
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <TextBlock Text="Gamerscore" Style="{StaticResource Caption}" />
                                        <TextBlock Text="{Binding GamerscoreLabel}" FontWeight="SemiBold" FontSize="12"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="7,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding SyncStatus}" Style="{StaticResource Caption}" Margin="0,16,0,0" />
                            <Border Style="{StaticResource Divider}" />
                            <WrapPanel>
                                <Button Content="{Binding Profile.SignInLabel}" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding Profile.SignInCommand}" Margin="0,0,8,8" />
                                <Button Content="Elegir avatar" Style="{StaticResource GhostButton}"
                                        Command="{Binding Profile.PickAvatarCommand}" Margin="0,0,8,8" />
                                <Button Content="Renombrar perfil" Style="{StaticResource GhostButton}"
                                        Command="{Binding Profile.RenameLocalCommand}" Margin="0,0,8,8"
                                        Visibility="{Binding IsLocal, Converter={StaticResource BoolToVisibility}}" />
                                <Button Content="Usar perfil local" Style="{StaticResource GhostButton}"
                                        Command="{Binding Profile.UseLocalCommand}" Margin="0,0,8,8"
                                        Visibility="{Binding IsMicrosoftAccount, Converter={StaticResource BoolToVisibility}}" />
                                <Button Content="Desvincular Xbox" Style="{StaticResource DangerButton}"
                                        Command="{Binding Profile.SignOutCommand}" Margin="0,0,8,8"
                                        Visibility="{Binding IsMicrosoftAccount, Converter={StaticResource BoolToVisibility}}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="22" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="SESIÓN DEL LAUNCHER" Style="{StaticResource Kicker}" />
                            <TextBlock Text="Cuenta XD" Style="{StaticResource SectionTitle}" Margin="0,4,0,0" />
                            <TextBlock Text="Tu sesión se valida de forma segura con Firebase. Los tokens nunca salen de este equipo."
                                       Style="{StaticResource Caption}" Margin="0,6,0,0" />
                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Correo" Style="{StaticResource StatLabel}" />
                                    <TextBlock Text="{Binding Email}" Style="{StaticResource BodyText}" FontSize="13.5" Margin="0,3,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE8C8;"
                                        Command="{Binding CopyUserIdCommand}" ToolTip="Copiar ID de cuenta" />
                            </Grid>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="ID de cuenta" Style="{StaticResource StatLabel}" />
                                    <TextBlock Text="{Binding UserIdShort}" Style="{StaticResource BodyText}" FontSize="12.5"
                                               Margin="0,3,0,0" FontFamily="Consolas" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Proveedor" Style="{StaticResource StatLabel}" />
                                    <TextBlock Text="{Binding ProviderLabel}" Style="{StaticResource BodyText}" FontSize="12.5" Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource Divider}" />
                            <Button Content="Cerrar sesión de XD Launcher" Style="{StaticResource DangerButton}"
                                    HorizontalAlignment="Left"
                                    Command="{Binding DataContext.SignOutCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource Card}" Padding="22">
                        <StackPanel>
                            <TextBlock Text="RESUMEN" Style="{StaticResource Kicker}" />
                            <TextBlock Text="Tu launcher" Style="{StaticResource SectionTitle}" Margin="0,4,0,14" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource InnerCard}" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding LauncherVersion}" Style="{StaticResource StatValue}" FontSize="22" />
                                        <TextBlock Text="Versión de XD Launcher" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource InnerCard}" Margin="6,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding AccountTypeLabel}" Style="{StaticResource CardTitle}" FontSize="14" />
                                        <TextBlock Text="Tipo de cuenta activa" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="22" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="ACCESOS RÁPIDOS" Style="{StaticResource Kicker}" />
                            <TextBlock Text="Sigue donde lo dejaste" Style="{StaticResource SectionTitle}" Margin="0,4,0,14" />
                            <Button Style="{StaticResource CardButton}" Padding="14" Margin="0,0,0,9"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="java">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource IconTile}" Width="36" Height="36">
                                        <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                                   Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Minecraft Java" FontWeight="SemiBold" />
                                        <TextBlock Text="Versiones y lanzamiento" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="9"
                                               Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource CardButton}" Padding="14" Margin="0,0,0,9"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="mobile">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource IconTile}" Width="36" Height="36">
                                        <TextBlock Text="&#xE8EA;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                                   Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Móvil" FontWeight="SemiBold" />
                                        <TextBlock Text="Conecta tu teléfono" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="9"
                                               Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource CardButton}" Padding="14"
                                    Command="{Binding OpenAccountSettingsCommand}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource IconTile}" Width="36" Height="36">
                                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                                   Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Ajustes de cuenta" FontWeight="SemiBold" />
                                        <TextBlock Text="Seguridad y preferencias" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="9"
                                               Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
