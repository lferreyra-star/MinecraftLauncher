<UserControl x:Class="XdLauncher.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="AboutKicker" TargetType="TextBlock" BasedOn="{StaticResource Kicker}" />
        <Style x:Key="AboutTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="AboutCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,4,20">
            <Border Style="{StaticResource Card}" Padding="22">
                <StackPanel>
                    <TextBlock Text="XD LAUNCHER" Style="{StaticResource AboutKicker}" Foreground="{DynamicResource AccentLightBrush}" />
                    <TextBlock Text="Una identidad propia para Minecraft" Style="{StaticResource AboutTitle}" Margin="0,8,0,0" />
                    <TextBlock Text="Diseño cinematográfico, autenticación real, mods en vivo y gestión integrada. Construido como una experiencia premium, no un menú clásico."
                               Style="{StaticResource BodyText}" Margin="0,8,0,0" MaxWidth="900" />
                    <TextBlock Text="{Binding LauncherVersion, StringFormat='v{0}'}" Style="{StaticResource StatLabel}" Margin="0,10,0,0" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text=" FIREBASE AUTH" Style="{StaticResource StatLabel}" />
                        <TextBlock Text="AWS S3 · DPAPI" Grid.Column="1" Style="{StaticResource StatLabel}" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="22" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="DATOS DEL SISTEMA" Style="{StaticResource SectionTitle}" />
                    <Border Style="{StaticResource InnerCard}" Padding="14" Margin="0,16,0,0">
                        <StackPanel>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="PROCESADOR" Style="{StaticResource StatLabel}" />
                                <TextBlock Text="{Binding State.SystemInfo.CpuName}" Grid.Column="1" TextWrapping="Wrap" />
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="GRÁFICOS" Style="{StaticResource StatLabel}" />
                                <TextBlock Text="{Binding State.SystemInfo.GpuName}" Grid.Column="1" TextWrapping="Wrap" />
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="MEMORIA" Style="{StaticResource StatLabel}" />
                                <TextBlock Grid.Column="1"><Run Text="{Binding State.SystemInfo.TotalRamText, Mode=OneWay}" /> <Run Text="·" /> <Run Text="{Binding State.SystemInfo.RamUsageText, Mode=OneWay}" /></TextBlock>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="WINDOWS" Style="{StaticResource StatLabel}" />
                                <TextBlock Text="{Binding State.SystemInfo.WindowsName}" Grid.Column="1" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="22" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="TÉCNICAS" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="WPF · .NET 10 · Firebase · Modrinth API · DPAPI · ADB / scrcpy · scrcpy."
                               Style="{StaticResource Caption}" Margin="0,8,0,0" />
                    <WrapPanel Margin="0,12,0,0">
                        <Border Style="{StaticResource Pill}" Margin="0,0,8,8"><TextBlock Text="WPF" /></Border>
                        <Border Style="{StaticResource Pill}" Margin="0,0,8,8"><TextBlock Text=".NET 10" /></Border>
                        <Border Style="{StaticResource Pill}" Margin="0,0,8,8"><TextBlock Text="Firebase" /></Border>
                        <Border Style="{StaticResource Pill}" Margin="0,0,8,8"><TextBlock Text="Modrinth API" /></Border>
                        <Border Style="{StaticResource Pill}" Margin="0,0,8,8"><TextBlock Text="DPAPI" /></Border>
                        <Border Style="{StaticResource Pill}" Margin="0,0,8,8"><TextBlock Text="ADB / scrcpy" /></Border>
                    </WrapPanel>
                    <TextBlock Text="Las integraciones usan servicios reales. No se muestran métricas estimadas."
                               Style="{StaticResource Caption}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="22" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="HISTORIAL" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="1.3.7 · Versión actual del launcher." Style="{StaticResource Caption}" Margin="0,10,0,0" />
                    <TextBlock Text="1.3.6 · Transferencia de sesión desde la web y móvil." Style="{StaticResource Caption}" Margin="0,6,0,0" />
                    <TextBlock Text="1.3.5 · Autenticación con cuenta de XD Launcher." Style="{StaticResource Caption}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="22" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="CRÉDITOS Y ENLACES" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="XD Launcher es un proyecto no oficial. No está afiliado a Mojang Studios ni Microsoft. Minecraft es una marca de Mojang AB. Minecraft Marketplace es una vía de distribución y muchos vendedores. Este launcher no vende ni compra nada, solo proporciona esta vía para lanzar aplicaciones."
                               Style="{StaticResource BodyText}" MaxWidth="900" />
                    <WrapPanel Margin="0,14,0,0">
                        <Button Content="Sitio oficial de Minecraft" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Command="{Binding State.OpenAboutLinkCommand}" />
                        <Button Content="Abrir README" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Command="{Binding OpenReadmeCommand}" />
                        <Button Content="Copiar diagnóstico" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Command="{Binding CopyDiagnosticsCommand}" />
                        <Button Content="Abrir registros" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Command="{Binding OpenLogsCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="22" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="LICENCIA Y AVISOS" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="XD Launcher respeta las licencias de Minecraft, los términos de la cuenta de acceso de Mojang y los servicios de Firebase y Modrinth. No distribuye archivos del juego ni crea modificaciones del juego. La criptografía de DPAPI no exporta ni comparte las claves fuera del equipo del usuario."
                               Style="{StaticResource BodyText}" MaxWidth="900" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
