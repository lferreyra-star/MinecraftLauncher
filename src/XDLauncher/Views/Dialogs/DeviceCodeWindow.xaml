<Window x:Class="XdLauncher.Views.Dialogs.DeviceCodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Iniciar sesión con Microsoft"
        Width="580"
        Height="520"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Border Background="{DynamicResource SurfaceStrongBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Effect="{StaticResource CardShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Background="Transparent" Padding="24,20,14,8" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Inicia sesión con Microsoft" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="21" FontWeight="SemiBold" />
                        <TextBlock Text="Se usa el flujo oficial de código de dispositivo. Nunca escribas tu contraseña aquí."
                                   Style="{StaticResource Muted}" Margin="0,4,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="&#xE711;" Style="{StaticResource IconButton}"
                            VerticalAlignment="Top" Click="Cancel_Click" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="24,10,24,10">
                <Border Style="{StaticResource InnerCard}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="1. Abre la página de Microsoft" Style="{StaticResource Caption}" />
                        <TextBlock x:Name="LinkText" FontSize="13" FontWeight="SemiBold" Margin="0,5,0,0" />
                        <TextBlock Text="2. Introduce este código" Style="{StaticResource Caption}" Margin="0,18,0,0" />
                        <Border Background="{DynamicResource SurfaceStrongBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="18,12" Margin="0,8,0,0"
                                HorizontalAlignment="Left">
                            <TextBlock x:Name="UserCodeText" FontFamily="Consolas" FontSize="30"
                                       FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                        </Border>
                        <TextBlock x:Name="CodeMessageText" Style="{StaticResource Muted}" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Content="Abrir página de Microsoft" Style="{StaticResource PrimaryButton}"
                            Click="OpenBrowser_Click" />
                    <Button Content="Copiar código" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"
                            Click="CopyCode_Click" />
                </StackPanel>

                <StackPanel x:Name="ProgressPanel" Margin="0,22,0,0">
                    <TextBlock x:Name="StatusText" FontSize="13" FontWeight="SemiBold"
                               Text="Esperando a que completes el inicio de sesión…" />
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,10,0,0" />
                    <TextBlock Text="Puedes cerrar esta ventana para cancelar. El launcher no recibe tu contraseña."
                               Style="{StaticResource Caption}" Margin="0,10,0,0" />
                </StackPanel>

                <Border x:Name="ErrorPanel" Visibility="Collapsed" Margin="0,18,0,0"
                        Background="{DynamicResource ChipBrush}" BorderBrush="{DynamicResource ErrorBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="14">
                    <StackPanel>
                        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ErrorBrush}" FontSize="12" />
                        <Button x:Name="RetryButton" Content="Reintentar" Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Left" Margin="0,12,0,0" Click="Retry_Click" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Grid.Row="2" Background="{DynamicResource ChipBrush}" CornerRadius="0,0,16,16" Padding="24,14">
                <Grid>
                    <TextBlock Text="Microsoft identity platform · Xbox Live" Style="{StaticResource Caption}"
                               VerticalAlignment="Center" />
                    <Button Content="Cancelar" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                            Click="Cancel_Click" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
