<Window x:Class="XdLauncher.Views.Dialogs.CommandPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Buscar"
        Width="640"
        Height="520"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Border Background="{DynamicResource SurfaceStrongBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="18"
            Effect="{StaticResource CardShadow}">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource InnerCard}" Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="16"
                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBox x:Name="SearchBox" Grid.Column="1" Margin="10,0,0,0" BorderThickness="0"
                             Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"
                             FontSize="15" VerticalContentAlignment="Center" ToolTip="Busca una sección o acción"
                             TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown" />
                </Grid>
            </Border>

            <ListBox x:Name="Results" Grid.Row="1" Margin="0,12,0,0" Background="Transparent"
                     BorderThickness="0" MouseDoubleClick="Results_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="Transparent" Padding="10,8" CornerRadius="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource AccentSoftBrush}">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="14"
                                               Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" />
                                </StackPanel>
                                <Border Grid.Column="2" Style="{StaticResource Pill}" Padding="8,3">
                                    <TextBlock Text="{Binding Group}" FontSize="10" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Grid.Row="2" Text="↑↓ navegar · Enter abrir · Esc cerrar" Style="{StaticResource Caption}"
                       Margin="0,12,0,0" />
        </Grid>
    </Border>
</Window>
