<Window x:Class="XdLauncher.Views.Dialogs.VerificationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:XdLauncher.Models"
        Title="Verificación de Minecraft"
        Width="640"
        Height="660"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Border Background="{DynamicResource SurfaceStrongBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Effect="{StaticResource CardShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Background="Transparent" Padding="22,18,12,8" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="SummaryBadge" Width="42" Height="42" CornerRadius="12"
                            Background="{DynamicResource ChipBrush}">
                        <TextBlock x:Name="SummaryGlyph" FontFamily="{StaticResource IconFont}" FontSize="19"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="Verificación de la instalación" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock x:Name="SummaryText" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="&#xE711;" Style="{StaticResource IconButton}" Click="Close_Click" />
                </Grid>
            </Border>

            <TextBlock x:Name="CheckedText" Grid.Row="1" Style="{StaticResource Caption}" Margin="22,0,22,12" />

            <ScrollViewer Grid.Row="2" Margin="22,0,14,0" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ItemsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource InnerCard}" Margin="0,0,8,8" Padding="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="StateBadge" Width="32" Height="32" CornerRadius="9"
                                            Background="{DynamicResource ChipStrongBrush}" VerticalAlignment="Top">
                                        <TextBlock x:Name="StateGlyph" FontFamily="{StaticResource IconFont}" FontSize="14"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="{x:Static models:VerificationState.Ok}">
                                    <Setter TargetName="StateGlyph" Property="Text" Value="&#xE73E;" />
                                    <Setter TargetName="StateGlyph" Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="{x:Static models:VerificationState.Warning}">
                                    <Setter TargetName="StateGlyph" Property="Text" Value="&#xE7BA;" />
                                    <Setter TargetName="StateGlyph" Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="{x:Static models:VerificationState.Error}">
                                    <Setter TargetName="StateGlyph" Property="Text" Value="&#xEA39;" />
                                    <Setter TargetName="StateGlyph" Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="{x:Static models:VerificationState.Unknown}">
                                    <Setter TargetName="StateGlyph" Property="Text" Value="&#xE946;" />
                                    <Setter TargetName="StateGlyph" Property="Foreground" Value="{DynamicResource InfoBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="3" Background="{DynamicResource ChipBrush}" CornerRadius="0,0,16,16"
                    Padding="22,14" Margin="0,12,0,0">
                <Grid>
                    <TextBlock Text="El launcher solo consulta APIs oficiales de Windows. No modifica el juego."
                               Style="{StaticResource Caption}" VerticalAlignment="Center" />
                    <Button Content="Cerrar" Style="{StaticResource PrimaryButton}" MinWidth="120"
                            HorizontalAlignment="Right" Click="Close_Click" IsDefault="True" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
