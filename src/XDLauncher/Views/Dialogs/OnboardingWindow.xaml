<Window x:Class="XdLauncher.Views.Dialogs.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Primer inicio"
        Width="760"
        Height="540"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">
    <Border Background="{DynamicResource SurfaceStrongBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="20"
            Effect="{StaticResource CardShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="HeaderBar" Margin="26,22,26,0" MouseLeftButtonDown="HeaderBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal">
                    <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}">
                        <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" FontSize="20"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="BIENVENIDO A XD LAUNCHER" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="StepLabel" Text="Empecemos con lo básico" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="StepCounter" Text="PASO 1 DE 3" Style="{StaticResource Kicker}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <Grid Grid.Row="1" Margin="26,22,26,8">
                <Grid x:Name="LanguageStep">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="TU IDIOMA" Style="{StaticResource Kicker}" />
                        <TextBlock Text="Elige cómo quieres ver el launcher." FontSize="20"
                                   FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" Margin="0,10,0,0" />
                        <ComboBox x:Name="LanguageCombo" Width="280" Margin="0,24,0,0" SelectedIndex="0">
                            <ComboBoxItem Content="Español" />
                            <ComboBoxItem Content="English" />
                        </ComboBox>
                        <TextBlock Text="Podrás cambiar el idioma más adelante desde Ajustes." Style="{StaticResource Caption}"
                                   Margin="0,12,0,0" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="AccountStep" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="TU CUENTA" Style="{StaticResource Kicker}" />
                        <TextBlock Text="Todo listo, tu sesión está protegida." FontSize="20"
                                   FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" Margin="0,10,0,0" />
                        <Border Style="{StaticResource InnerCard}" Padding="18" Margin="0,24,0,0" HorizontalAlignment="Left" MinWidth="360">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource SuccessSoftBrush}">
                                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="20"
                                               Foreground="{DynamicResource SuccessBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="AccountName" Text="Jugador" FontWeight="SemiBold" />
                                    <TextBlock Text="Sesión XD verificada · Cuenta Microsoft opcional para Java"
                                               Style="{StaticResource Caption}" Margin="0,4,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid x:Name="PlatformStep" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="TU PRIMER DESTINO" Style="{StaticResource Kicker}" />
                        <TextBlock Text="¿Por dónde querés empezar?" FontSize="20"
                                   FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" Margin="0,10,0,0" />
                        <ComboBox x:Name="InitialPlatformCombo" Width="320" Margin="0,24,0,0" SelectedIndex="0">
                            <ComboBoxItem Content="Minecraft Java" />
                            <ComboBoxItem Content="Minecraft Bedrock" />
                            <ComboBoxItem Content="Centro de Mods" />
                        </ComboBox>
                        <TextBlock Text="Siempre podrás cambiar de sección desde la navegación principal."
                                   Style="{StaticResource Caption}" Margin="0,12,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid Grid.Row="2" Margin="26,8,26,24">
                <Button x:Name="BackButton" Content="Atrás" Style="{StaticResource GhostButton}" Width="110"
                        HorizontalAlignment="Left" Click="Back_Click" />
                <Button x:Name="NextButton" Content="Continuar" Style="{StaticResource PrimaryButton}" Width="160"
                        HorizontalAlignment="Right" Click="Next_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
