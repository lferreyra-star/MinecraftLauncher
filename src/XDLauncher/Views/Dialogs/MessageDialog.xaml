<Window x:Class="XdLauncher.Views.Dialogs.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XD Launcher"
        Width="470"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Border Background="{DynamicResource SurfaceStrongBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Effect="{StaticResource CardShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="HeaderBar" Background="Transparent" Padding="22,18,12,8"
                    MouseLeftButtonDown="HeaderBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="IconBadge" Width="38" Height="38" CornerRadius="11"
                            Background="{DynamicResource ChipBrush}" VerticalAlignment="Center">
                        <TextBlock x:Name="IconGlyph" FontFamily="{StaticResource IconFont}" FontSize="17"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="TitleText" Grid.Column="1" Margin="14,0,8,0"
                               FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Content="&#xE711;" Style="{StaticResource IconButton}"
                            Click="Cancel_Click" />
                </Grid>
            </Border>

            <TextBlock x:Name="MessageText" Grid.Row="1" Margin="22,6,22,22"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"
                       LineHeight="20" TextWrapping="Wrap" />

            <Border Grid.Row="2" Background="{DynamicResource ChipBrush}" CornerRadius="0,0,16,16" Padding="22,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Content="Cancelar" Style="{StaticResource SecondaryButton}"
                            Margin="0,0,10,0" MinWidth="104" Click="Cancel_Click" />
                    <Button x:Name="ConfirmButton" Content="Entendido" Style="{StaticResource PrimaryButton}"
                            MinWidth="120" Click="Confirm_Click" IsDefault="True" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
