<UserControl x:Class="XdLauncher.Views.GameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:XdLauncher.Models">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="0,0,4,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <Border Style="{StaticResource HeroBanner}" Height="164" Margin="0,0,0,14">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding DataContext.CurrentBackgroundPath, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ImagePath}}"
                                    Stretch="UniformToFill" />
                    </Border.Background>
                    <Grid>
                        <Border Style="{StaticResource HeroOverlay}" />
                    <StackPanel Margin="26" VerticalAlignment="Bottom">
                        <TextBlock Text="BEDROCK EDITION" Style="{StaticResource Kicker}" />
                        <TextBlock Text="Estado del juego" Style="{StaticResource HeroTitle}" FontSize="28" Margin="0,6,0,0" />
                        <TextBlock Text="Instalación, componentes, archivos y lanzamiento de Minecraft desde Microsoft Store." Style="{StaticResource BodyText}" MaxWidth="620" Margin="0,4,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Border Style="{StaticResource Pill}" Margin="0,0,8,0">
                            <TextBlock Text="{Binding VersionLabel}" FontSize="10" FontWeight="SemiBold" />
                        </Border>
                        <Border Style="{StaticResource Pill}" Margin="0,0,8,0">
                            <TextBlock Text="{Binding ChannelLabel}" FontSize="10" FontWeight="SemiBold" />
                        </Border>
                        </StackPanel>
                    </StackPanel>
                                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Padding="22">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="54" Height="54" CornerRadius="16"
                                        Background="{DynamicResource ChipBrush}"
                                        BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1">
                                    <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" FontSize="26"
                                               Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="16,0,0,0">
                                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource PageTitle}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Border Style="{StaticResource Pill}" Margin="0,0,8,0"><TextBlock Text="{Binding VersionLabel}" FontSize="11" FontWeight="SemiBold" /></Border>
                                        <Border Style="{StaticResource Pill}" Margin="0,0,8,0"><TextBlock Text="{Binding ChannelLabel}" FontSize="11" FontWeight="SemiBold" /></Border>
                                        <Border Style="{StaticResource Pill}" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" Margin="0,1,6,0" />
                                                <TextBlock Text="{Binding StatusHeadline}" FontSize="11" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource BodyText}" Margin="0,14,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button Style="{StaticResource PrimaryButton}" Height="52" Width="230"
                                    Command="{Binding LaunchCommand}"
                                    Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding PlayGlyph}" FontFamily="{StaticResource IconFont}" FontSize="16" Margin="0,1,10,0" />
                                    <TextBlock Text="{Binding PlayLabel}" FontSize="14" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}" Height="52" Width="230" Margin="0,10,0,0"
                                    Content="Instalar desde Store" Command="{Binding OpenStoreCommand}"
                                    Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                            <Button Style="{StaticResource SecondaryButton}" Height="52" Width="230" Margin="0,10,0,0"
                                    Content="Verificar" Command="{Binding VerifyCommand}"
                                    Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="18">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,18,0">
                            <UniformGrid Columns="4" Margin="0,14,0,0">
                                <Border Style="{StaticResource InnerCard}" Margin="0,0,6,0" Padding="10">
                                    <StackPanel><TextBlock Style="{StaticResource Caption}" Text="VERSIÓN" /><TextBlock Text="{Binding VersionLabel}" FontWeight="SemiBold" /></StackPanel>
                                </Border>
                                <Border Style="{StaticResource InnerCard}" Margin="0,0,6,0" Padding="10">
                                    <StackPanel><TextBlock Style="{StaticResource Caption}" Text="CANAL" /><TextBlock Text="{Binding ChannelLabel}" FontWeight="SemiBold" /></StackPanel>
                                </Border>
                                <Border Style="{StaticResource InnerCard}" Margin="0,0,6,0" Padding="10">
                                    <StackPanel><TextBlock Style="{StaticResource Caption}" Text="INSTALADA" /><TextBlock Text="{Binding InstallDateLabel}" FontWeight="SemiBold" /></StackPanel>
                                </Border>
                                <Border Style="{StaticResource InnerCard}" Margin="0,0,0,0" Padding="10">
                                    <StackPanel><TextBlock Style="{StaticResource Caption}" Text="STATUS" /><TextBlock Text="{Binding PackageStatusLabel}" FontWeight="SemiBold" /></StackPanel>
                                </Border>
                            </UniformGrid>
                            <Border Style="{StaticResource InnerCard}" Padding="10" Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ComponentsSummary}" />
                                    <Button Content="Reparar" Style="{StaticResource GhostButton}" Margin="12,0,0,0"
                                            Command="{Binding OpenUpdatesCommand}"
                                            Visibility="{Binding HasMissingComponents, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Caption}" Margin="0,10,0,0" />
                            <TextBlock Text="{Binding LastCheckLabel}" Style="{StaticResource Caption}" />
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource InnerCard}" Padding="14" VerticalAlignment="Stretch">
                            <StackPanel>
                                <TextBlock Text="DETALLES DEL PAQUETE" Style="{StaticResource SectionTitle}" />
                                <WrapPanel Margin="0,12,0,0">
                                    <TextBlock Text="PackageFullName: " Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding Selected.PackageFullName}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                                </WrapPanel>
                                <WrapPanel Margin="0,6,0,0">
                                    <TextBlock Text="Editor: " Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding Selected.Publisher}" Style="{StaticResource Caption}" />
                                </WrapPanel>
                                <WrapPanel Margin="0,6,0,0">
                                    <TextBlock Text="Arquitectura: " Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding Selected.Architecture}" Style="{StaticResource Caption}" />
                                </WrapPanel>
                                <WrapPanel Margin="0,6,0,0">
                                    <TextBlock Text="SignatureKind: " Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding Selected.SignatureKind}" Style="{StaticResource Caption}" />
                                </WrapPanel>
                                <Button Content="Copiar info" Style="{StaticResource GhostButton}" Margin="0,10,0,0"
                                        Command="{Binding CopyVersionCommand}" />
                                <Button Content="Abrir carpeta" Style="{StaticResource GhostButton}" Margin="0,0,0,6"
                                        Command="{Binding OpenInstallFolderCommand}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,14,0,0"
                        Visibility="{Binding HasMissingComponents, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource ErrorSoftBrush}">
                                <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                           Foreground="{DynamicResource ErrorBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Componentes de Minecraft faltantes" Style="{StaticResource CardTitle}" Margin="10,0,0,0" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Selected.Components}" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource InnerCard}" Margin="0,0,0,8" Padding="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                                       Foreground="{DynamicResource ErrorBrush}" Margin="0,0,10,0" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="Instalar" Style="{StaticResource PrimaryButton}"
                                                    Command="{Binding DataContext.RepairComponentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
