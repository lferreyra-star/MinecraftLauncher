<UserControl x:Class="XdLauncher.Views.GameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:XdLauncher.Models">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,6,28">

            <!-- Main installation card -->
            <Border Style="{StaticResource Card}" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="64" Height="64" CornerRadius="18" Background="{DynamicResource AccentSoftBrush}"
                                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                            <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" FontSize="28"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="18,0,18,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource PageTitle}" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Border Style="{StaticResource Pill}" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding VersionLabel}" FontSize="11" FontWeight="SemiBold" />
                                </Border>
                                <Border Style="{StaticResource Pill}" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding ChannelLabel}" FontSize="11" FontWeight="SemiBold" />
                                </Border>
                                <Border Style="{StaticResource Pill}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                                   Foreground="{DynamicResource SuccessBrush}" Margin="0,1,5,0"
                                                   Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{Binding StatusHeadline}" FontSize="11" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource Muted}" Margin="0,10,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <Button Style="{StaticResource PrimaryButton}" Height="46" MinWidth="170"
                                    Command="{Binding LaunchCommand}"
                                    Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding PlayGlyph}" FontFamily="{StaticResource IconFont}"
                                               FontSize="14" Margin="0,1,9,0" />
                                    <TextBlock Text="{Binding PlayLabel}" FontSize="14" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PrimaryButton}" Height="46" MinWidth="190" Content="Instalar desde Store"
                                    Command="{Binding OpenStoreCommand}"
                                    Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="VERSIÓN" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding VersionLabel}" FontWeight="SemiBold" FontSize="14" Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="CANAL" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding ChannelLabel}" FontWeight="SemiBold" FontSize="14" Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,12,0">
                            <TextBlock Text="FECHA DE INSTALACIÓN" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding InstallDateLabel}" FontWeight="SemiBold" FontSize="14" Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="ESTADO DEL PAQUETE" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding PackageStatusLabel}" FontWeight="SemiBold" FontSize="14" Margin="0,5,0,0" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,20,0,0">
                        <Button Content="Verificar instalación" Style="{StaticResource SecondaryButton}"
                                Command="{Binding VerifyCommand}"
                                Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="Carpeta del juego" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                Command="{Binding OpenInstallFolderCommand}" />
                        <Button Content="Datos de Minecraft" Style="{StaticResource GhostButton}" Margin="4,0,0,0"
                                Command="{Binding OpenUserDataFolderCommand}" />
                        <Button Content="Microsoft Store" Style="{StaticResource GhostButton}" Margin="4,0,0,0"
                                Command="{Binding OpenStoreCommand}" />

                        <ComboBox ItemsSource="{Binding Installations}" SelectedItem="{Binding Selected}"
                                  Width="210" HorizontalAlignment="Right"
                                  Margin="12,0,0,0"
                                  Visibility="{Binding HasMultipleChannels, Converter={StaticResource BoolToVisibility}}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Not installed notice -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0"
                    Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                <StackPanel Orientation="Horizontal">
                    <Border Width="48" Height="48" CornerRadius="14" Background="{DynamicResource ChipBrush}">
                        <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="20"
                                   Foreground="{DynamicResource InfoBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Necesitas una instalación oficial de Minecraft" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="El launcher detecta automáticamente Minecraft: Bedrock Edition y Minecraft Preview instalados desde Microsoft Store. No descarga el juego ni omite la licencia."
                                   Style="{StaticResource Muted}" Margin="0,4,0,0" MaxWidth="760" HorizontalAlignment="Left" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Update -->
            <Border Margin="0,14,0,0"
                    Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="46" Height="46" CornerRadius="13" Background="{DynamicResource ChipBrush}">
                            <TextBlock x:Name="UpdateGlyph" Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="19"
                                       Foreground="{DynamicResource InfoBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                            <TextBlock x:Name="UpdateTitle" Text="{Binding UpdateStatus}" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{Binding UpdateDetail}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Actualizar en Store" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding OpenUpdatesCommand}"
                                    Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}" />
                            <Button Content="Abrir Store" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding OpenStoreCommand}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding LastCheckLabel}" Style="{StaticResource Caption}"
                               Margin="62,10,0,0" />
                </Grid>
            </Border>

            <!-- Components -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0"
                    Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Componentes oficiales" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding ComponentsSummary}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Content="Reparar desde Store" Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Command="{Binding OpenUpdatesCommand}" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Selected.Components}" Margin="0,14,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource InnerCard}" Margin="0,0,0,8" Padding="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="34" Height="34" CornerRadius="10"
                                                Background="{DynamicResource ChipStrongBrush}" VerticalAlignment="Top">
                                            <TextBlock x:Name="ComponentGlyph" Text="{Binding IconGlyph}"
                                                       FontFamily="{StaticResource IconFont}" FontSize="14"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="12,0,12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                                                <Border Background="{DynamicResource ChipBrush}" CornerRadius="10"
                                                        Padding="7,2" Margin="8,0,0,0">
                                                    <TextBlock x:Name="StateLabel" Text="{Binding StateLabel}" FontSize="10"
                                                               FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}"
                                                       Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding Version, StringFormat='Versión {0}'}"
                                                       Style="{StaticResource Caption}" Margin="0,4,0,0"
                                                       Visibility="{Binding Version, Converter={StaticResource StringToVisibility}}" />
                                        </StackPanel>

                                        <Button Grid.Column="2" Content="Instalar" Style="{StaticResource SecondaryButton}"
                                                VerticalAlignment="Center" Padding="14,7"
                                                Command="{Binding DataContext.RepairComponentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding CanInstall, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="{x:Static models:ComponentState.Installed}">
                                        <Setter TargetName="ComponentGlyph" Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                        <Setter TargetName="StateLabel" Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="{x:Static models:ComponentState.Missing}">
                                        <Setter TargetName="ComponentGlyph" Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                        <Setter TargetName="StateLabel" Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Package details -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0"
                    Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Detalles del paquete" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Margin="0,0,16,12">
                            <TextBlock Text="NOMBRE COMPLETO DEL PAQUETE" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding Selected.PackageFullName}" FontSize="12" Margin="0,4,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,0,12">
                            <TextBlock Text="EDITOR" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding Selected.Publisher}" FontSize="12" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,0,16,12">
                            <TextBlock Text="ARQUITECTURA" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding Selected.Architecture}" FontSize="12" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1">
                            <TextBlock Text="TIPO DE FIRMA" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding Selected.SignatureKind}" FontSize="12" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,4">
                            <TextBlock Text="UBICACIÓN" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding Selected.InstallLocation}" FontSize="12" Margin="0,4,0,0"
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Copiar versión" Style="{StaticResource GhostButton}"
                                Command="{Binding CopyVersionCommand}" />
                        <Button Content="Abrir carpeta" Style="{StaticResource GhostButton}" Margin="4,0,0,0"
                                Command="{Binding OpenInstallFolderCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
