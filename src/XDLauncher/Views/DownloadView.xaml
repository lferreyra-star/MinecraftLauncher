<UserControl x:Class="XdLauncher.Views.DownloadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="0,0,4,20" HorizontalAlignment="Stretch" MaxWidth="1400">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <Border Style="{StaticResource HeroBanner}" Height="164" Margin="0,0,0,14">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding DataContext.CurrentBackgroundPath, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ImagePath}}"
                                    Stretch="UniformToFill" />
                    </Border.Background>
                    <Grid>
                        <Border Style="{StaticResource HeroOverlay}" />
                    <StackPanel Margin="26" VerticalAlignment="Bottom">
                        <TextBlock Text="CENTRO DE DESCARGAS" Style="{StaticResource Kicker}" />
                        <TextBlock Text="Descargas y herramientas" Style="{StaticResource HeroTitle}" FontSize="28" Margin="0,6,0,0" />
                        <TextBlock Text="Progreso real, verificación de hashes y acceso directo a las fuentes oficiales." Style="{StaticResource BodyText}" MaxWidth="620" Margin="0,4,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Border Style="{StaticResource Pill}" Margin="0,0,8,0">
                            <TextBlock FontSize="10" FontWeight="SemiBold"><Run Text="{Binding ActiveDownloads, Mode=OneWay}" /><Run Text=" descargas activas" /></TextBlock>
                        </Border>
                        </StackPanel>
                    </StackPanel>
                                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Padding="22">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="DESCARGAS" Style="{StaticResource Kicker}" />
                            <TextBlock Text="Descarga e instala Minecraft y las herramientas oficiales. El launcher verifica hashes, rutas y estado antes de cada acción." Style="{StaticResource BodyText}" Margin="0,4,0,0" />
                            <Grid Margin="0,12,0,0">
                                <TextBlock Text="{Binding ActiveDownloads}" Style="{StaticResource StatValue}" FontSize="20" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="ACTIVAS" Style="{StaticResource StatLabel}" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button Content="Actualizar" Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}" />
                            <Button Content="Cancelar todo" Style="{StaticResource DangerButton}" Margin="4,0,0,0" Command="{Binding CancelAllCommand}" Visibility="{Binding IsAnyDownloading, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource InputTextBox}" Width="320" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox Grid.Column="1" Width="260" ItemsSource="{Binding Categories}" SelectedItem="{Binding FilterCategory}" />
                    </Grid>
                    <TextBlock Text="Descargas activas / completadas" Style="{StaticResource Caption}" Grid.Column="1" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>

            <ItemsControl Grid.Row="1" ItemsSource="{Binding VisibleItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource ChipBrush}">
                                    <TextBlock Text="{Binding IconGlyph}" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Border Style="{StaticResource Pill}"><TextBlock Text="{Binding CategoryLabel}" FontSize="10" /></Border>
                                        <TextBlock Style="{StaticResource Caption}" Margin="8,0,0,0"><Run Text="· " /><Run Text="{Binding SizeLabel, Mode=OneWay}" /></TextBlock>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource BodyText}" Margin="0,4,0,0" MaxHeight="42" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Style="{StaticResource Pill}">
                                        <TextBlock Text="{Binding StateLabel}" FontWeight="SemiBold"
                                                   Foreground="{Binding State, Converter={StaticResource StateToColor}}" />
                                    </Border>
                                    <ProgressBar Visibility="{Binding State, Converter={StaticResource DownloadStateToVisibility}, ConverterParameter=Downloading}"
                                                 Value="{Binding ProgressPercent, Mode=OneWay}" Height="6" Margin="10,0,0,0" Width="160"
                                                 Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource ProgressTrackBrush}" />
                                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Caption}" Margin="6,0,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Descargar" Style="{StaticResource PrimaryButton}" Padding="10,7" FontSize="11" Margin="0,0,6,0"
                                            Command="{Binding DataContext.StartDownloadCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding CanDownload, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Content="Tienda" Style="{StaticResource SecondaryButton}" Padding="8,7" FontSize="11" Margin="0,0,6,0"
                                            Command="{Binding DataContext.OpenStoreCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding CanOpenStore, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Content="Cancelar" Style="{StaticResource DangerButton}" Padding="8,7" FontSize="11" Margin="0,0,6,0"
                                            Command="{Binding DataContext.CancelDownloadCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Content="Reintentar" Style="{StaticResource GhostButton}" Padding="8,7" FontSize="11" Margin="0,0,6,0"
                                            Command="{Binding DataContext.RetryDownloadCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding State, Converter={StaticResource DownloadStateToVisibility}, ConverterParameter=FailedOrCancelled}" />
                                    <Button Content="Abrir archivo" Style="{StaticResource GhostButton}" Padding="8,7" FontSize="11" Margin="0,0,6,0"
                                            Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding State, Converter={StaticResource DownloadStateToVisibility}, ConverterParameter=CompletedOrReady}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </ScrollViewer>
</UserControl>
