<UserControl x:Class="XdLauncher.Views.DownloadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:XdLauncher.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,6,28">

            <!-- Header -->
            <Border Style="{StaticResource Card}" Padding="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Width="64" Height="64" CornerRadius="18" Background="{DynamicResource ChipBrush}">
                        <TextBlock Text="&#xE893;" FontFamily="{StaticResource IconFont}" FontSize="28"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Descargas" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="Descarga e instala Minecraft y las herramientas del launcher desde fuentes oficiales."
                                   Style="{StaticResource Muted}" Margin="0,4,0,0" MaxWidth="700" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Button Content="&#xE72C;  Actualizar" Style="{StaticResource GhostButton}"
                                Margin="0,0,10,0" Command="{Binding RefreshCommand}" />
                        <Button Content="Cancelar todo" Style="{StaticResource DangerButton}"
                                Command="{Binding CancelAllCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Stats -->
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource InnerCard}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="ACTIVAS" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding ActiveDownloads}" Style="{StaticResource StatValue}"
                                   Foreground="{DynamicResource AccentBrush}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource InnerCard}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="COMPLETADAS" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding CompletedDownloads}" Style="{StaticResource StatValue}"
                                   Foreground="{DynamicResource SuccessBrush}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource InnerCard}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="FALLIDAS" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding FailedDownloads}" Style="{StaticResource StatValue}"
                                   Foreground="{DynamicResource ErrorBrush}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource InnerCard}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="ELEMENTOS" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding TotalCount}" Style="{StaticResource StatValue}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Search & Filter -->
            <Border Style="{StaticResource Card}" Padding="20" Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Margin="0,0,12,0">
                        <TextBox Style="{StaticResource InputTextBox}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="34,9,12,9" />
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="12,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False" />
                        <TextBlock Text="Buscar descargas" Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center" Margin="34,0,0,0" IsHitTestVisible="False"
                                   FontSize="12"
                                   Visibility="{Binding SearchText, Converter={StaticResource StringToVisibility}, ConverterParameter=invert}" />
                    </Grid>

                    <ComboBox Grid.Column="1" ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding FilterCategory}" MinWidth="140">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
            </Border>

            <!-- Empty state -->
            <Border Style="{StaticResource Card}" Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                <StackPanel HorizontalAlignment="Center" Margin="40">
                    <Border Width="72" Height="72" CornerRadius="20" Background="{DynamicResource ChipBrush}"
                            HorizontalAlignment="Center">
                        <TextBlock Text="&#xE893;" FontFamily="{StaticResource IconFont}" FontSize="30"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="No hay descargas disponibles" Style="{StaticResource SectionTitle}"
                               HorizontalAlignment="Center" Margin="0,14,0,0" />
                    <TextBlock Text="No se pudo cargar la lista de descargas. Intenta actualizar."
                               Style="{StaticResource Muted}" HorizontalAlignment="Center" MaxWidth="500"
                               Margin="0,6,0,0" />
                    <Button Content="Actualizar" Style="{StaticResource PrimaryButton}"
                            Command="{Binding RefreshCommand}" Margin="0,18,0,0" />
                </StackPanel>
            </Border>

            <!-- Download list -->
            <ItemsControl ItemsSource="{Binding VisibleItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Icon -->
                                <Border Grid.Column="0" Width="52" Height="52" CornerRadius="14"
                                        Background="{DynamicResource ChipBrush}"
                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Grid>
                                        <TextBlock Text="{Binding IconGlyph}" FontFamily="{StaticResource IconFont}"
                                                   FontSize="20" Foreground="{DynamicResource AccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <!-- Info -->
                                <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Border Grid.Column="1" Style="{StaticResource Pill}"
                                                Margin="8,0,0,0" Padding="6,2">
                                            <TextBlock Text="{Binding CategoryLabel}" FontSize="9" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}"
                                               Margin="0,3,0,0" MaxWidth="420" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="{Binding SizeLabel}" Style="{StaticResource Caption}" />
                                        <TextBlock Text="·" Style="{StaticResource Caption}" Margin="6,0" />
                                        <TextBlock Text="{Binding StateLabel}" Style="{StaticResource Caption}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding State, Converter={StaticResource StateToColor}}" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Progress -->
                                <Border Grid.Column="2" Width="220" VerticalAlignment="Center"
                                        Visibility="{Binding State, Converter={StaticResource DownloadStateToVisibility}, ConverterParameter=Downloading}">
                                    <StackPanel>
                                        <ProgressBar Value="{Binding ProgressPercent}" Height="6"
                                                     Foreground="{DynamicResource AccentBrush}"
                                                     Background="{DynamicResource BorderBrush}"
                                                     IsIndeterminate="{Binding IsIndeterminate}" />
                                        <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Caption}"
                                                   Margin="0,4,0,0" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- Actions -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal"
                                            HorizontalAlignment="Right" VerticalAlignment="Center">

                                    <!-- Download / Install from Store -->
                                    <Button Content="Descargar" Style="{StaticResource PrimaryButton}" Padding="12,7"
                                            FontSize="11" Margin="0,0,6,0"
                                            Visibility="{Binding CanDownload, Converter={StaticResource BoolToVisibility}}"
                                            Command="{Binding DataContext.StartDownloadCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />

                                    <Button Content="Tienda" Style="{StaticResource SecondaryButton}" Padding="10,7"
                                            FontSize="11" Margin="0,0,6,0"
                                            Visibility="{Binding CanOpenStore, Converter={StaticResource BoolToVisibility}}"
                                            Command="{Binding DataContext.OpenStoreCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />

                                    <!-- Cancel -->
                                    <Button Content="Cancelar" Style="{StaticResource DangerButton}" Padding="10,7"
                                            FontSize="11" Margin="0,0,6,0"
                                            Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}"
                                            Command="{Binding DataContext.CancelDownloadCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />

                                    <!-- Retry -->
                                    <Button Content="Reintentar" Style="{StaticResource GhostButton}" Padding="10,7"
                                            FontSize="11" Margin="0,0,6,0"
                                            Visibility="{Binding State, Converter={StaticResource DownloadStateToVisibility}, ConverterParameter=FailedOrCancelled}"
                                            Command="{Binding DataContext.RetryDownloadCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />

                                    <!-- Open file -->
                                    <Button Content="Abrir archivo" Style="{StaticResource GhostButton}" Padding="10,7"
                                            FontSize="11" Margin="0,0,6,0"
                                            Visibility="{Binding State, Converter={StaticResource DownloadStateToVisibility}, ConverterParameter=CompletedOrReady}"
                                            Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Note -->
            <Border Style="{StaticResource InnerCard}" Margin="0,4,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="14"
                               Foreground="{DynamicResource InfoBrush}" VerticalAlignment="Top" Margin="0,1,10,0" />
                    <TextBlock Style="{StaticResource Muted}" MaxWidth="900" HorizontalAlignment="Left"
                               Text="Minecraft: Bedrock Edition y Minecraft Preview se distribuyen exclusivamente a través de Microsoft Store. Pulsa «Tienda» para abrirlas en el canal oficial. ADB y scrcpy se descargan directamente desde Google y GitHub, verificados con sus checksums oficiales." />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>