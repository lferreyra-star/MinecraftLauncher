<Window x:Class="XdLauncher.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="XD Launcher · Acceso"
        Width="480" Height="760" MinWidth="380" MinHeight="520"
        WindowStyle="None" ResizeMode="NoResize"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <Style x:Key="LoginForm" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style x:Key="LoginField" TargetType="TextBox" BasedOn="{StaticResource InputTextBox}">
            <Setter Property="Height" Value="42" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
        <Style x:Key="PasswordField" TargetType="PasswordBox" BasedOn="{StaticResource InputPasswordBox}">
            <Setter Property="Height" Value="42" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
        <Style x:Key="LoginFieldIcon" TargetType="TextBox" BasedOn="{StaticResource LoginField}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="38" VerticalAlignment="Center">
                                <TextBlock Text="&#xE8C6;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ScrollViewer Grid.Column="1" x:Name="PART_ContentHost" Margin="8,0,8,0" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButtonLogin" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Height" Value="46" />
            <Setter Property="MinWidth" Value="220" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="StatusPill" TargetType="Border">
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="{DynamicResource ChipStrongBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,12,0,0" />
        </Style>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="8" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="RootLayout" ClipToBounds="True">
        <Border Background="{DynamicResource WindowBackgroundBrush}" />
        <Grid x:Name="ShellGrid">
            <Grid.ColumnDefinitions><ColumnDefinition Width="290" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

            <Border Background="{DynamicResource SurfaceStrongBrush}" ClipToBounds="True">
                <Grid Margin="26,26,26,26">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Border Width="70" Height="70" CornerRadius="20"
                            Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1">
                        <Image Source="/Assets/logo.png" Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <TextBlock Text="XD LAUNCHER" Style="{StaticResource DisplayHero}" FontSize="38" />
                        <TextBlock Text="{Binding ModeTitle}" Style="{StaticResource HeroTitle}" FontSize="26" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding ModeSubtitle}" Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Margin="0,20,0,0">
                        <TextBlock Text="TECNOLOGÍAS" Style="{StaticResource Kicker}" />
                        <WrapPanel Margin="0,8,0,0">
                            <Border Style="{StaticResource Pill}" Margin="0,0,6,6"><TextBlock Text="Firebase" /></Border>
                            <Border Style="{StaticResource Pill}" Margin="0,0,6,6"><TextBlock Text="Mojang API" /></Border>
                            <Border Style="{StaticResource Pill}" Margin="0,0,6,6"><TextBlock Text="DPAPI" /></Border>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="26" Margin="0,10,0,10">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,20,0,20">
                    <StackPanel Width="400">
                        <TextBlock Text="{Binding ModeTitle}" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="{Binding ModeSubtitle}" Style="{StaticResource BodyText}" Margin="0,10,0,0" />
                        <Border Style="{StaticResource StatusPill}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" Margin="0,2,6,0" />
                                <TextBlock Text="{Binding ServerStatusLabel}" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </Border>

                        <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" Margin="0,16,0,0">
                            <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource Caption}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <ProgressBar IsIndeterminate="True" Height="6" Margin="0,6,0,0"
                                         Foreground="{DynamicResource AccentBrush}"
                                         Background="{DynamicResource ChipStrongBrush}" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" Margin="0,16,0,0">
                            <Border Background="{DynamicResource ErrorSoftBrush}" BorderBrush="{DynamicResource ErrorBrush}"
                                    BorderThickness="1" CornerRadius="11" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE90A;" FontFamily="{StaticResource IconFont}" FontSize="18"
                                               Foreground="{DynamicResource ErrorBrush}" />
                                    <TextBlock x:Name="ErrorText" Text="{Binding ErrorMessage}" Grid.Column="1" Margin="10,0,0,0"
                                               Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel Visibility="{Binding HasInfo, Converter={StaticResource BoolToVisibility}}" Margin="0,16,0,0">
                            <TextBlock Text="{Binding InfoMessage}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Style="{StaticResource LoginForm}">
                            <StackPanel>
                                <TextBlock Text="CORREO" Style="{StaticResource Caption}" />
                                <TextBox x:Name="EmailBox" Style="{StaticResource LoginFieldIcon}"
                                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="CONTRASEÑA" Style="{StaticResource Caption}" />
                                <Grid Margin="0,4,0,0">
                                    <PasswordBox x:Name="SecretBox" Style="{StaticResource PasswordField}"
                                                 PasswordChanged="SecretBox_PasswordChanged" />
                                    <Button x:Name="TogglePassword" HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Style="{StaticResource IconButton}" Content="&#xE741;" Width="34" Height="34"
                                            Margin="0,0,10,0" Click="TogglePassword_Click" />
                                </Grid>
                                <TextBlock Text="{Binding DisplayName, StringFormat='Nombre de usuario (opcional)'}"
                                           Style="{StaticResource Caption}" />
                                <TextBox x:Name="NameBox" Style="{StaticResource LoginField}"
                                         Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="CONFIRMAR CONTRASEÑA" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                                <PasswordBox x:Name="ConfirmBox" Style="{StaticResource PasswordField}"
                                             PasswordChanged="ConfirmBox_PasswordChanged" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource LoginForm}" Margin="0,0,0,0">
                            <StackPanel>
                                <TextBlock Text="ACCESO CON GOOGLE" Style="{StaticResource Caption}" />
                                <Button Content="{Binding GoogleActionLabel}" Style="{StaticResource PrimaryButtonLogin}"
                                        Click="ContinueWithGoogle_Click" />
                                <TextBlock Text="{Binding GoogleStatusMessage}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                                <Button Content="Verifica en Firebase Console" Style="{StaticResource SecondaryButton}"
                                        Click="OpenFirebaseConsole_Click" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0" HorizontalAlignment="Left">
                            <Button x:Name="Primary" Style="{StaticResource PrimaryButtonLogin}"
                                    Content="{Binding PrimaryActionLabel}" Click="Primary_Click" />
                            <Button x:Name="Secondary" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"
                                    Content="{Binding SecondaryActionLabel}" Click="Secondary_Click" />
                        </StackPanel>
                        <Border Style="{StaticResource Pill}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" Margin="0,2,6,0" />
                                <TextBlock Text="{Binding ServerStatusLabel}" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Pill}" Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="DPAPI · Mojang API · Firebase" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid x:Name="ParticleLayer" IsHitTestVisible="False" ClipToBounds="True">
            <Grid x:Name="BackgroundGrid">
                <Border Background="{DynamicResource GridPatternBrush}" Opacity="0.35" />
                <Border Background="{DynamicResource VignetteBrush}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
