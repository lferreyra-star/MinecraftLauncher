<Window x:Class="XdLauncher.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="XD Launcher · Acceso"
        Width="900" Height="600" MinWidth="480" MinHeight="560"
        WindowStyle="None" ResizeMode="CanResize"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <LinearGradientBrush x:Key="LoginBrandBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF2A1247" Offset="0" />
            <GradientStop Color="#FF170A2E" Offset="0.55" />
            <GradientStop Color="#FF120724" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="LoginPrimaryBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FF5B21B6" Offset="0" />
            <GradientStop Color="#FFBE185D" Offset="1" />
        </LinearGradientBrush>
        <Thickness x:Key="LoginCardPadding">32</Thickness>
        <Thickness x:Key="LoginFieldPadding">14,0,12,0</Thickness>
        <Thickness x:Key="LoginFieldMargin">0,8,0,0</Thickness>

        <Style x:Key="LoginFieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Kicker}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,16,0,0" />
        </Style>
        <Style x:Key="LoginInlineError" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Visibility" Value="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource StringToVisibility}}" />
        </Style>

        <Style x:Key="LoginInputBase" TargetType="TextBox">
            <Setter Property="Height" Value="46" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Chrome" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="{StaticResource RadiusControl}" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Icon" FontFamily="{StaticResource IconFont}" FontSize="15"
                                           Foreground="{DynamicResource TextMutedBrush}" Text="{TemplateBinding Tag}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <ScrollViewer Grid.Column="1" x:Name="PART_ContentHost" VerticalContentAlignment="Center"
                                              Margin="0,0,12,0" />
                                <TextBlock x:Name="Placeholder" Grid.Column="1" IsHitTestVisible="False" Margin="0,0,12,0"
                                           VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"
                                           Visibility="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource StringToVisibility}, ConverterParameter=invert}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource InputFocusBrush}" />
                                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginEmailInput" TargetType="TextBox" BasedOn="{StaticResource LoginInputBase}">
            <Setter Property="Tag" Value="&#xE714;" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Chrome" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="{StaticResource RadiusControl}" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource TextMutedBrush}"
                                      Data="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <ScrollViewer Grid.Column="1" x:Name="PART_ContentHost" VerticalContentAlignment="Center" Margin="0,0,12,0" />
                                <TextBlock Grid.Column="1" Text="correo@ejemplo.com" IsHitTestVisible="False" Margin="0,0,12,0"
                                           VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"
                                           Visibility="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource StringToVisibility}, ConverterParameter=invert}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource InputFocusBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginNameInput" TargetType="TextBox" BasedOn="{StaticResource LoginInputBase}">
            <Setter Property="Tag" Value="&#xE13D;" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Chrome" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="{StaticResource RadiusControl}" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource TextMutedBrush}"
                                      Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <ScrollViewer Grid.Column="1" x:Name="PART_ContentHost" VerticalContentAlignment="Center" Margin="0,0,12,0" />
                                <TextBlock Grid.Column="1" Text="Tu nombre visible" IsHitTestVisible="False" Margin="0,0,12,0"
                                           VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"
                                           Visibility="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource StringToVisibility}, ConverterParameter=invert}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource InputFocusBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginRevealedPasswordInput" TargetType="TextBox" BasedOn="{StaticResource LoginInputBase}">
            <Setter Property="Tag" Value="&#xE890;" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Chrome" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="{StaticResource RadiusControl}" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <Path Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource TextMutedBrush}"
                                      Data="M12 5C7 5 2.73 8.11 1 12c1.73 3.89 6 7 11 7s9.27-3.11 11-7c-1.73-3.89-6-7-11-7zm0 11c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8a3 3 0 100 6 3 3 0 000-6z"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <ScrollViewer Grid.Column="1" x:Name="PART_ContentHost" VerticalContentAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Contraseña" IsHitTestVisible="False"
                                           VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"
                                           Visibility="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource StringToVisibility}, ConverterParameter=invert}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource InputFocusBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginPasswordInput" TargetType="PasswordBox">
            <Setter Property="Height" Value="46" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Chrome" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="{StaticResource RadiusControl}" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <Path Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource TextMutedBrush}"
                                      Data="M12 17c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm6-9h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zM8.9 6c0-1.71 1.39-3.1 3.1-3.1s3.1 1.39 3.1 3.1v2H8.9V6z"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <ScrollViewer Grid.Column="1" x:Name="PART_ContentHost" VerticalContentAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Contraseña" IsHitTestVisible="False"
                                           VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"
                                           Visibility="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource StringToVisibility}, ConverterParameter=invert}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource InputFocusBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Height" Value="46" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{StaticResource LoginPrimaryBrush}" BorderThickness="0"
                                CornerRadius="{StaticResource RadiusControl}" SnapsToDevicePixels="True">
                            <Grid>
                                <ContentPresenter x:Name="Label" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.Foreground="White" />
                                <Border x:Name="Spinner" Width="20" Height="20" Visibility="Collapsed"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse Width="18" Height="18" Stroke="White" StrokeThickness="2"
                                             StrokeDashArray="12 6" RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform x:Name="SpinnerRotate" />
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.55" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Spinner" Property="Visibility" Value="Visible" />
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="Spin">
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="SpinnerRotate" Storyboard.TargetProperty="Angle"
                                                             From="0" To="360" Duration="0:0:0.8" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="Spin" />
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="8" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="RootLayout" SizeChanged="RootLayout_SizeChanged">
        <Grid x:Name="ShellGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="BrandColumn" Width="*" />
                <ColumnDefinition x:Name="FormColumn" Width="1.2*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="BrandPanel" Background="{StaticResource LoginBrandBrush}" ClipToBounds="True">
                <Grid Margin="32">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Width="72" Height="72" CornerRadius="20" HorizontalAlignment="Left"
                            Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                        <Image Source="/Assets/logo.png" Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <TextBlock Text="XD LAUNCHER" FontFamily="{StaticResource DisplayFont}" FontSize="34"
                                   FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="Tu mundo, a un clic." FontSize="15" Foreground="#D8D2E8"
                                   TextWrapping="Wrap" Margin="0,12,0,0" MaxWidth="280" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="v1.3.8" Style="{StaticResource Caption}" Foreground="#B9A9CC" />
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource WindowBackgroundBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="FormContent" MaxWidth="460" HorizontalAlignment="Center"
                                Margin="24,32,24,32" KeyDown="FormContent_KeyDown">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <RadioButton GroupName="AuthMode" Content="Iniciar sesión" Style="{StaticResource SegmentRadio}"
                                         IsChecked="{Binding IsRegisterMode, Converter={StaticResource InverseBool}}"
                                         AutomationProperties.Name="Iniciar sesión" />
                            <RadioButton GroupName="AuthMode" Content="Crear cuenta" Style="{StaticResource SegmentRadio}"
                                         IsChecked="{Binding IsRegisterMode}"
                                         AutomationProperties.Name="Crear cuenta" Margin="8,0,0,0" />
                        </StackPanel>

                        <TextBlock Text="{Binding ModeTitle}" Style="{StaticResource PageTitle}" FontSize="28"
                                   TextTrimming="CharacterEllipsis" Margin="0,24,0,0" />
                        <TextBlock Text="{Binding ModeSubtitle}" Style="{StaticResource BodyText}" Margin="0,8,0,0"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />

                        <StackPanel Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" Margin="0,16,0,0">
                            <Border Background="{DynamicResource ErrorSoftBrush}" BorderBrush="{DynamicResource ErrorBrush}"
                                    BorderThickness="1" CornerRadius="{StaticResource RadiusControl}" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                               Foreground="{DynamicResource ErrorBrush}" />
                                    <TextBlock Text="{Binding ErrorMessage}" Grid.Column="1" Margin="10,0,0,0"
                                               Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel Visibility="{Binding HasInfo, Converter={StaticResource BoolToVisibility}}" Margin="0,16,0,0">
                            <TextBlock Text="{Binding InfoMessage}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBlock Text="CORREO" Style="{StaticResource LoginFieldLabel}" />
                        <TextBox x:Name="EmailBox" Style="{StaticResource LoginEmailInput}" Margin="{StaticResource LoginFieldMargin}"
                                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Correo electrónico" TabIndex="1" />
                        <TextBlock Text="{Binding EmailError}" Style="{StaticResource LoginInlineError}" />

                        <TextBlock Text="CONTRASEÑA" Style="{StaticResource LoginFieldLabel}" />
                        <Grid Margin="{StaticResource LoginFieldMargin}">
                            <PasswordBox x:Name="SecretBox" Style="{StaticResource LoginPasswordInput}"
                                         PasswordChanged="SecretBox_PasswordChanged"
                                         AutomationProperties.Name="Contraseña" TabIndex="2" />
                            <TextBox x:Name="VisibleSecretBox" Style="{StaticResource LoginRevealedPasswordInput}"
                                     Visibility="Collapsed" TextChanged="VisibleSecretBox_TextChanged"
                                     AutomationProperties.Name="Contraseña visible" TabIndex="2" />
                            <Button x:Name="TogglePassword" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Style="{StaticResource IconButton}" Width="34" Height="34" Margin="0,0,2,0"
                                    Click="TogglePassword_Click" AutomationProperties.Name="Mostrar u ocultar contraseña"
                                    ToolTip="Mostrar u ocultar contraseña">
                                <Grid Width="16" Height="16">
                                    <Path Stretch="Uniform" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.3"
                                          Fill="Transparent" Data="M1 8C3 4.5 5.5 3 8 3s5 1.5 7 5c-2 3.5-4.5 5-7 5S3 11.5 1 8z" />
                                    <Ellipse Width="4" Height="4" Fill="{DynamicResource TextMutedBrush}" />
                                    <Line X1="2" Y1="14" X2="14" Y2="2" Stroke="{DynamicResource TextMutedBrush}"
                                          StrokeThickness="1.4" Visibility="{Binding ShowPassword, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                </Grid>
                            </Button>
                        </Grid>
                        <TextBlock Text="{Binding PasswordError}" Style="{StaticResource LoginInlineError}" />

                        <Grid Margin="0,12,0,0">
                            <CheckBox Content="Recordarme" IsChecked="{Binding RememberMe}"
                                      AutomationProperties.Name="Recordarme" VerticalAlignment="Center"
                                      Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Button Content="¿Olvidaste tu contraseña?" HorizontalAlignment="Right"
                                    Style="{StaticResource TextButton}" Command="{Binding RecoverCommand}"
                                    AutomationProperties.Name="Recuperar contraseña" FontSize="12" />
                        </Grid>

                        <StackPanel Visibility="{Binding ShowRegisterFields, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="NOMBRE VISIBLE" Style="{StaticResource LoginFieldLabel}" />
                            <TextBox x:Name="NameBox" Style="{StaticResource LoginNameInput}" Margin="{StaticResource LoginFieldMargin}"
                                     Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Nombre visible" TabIndex="3" />
                            <TextBlock Text="CONFIRMAR CONTRASEÑA" Style="{StaticResource LoginFieldLabel}" />
                            <PasswordBox x:Name="ConfirmBox" Style="{StaticResource LoginPasswordInput}"
                                         Margin="{StaticResource LoginFieldMargin}" PasswordChanged="ConfirmBox_PasswordChanged"
                                         AutomationProperties.Name="Confirmar contraseña" TabIndex="4" />
                            <TextBlock Text="{Binding ConfirmError}" Style="{StaticResource LoginInlineError}" />
                        </StackPanel>

                        <Button x:Name="Primary" Style="{StaticResource LoginPrimaryButton}" Margin="0,24,0,0"
                                Content="{Binding PrimaryActionLabel}" Click="Primary_Click"
                                Tag="{Binding IsBusy}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                AutomationProperties.Name="{Binding PrimaryActionLabel}" TabIndex="5" />

                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Height="1" Background="{DynamicResource BorderSoftBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="o" Style="{StaticResource Caption}" Margin="12,0" />
                            <Border Grid.Column="2" Height="1" Background="{DynamicResource BorderSoftBrush}" VerticalAlignment="Center" />
                        </Grid>

                        <Button Style="{StaticResource SecondaryButton}" Margin="0,16,0,0"
                                Command="{Binding ContinueWithGoogleCommand}" AutomationProperties.Name="Continuar con Google" TabIndex="6">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource TextPrimaryBrush}"
                                      Data="M21.35 11.1H12v2.98h5.35c-.23 1.48-1.76 4.34-5.35 4.34-3.22 0-5.85-2.66-5.85-5.94s2.63-5.94 5.85-5.94c1.83 0 3.06.78 3.76 1.46l2.56-2.47C16.9 3.98 14.8 3 12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9c5.2 0 8.65-3.66 8.65-8.82 0-.59-.06-1.18-.3-1.98z" />
                                <TextBlock Text="{Binding GoogleActionLabel}" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding GoogleStatusMessage}" Style="{StaticResource Caption}"
                                   TextWrapping="Wrap" Margin="0,6,0,0" />

                        <Border HorizontalAlignment="Left" Margin="0,24,0,0" Padding="10,6"
                                Background="{DynamicResource ChipBrush}" BorderBrush="{DynamicResource BorderSoftBrush}"
                                BorderThickness="1" CornerRadius="{StaticResource RadiusPill}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" Margin="0,1,8,0" />
                                <TextBlock Text="{Binding ServerStatusLabel}" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Canvas x:Name="ParticleLayer" IsHitTestVisible="False" ClipToBounds="True" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,8,8,0" Panel.ZIndex="10">
            <Button Style="{StaticResource ChromeButton}" Content="&#xE949;" Click="Minimize_Click"
                    AutomationProperties.Name="Minimizar" />
            <Button Style="{StaticResource ChromeCloseButton}" Content="&#xE8BB;" Click="Close_Click"
                    AutomationProperties.Name="Cerrar" />
        </StackPanel>
    </Grid>
</Window>
